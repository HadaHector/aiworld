// A big double door in a heavy timber frame, two bays wide - a barn's or a workshop's, its two
// boarded leaves, ledged across, split by a stile.
{
  name: "Barn Door",
  type: "framed",
  framed: {
    span: 2,
    width: 3.4,
    height: 3.4,
    sill: 0,
    frame: 0.32,
    headReach: 0.12,
    // A stile up the middle, between its two leaves - the leaves' own ledges brace them.
    bars: [1, 0],
    parts: { frame: "timber", panel: "door" },
  },
}
