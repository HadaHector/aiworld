// A barn's roof: wooden shingles pitched steep over wide gables, reaching well past the walls to
// keep the weather off the boards - and sagging hard, as a barn's roof does.
{
  name: "Barn Roof",
  type: "pitched",
  pitched: {
    shapes: ["gable"],
    pitch: [46, 54],
    overhang: 0.7,
    thickness: 0.3,
    covering: { thickness: 0.07, overhang: 0.08 },
    bargeboard: { height: 0.16, thickness: 0.07 },
    sag: { ridge: [0.2, 0.5], slope: [0.06, 0.16] },
    step: 1.5,
    ridgeTiles: { width: 0.36, height: 0.1, profile: "peaked" },
    parts: { covering: "roof", underside: "timber", ridge: "timber", gable: "walls" },
  },
}
