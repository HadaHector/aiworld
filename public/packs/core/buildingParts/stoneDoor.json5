// A door in a dressed stone surround: boards between broad stone jambs, under a lintel reaching well
// past them.
{
  name: "Stone Door",
  type: "framed",
  framed: {
    span: 1,
    width: 1.4,
    height: 2.9,
    sill: 0,
    frame: 0.35,
    headReach: 0.15,
    // Up to two stone steps from the ground to its threshold, as the plinth's height wants.
    steps: { count: 2, tread: 0.4, reach: 0.15, part: "stone" },
    parts: { frame: "stone", panel: "door" },
  },
}
