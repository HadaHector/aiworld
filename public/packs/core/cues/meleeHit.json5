// A melee blow landing: the sound of this weapon on this armour, a puff or sparks, a white flash and
// a flinch on the struck unit - bigger for a bigger hit - and, in the player's own fights, a shake
// that grows with the hit and a harder knock on a crit.
{
  parts: [
    { sound: "hit.{weapon}.{armor}" },
    { particles: "hit.{armor}" },
    { flash: [1, 1, 1], time: 0.1 },
    { flinch: 0.6, scale: "amount" },
    { shake: 0.2, scale: "amount" },
    { shake: 0.25, when: { crit: true } },
    { pause: 0.04, when: { crit: true } },
  ],
}
