// Plate - breastplates, helms, greaves: bright steel hammered into shallow dents and brushed along
// one way, a little duller here and there. Near white-grey, so a tint can blacken or gild it.
{
  name: "Plate",
  size: 0.5,
  shine: 0.55,
  texture: {
    bumpStrength: 1.0,
    pipeline: {
      noises: [
        { name: "dents", type: "worley", tileCycles: 10, amplitude: 1, mode: "f1", sizeJitter: 0.3 },
        { name: "brush", type: "fbm", octaves: 2, tileCycles: 60, amplitude: 1, persistence: 0.5, lacunarity: 2, stretch: [1, 20] },
        { name: "dull", type: "fbm", octaves: 3, tileCycles: 2, amplitude: 1, persistence: 0.5, lacunarity: 2 },
      ],
      steps: [
        { output: "dentRaw", op: "sample", noise: "dents" },
        { output: "dent", op: "mask", input: "dentRaw", at: 0.0, off: 0.5 },
        { output: "dentShade", op: "remap", input: "dent", inMin: 0, inMax: 1, outMin: 1.03, outMax: 0.95 },
        { output: "brushRaw", op: "sample", noise: "brush" },
        { output: "brushShade", op: "remap", input: "brushRaw", inMin: -1, inMax: 1, outMin: 0.97, outMax: 1.03 },
        { output: "dullRaw", op: "sample", noise: "dull" },
        { output: "dullShade", op: "remap", input: "dullRaw", inMin: -1, inMax: 1, outMin: 0.9, outMax: 1.02 },
        { output: "steel", op: "color", value: [0.72, 0.74, 0.77] },
        { output: "hammered", op: "multiply", a: "steel", b: "dentShade" },
        { output: "brushed", op: "multiply", a: "hammered", b: "brushShade" },
        { output: "diffuse", op: "multiply", a: "brushed", b: "dullShade" },
        { output: "roughness", op: "remap", input: "dullRaw", inMin: -1, inMax: 1, outMin: 0.55, outMax: 0.3 },
        { output: "height", op: "scale", input: "dent", factor: -0.5 },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
}
