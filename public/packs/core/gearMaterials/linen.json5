// Linen - shirts, smallclothes, a robe's lining: a plain weave of thick threads, slubby and a little
// uneven, near white so a piece's tint is its colour. Threads twice life size, so the weave reads on
// a body seen from the third-person camera.
{
  name: "Linen",
  size: 0.24,
  texture: {
    bumpStrength: 1.2,
    pipeline: {
      noises: [
        // 24 threads each way to a tile: about a centimetre a thread on the body.
        { name: "warp", type: "wave", tileCycles: [24, 0], amplitude: 1, shape: "sine" },
        { name: "weft", type: "wave", tileCycles: [0, 24], amplitude: 1, shape: "sine" },
        { name: "overX", type: "wave", tileCycles: [12, 0], amplitude: 1, shape: "triangle" },
        { name: "overY", type: "wave", tileCycles: [0, 12], amplitude: 1, shape: "triangle" },
        { name: "slubs", type: "fbm", octaves: 2, tileCycles: 8, amplitude: 1, persistence: 0.5, lacunarity: 2, stretch: [1, 5] },
        { name: "mottle", type: "fbm", octaves: 3, tileCycles: 2, amplitude: 1, persistence: 0.5, lacunarity: 2 },
      ],
      steps: [
        { output: "warpRaw", op: "sample", noise: "warp" },
        { output: "weftRaw", op: "sample", noise: "weft" },
        { output: "warpRidge", op: "abs", input: "warpRaw" },
        { output: "weftRidge", op: "abs", input: "weftRaw" },
        { output: "ox", op: "sample", noise: "overX" },
        { output: "oy", op: "sample", noise: "overY" },
        { output: "checker", op: "multiply", a: "ox", b: "oy" },
        { output: "warpOver", op: "mask", input: "checker", at: 0.1, off: -0.1 },
        { output: "threads", op: "mix", a: "weftRidge", b: "warpRidge", t: "warpOver" },
        { output: "slubRaw", op: "sample", noise: "slubs" },
        { output: "slub", op: "mask", input: "slubRaw", at: 0.85, off: 0.3 },
        { output: "mottleRaw", op: "sample", noise: "mottle" },
        { output: "shadeThreads", op: "remap", input: "threads", inMin: 0, inMax: 1, outMin: 0.88, outMax: 1 },
        { output: "shadeMottle", op: "remap", input: "mottleRaw", inMin: -1, inMax: 1, outMin: 0.92, outMax: 1.03 },
        { output: "shade", op: "multiply", a: "shadeThreads", b: "shadeMottle" },
        { output: "base", op: "color", value: [0.9, 0.88, 0.83] },
        { output: "woven", op: "multiply", a: "base", b: "shade" },
        { output: "slubColor", op: "color", value: [0.96, 0.94, 0.9] },
        { output: "diffuse", op: "mix", a: "woven", b: "slubColor", t: "slub" },
        { output: "roughness", op: "constant", value: 0.95 },
        { output: "height", op: "scale", input: "threads", factor: 0.6 },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
}
