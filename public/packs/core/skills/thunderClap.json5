// Strikes every enemy within 8 m of the caster and slows them.
{
  name: "Thunder Clap",
  icon: "spell-earth-quake",
  cues: { release: "thunderClap" },
  type: "physical",
  tags: ["melee"],
  target: "none",
  cost: { rage: 20 },
  cooldown: 6,
  areas: { around: { shape: "circle", radius: 8 } },
  groups: { hit: { from: "area:around", filter: { relation: "enemy" }, max: 10 } },
  states: {
    clap: {
      enter: [
        { do: "animation", name: "castSlam" },
        { do: "damage", group: "hit", amount: { mul: [{ add: [10, { div: ["caster.strength", 4] }] }, { add: [1, { mul: [0.35, { sub: ["level", 1] }] }] }] } },
        { do: "cast", skill: "thunderClapSlow", group: "hit" },
      ],
    },
  },
}
