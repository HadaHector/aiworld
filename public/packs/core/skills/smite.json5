// A priest's bolt of light: a short cast, holy damage.
{
  name: "Smite",
  type: "spell",
  tags: ["school.holy"],
  target: "enemy",
  range: 30,
  los: true,
  facing: true,
  cost: { mana: 20 },
  start: "cast",
  states: {
    cast: { length: 1.5, bar: "cast", breakOnMove: true, interruptible: true, next: "hit" },
    hit: { commit: true, enter: [{ do: "damage", group: "target", amount: { add: [18, { mul: ["random", 8] }, { mul: ["caster.intellect", 0.7] }] } }] },
  },
}
