// The ranger's long buff (SKILLBANK.md, level 2): its own agility +10% (+3% a rank) for 30 minutes.
{
  name: "Hawk Eye",
  icon: "spell-nature-light-beam",
  type: "spell",
  tags: ["school.nature"],
  target: "self",
  cost: { mana: 20 },
  display: "buff",
  dispel: "magic",
  stacking: { per: "host", add: "replace", value: "stronger" },
