// A quest item's use (QUESTS.md): working a salve into a weakened beast. It must be the target,
// within reach; the quest counts it when the cast is done.
{
  name: "Apply Salve",
  type: "physical",
  target: "enemy",
  range: 8,
  start: "cast",
  states: {
    cast: { length: 1.5, bar: "cast", breakOnMove: true, interruptible: true, next: "done" },
    done: { commit: true, enter: [{ do: "damage", group: "target", amount: 1 }] },
  },
}
