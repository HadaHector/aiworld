// An instant weapon strike that also sunders the target's armour.
{
  name: "Heroic Strike",
  cues: { impact: "heavyHit" },
  type: "physical",
  weapon: true,
  tags: ["melee"],
  target: "enemy",
  range: 5,
  facing: true,
  cost: { rage: 15 },
  cooldown: 3,
  states: {
    strike: {
      enter: [
        { do: "animation", name: "swing" },
        { do: "damage", group: "target", amount: { add: ["caster.weaponMax", 12, { div: ["caster.strength", 5] }] }, threat: 1.5 },
        { do: "cast", skill: "sunder", group: "target" },
      ],
    },
  },
}
