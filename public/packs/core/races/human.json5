// The human body: the middle of the three races, stylised as WoW's are - broad shoulders, big hands
// and feet, a head a little large - so it reads from the third-person camera (see CHARACTERS.md).
// Lengths in metres. Each bone's shape is four profile curves along it, [along, distance from the
// bone]: 0 at the bone's start (its upper end, for a limb), 1 at its end.
{
  name: "Human",
  // A character picks its skin, hair and eyes from these by its seed.
  look: {
    skin: ["#e8b896", "#dba57f", "#c98d66", "#a8704c", "#7d5036"],
    hair: ["#2a1d14", "#4a3020", "#6e4a2a", "#a87a44", "#d4b070", "#8a3a1e", "#3a3a3a"],
    eyes: ["#4a6a8a", "#5a7a4a", "#5a4030", "#3a2a20", "#6a7a80"],
    beard: 0.45,
    // Where the face is painted: heights up the head, from the jaw's hinge (0) to the crown (1) -
    // matched to the head's front curve below (the nose's tip at 0.4, the eyes at 0.5, the brow at 0.6).
    face: { eyes: 0.5, brows: 0.585, nose: 0.385, mouth: 0.26, hairline: 0.76 },
    // Painted hair styles (FRONTEND.md, *Looks*): how the plain cut's hairline, nape and sides move.
    hairStyles: [
      { id: "short", name: "Short" },
      { id: "long", name: "Long", hairline: -0.02, nape: -0.1 },
      { id: "receding", name: "Receding", hairline: 0.1, temples: 0.3 },
      { id: "shavedSides", name: "Shaved sides", shaved: 1 },
      { id: "cropped", name: "Cropped", thickness: 0.45, hairline: 0.02 },
    ],
  },
  skeleton: {
    ankle: 0.09,
    shin: 0.4,
    thigh: 0.41,
    hipWidth: 0.11,
    pelvis: 0.13,
    spine: 0.19,
    chest: 0.28,
    neck: 0.05,
    head: 0.255,
    shoulderWidth: 0.25,
    shoulderDrop: 0.08,
    upperArm: 0.29,
    forearm: 0.27,
    hand: 0.16,
    armDown: 77,
    foot: 0.31,
    heel: 0.075,
    armpit: 0.16,
    crotch: 0.085,
  },
  shape: {
    // The torso: the hip joints up to the waist, the ribs, then the chest to the top of the shoulders.
    // Round rings, narrowing to the waist and widening to the ribs; the buttocks and shoulder blades
    // as bumps (round from the front toward the side, in degrees). The sexes below add the rest.
    pelvis: {
      front: [[0, 0.13], [1, 0.12]],
      back: [[0, 0.15], [1, 0.125]],
      side: [[0, 0.2], [1, 0.17]],
      round: 0.78,
      loops: 1,
      verts: 16,
      bumps: [{ at: 0.1, angle: 150, width: 35, length: 0.6, height: 0.025 }],
    },
    spine: { front: [[0, 0.12], [0.6, 0.13], [1, 0.15]], back: [[0, 0.125], [1, 0.14]], side: [[0, 0.168], [0.5, 0.172], [1, 0.19]], round: 0.8, loops: 1, verts: 16 },
    chest: {
      front: [[0, 0.15], [0.5, 0.16], [0.85, 0.135], [1, 0.08]],
      back: [[0, 0.14], [0.5, 0.15], [1, 0.09]],
      side: [[0, 0.19], [0.45, 0.205], [1, 0.22]],
      round: 0.75,
      loops: 4,
      verts: 16,
      bumps: [{ at: 0.6, angle: 145, width: 30, length: 0.3, height: 0.015 }],
    },
    neck: { front: [[0, 0.058], [1, 0.05]], back: [[0, 0.066], [1, 0.052]], side: [[0, 0.07], [1, 0.056]], round: 0.9, loops: 0, verts: 8 },
    // The face in the front curve's profile: chin, mouth, the nose's tip, the eyes set back under the
    // brow, the forehead. Eyes halfway up from the chin, as a real head has them.
    head: {
      front: [[0, 0.045], [0.12, 0.09], [0.26, 0.096], [0.4, 0.118], [0.5, 0.1], [0.6, 0.108], [0.8, 0.094], [1, 0.03]],
      back: [[0, 0.055], [0.3, 0.085], [0.6, 0.104], [0.85, 0.085], [1, 0.03]],
      side: [[0, 0.056], [0.3, 0.084], [0.6, 0.096], [0.85, 0.083], [1, 0.03]],
      round: 0.75,
      loops: 6,
      verts: 10,
    },
    thigh: { front: [[0, 0.11], [0.3, 0.115], [1, 0.075]], back: [[0, 0.12], [0.2, 0.12], [1, 0.075]], out: [[0, 0.12], [0.4, 0.105], [1, 0.075]], in: [[0, 0.095], [1, 0.07]], round: 0.7, loops: 2, verts: 8 },
    // The calf at the back.
    shin: { front: [[0, 0.07], [1, 0.055]], back: [[0, 0.075], [0.3, 0.095], [1, 0.055]], out: [[0, 0.07], [0.3, 0.078], [1, 0.055]], in: [[0, 0.07], [0.3, 0.078], [1, 0.055]], round: 0.7, loops: 2, verts: 8 },
    // Heel to toe: its top, and its sole down to the ground.
    foot: { top: [[0, 0.035], [0.3, 0.06], [0.7, 0.045], [1, 0.025]], sole: [[0, 0.05], [1, 0.032]], out: [[0, 0.05], [0.6, 0.065], [1, 0.055]], in: [[0, 0.05], [0.6, 0.06], [1, 0.05]], round: 0.5, loops: 2, verts: 8 },
    upperArm: { front: [[0, 0.075], [1, 0.058]], back: [[0, 0.075], [0.4, 0.082], [1, 0.058]], out: [[0, 0.085], [0.3, 0.082], [1, 0.058]], in: [[0, 0.07], [1, 0.056]], round: 0.75, loops: 1, verts: 8 },
    // Forearms as thick as the upper arm's elbow end and more, as WoW draws them.
    forearm: { front: [[0, 0.062], [0.3, 0.068], [1, 0.045]], back: [[0, 0.065], [0.3, 0.072], [1, 0.045]], out: [[0, 0.06], [1, 0.04]], in: [[0, 0.06], [1, 0.04]], round: 0.75, loops: 1, verts: 8 },
    // Flat: wide across (front, the thumb's side, and back), thin from its back (out) to the palm (in).
    hand: { front: [[0, 0.05], [0.5, 0.062], [1, 0.05]], back: [[0, 0.05], [0.5, 0.062], [1, 0.045]], out: [[0, 0.032], [0.5, 0.032], [1, 0.02]], in: [[0, 0.032], [0.5, 0.032], [1, 0.02]], round: 0.5, loops: 1, verts: 6 },
  },
  // How far one character may stray from these: a factor on its lengths and on its girth.
  sliders: { height: [0.94, 1.06], build: [0.88, 1.14] },
  // How the sexes differ: factors on the skeleton's lengths and on bones' curves, and bumps added.
  sexes: {
    male: {
      shape: {
        chest: { bumps: [{ at: 0.55, angle: 32, width: 28, length: 0.22, height: 0.022, mark: "nipple" }] },
      },
    },
    female: {
      beard: 0,
      skeleton: { shoulderWidth: 0.88, hipWidth: 1.06, spine: 0.98, chest: 0.96, neck: 1.05, head: 0.97, upperArm: 0.95, forearm: 0.95, hand: 0.9, thigh: 0.98, shin: 0.97, foot: 0.9 },
      shape: {
        pelvis: { scale: { side: 1.04, back: 1.06 }, bumps: [{ at: 0.1, angle: 150, width: 35, length: 0.6, height: 0.015 }] },
        spine: { scale: { side: 0.86, front: 0.92, back: 0.92 } },
        chest: { scale: { side: 0.88, front: 0.92, back: 0.92 }, bumps: [{ at: 0.33, angle: 30, width: 28, length: 0.22, height: 0.07, mark: "nipple" }] },
        neck: { scale: { front: 0.82, back: 0.82, side: 0.82 } },
        head: { scale: { front: 0.96, back: 0.96, side: 0.96 } },
        upperArm: { scale: { front: 0.82, back: 0.82, out: 0.82, in: 0.82 } },
        forearm: { scale: { front: 0.82, back: 0.82, out: 0.82, in: 0.82 } },
        hand: { scale: { front: 0.88, back: 0.88, out: 0.88, in: 0.88 } },
        thigh: { scale: { front: 0.97, back: 0.97, out: 0.97, in: 0.97 } },
        shin: { scale: { front: 0.88, back: 0.88, out: 0.88, in: 0.88 } },
        foot: { scale: { top: 0.9, sole: 1, out: 0.9, in: 0.9 } },
      },
    },
  },
  // A last pass over the whole body: a deeper chest. Points counted from -x, the bottom, the back.
  lattice: {
    divisions: [3, 4, 3],
    moves: [{ at: [1, 2, 2], by: [0, 0, 0.025] }],
  },
}
