// A web spread over the ground under a unit stuck in silk (about 2.3 m across for a person: the cue
// scales it by the body). One web, laid again before the last fades so it never blinks. Loops.
{
  loop: true,
  emitters: [
    // A soft pale pool under the threads, so the web reads from far off and over any ground.
    { sprite: "softDot", flat: true, blend: "alpha", rate: 1.3, life: 1.8, local: true, size: 2.7, colour: [[0, "#f4f6ee00"], [0.2, "#f4f6ee48"], [0.8, "#f4f6ee48"], [1, "#f4f6ee00"]] },
    { sprite: "web", flat: true, blend: "alpha", rate: 1.3, life: 1.8, local: true, size: 2.4, colour: [[0, "#fafaf600"], [0.15, "#fafaf6f0"], [0.85, "#fafaf6f0"], [1, "#fafaf600"]] },
  ],
}
