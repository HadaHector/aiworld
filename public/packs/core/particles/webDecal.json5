// A web spread over the ground under a unit stuck in silk (about 2.4 m across for a person: the cue
// scales it by the body). One held web: it fades in, stays exactly as it is while the cue lasts and
// fades out when it stops. Drawn as a low cone draped over the ground, so slopes and grass do not hide it. Loops.
{
  loop: true,
  emitters: [
    // A soft pale pool under the threads, so the web reads from far off and over any ground.
    { sprite: "softDot", flat: true, hold: true, blend: "alpha", burst: 1, life: 1.2, local: true, size: 2.7, colour: [[0, "#f4f6ee00"], [0.2, "#f4f6ee48"], [0.5, "#f4f6ee48"], [1, "#f4f6ee00"]] },
    { sprite: "web", flat: true, hold: true, blend: "alpha", burst: 1, life: 1.2, local: true, size: 2.4, colour: [[0, "#fafaf600"], [0.2, "#fafaf6f0"], [0.5, "#fafaf6f0"], [1, "#fafaf600"]] },
  ],
}
