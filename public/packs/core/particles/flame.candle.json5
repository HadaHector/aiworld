// A candle's flame (PROP_EFFECTS.md): authored for a flame a metre tall, which a candle's is a quarter of -
// so a candle's `scale` makes it bolder. One steady tongue and a small halo. Loops.
{
  loop: true,
  emitters: [
    { sprite: "flame", upright: true, blend: "add", rate: 2.4, life: [0.5, 1.7], shape: "point", direction: [0, 1, 0], spread: 6, speed: [0.02, 0.06], size: [[0, 0.35], [0.5, 0.28], [1, 0.05]], colour: [[0, "#fff0c0"], [0.5, "#ffc860"], [1, "#f0a03000"]] },
    { sprite: "softDot", blend: "add", rate: 2, life: [0.8, 1.8], shape: "point", speed: [0, 0], size: [[0, 1.1], [1, 1.2]], colour: [[0, "#ffa04022"], [0.5, "#ffa04030"], [1, "#ffa04000"]] },
  ],
}
