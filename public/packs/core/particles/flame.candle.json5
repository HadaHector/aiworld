  loop: true,
  emitters: [
    { sprite: "flame", upright: true, blend: "add", rate: 7, life: [0.25, 0.45], shape: "point", direction: [0, 1, 0], spread: 6, speed: [0.1, 0.35], size: [[0, 0.7], [0.5, 0.55], [1, 0.1]], colour: [[0, "#fff4cc"], [0.35, "#ffb040"], [1, "#c0300000"]] },
    { sprite: "softDot", blend: "add", rate: 2, life: [0.8, 1.2], shape: "point", speed: [0, 0], size: [[0, 2.2], [1, 2.4]], colour: [[0, "#ffa04022"], [0.5, "#ffa04030"], [1, "#ffa04000"]] },
