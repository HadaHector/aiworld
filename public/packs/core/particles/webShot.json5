// A web in flight: a ball of silk with a strand paying out behind it to the spider's mouth. Loops.
{
  loop: true,
  emitters: [
    // The ball: a spinning wad of threads in a pale glow.
    { sprite: "softDot", blend: "alpha", rate: 40, life: 0.1, local: true, size: [[0, 0.8], [1, 0.7]], colour: [[0, "#f6f8f0b0"], [1, "#f6f8f000"]] },
    { sprite: "tangle", blend: "alpha", rate: 30, life: 0.12, local: true, spin: [-6, 6], size: 0.55, colour: [[0, "#ffffff"], [0.8, "#ffffffe0"], [1, "#ffffff00"]] },
    // The strand: a line of bright specks laid back along the way to the spider, standing a moment.
    { sprite: "hardDot", blend: "alpha", rate: 260, life: 0.14, shape: "line", size: 0.045, colour: [[0, "#ffffffe8"], [1, "#ffffff00"]] },
    // Bits of silk thrown off.
    { sprite: "spark", blend: "alpha", rate: 30, life: [0.2, 0.4], shape: { sphere: 0.1 }, speed: [0.3, 0.8], stretch: 0.3, size: [[0, 0.1], [1, 0.04]], colour: [[0, "#ffffffc0"], [1, "#ffffff00"]] },
  ],
}
