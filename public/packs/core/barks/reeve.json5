// What reeves say (NPCS.md, *Barks*): `when` near (a player coming by, the default), click (clicked
// with nothing to offer) or hit; `moods` to say it only in those. `{call:brother}` names the one
// it calls its brother, and only one who has one says it.
{
  lines: [
    "Welcome to {settlement}.",
    "We keep the peace here. See that you do too.",
    { text: "Too many troubles and too few hands.", moods: ["weary", "nervous"] },
    { text: "If you're looking for work, I may have some.", moods: ["cheerful", "gruff"] },
    { text: "{settlement} has always looked after its own.", when: "click" },
    { text: "Guards!", when: "hit" },
  ],
}
