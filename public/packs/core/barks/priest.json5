// What priests say (NPCS.md, *Barks*): `when` near (a player coming by, the default), click (clicked
// with nothing to offer) or hit; `moods` to say it only in those. `{call:brother}` names the one
// it calls its brother, and only one who has one says it.
{
  lines: [
    "Peace be on your road.",
    "The bell rings at dusk. All are welcome.",
    { text: "Light keep you.", moods: ["cheerful", "calm"] },
    { text: "Pray for the harvest, friend.", moods: ["weary"] },
    { text: "Speak, child.", when: "click" },
    { text: "Mercy!", when: "hit" },
  ],
}
