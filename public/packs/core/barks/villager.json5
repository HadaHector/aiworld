// What villagers say (NPCS.md, *Barks*): `when` near (a player coming by, the default), click (clicked
// with nothing to offer) or hit; `moods` to say it only in those. `{call:brother}` names the one
// it calls its brother, and only one who has one says it.
{
  lines: [
    "Mind the cart ruts, they'll turn an ankle.",
    "Good day to you.",
    { text: "Lovely morning for it.", moods: ["cheerful"] },
    { text: "Can't stop. Too much to do.", moods: ["weary", "nervous"] },
    { text: "Hm.", moods: ["gruff"] },
    { text: "Have you seen {call:brother}? He was meant to be back by now." },
    { text: "If you see {call:sister}, tell her supper's on." },
    { text: "{call:rival} thinks they know best. They don't." },
    { text: "Don't mention {call:enemy} to me." },
    { text: "{call:sweetheart} said they'd meet me by the well...", moods: ["cheerful", "nervous"] },
    { text: "Yes?", when: "click" },
    { text: "Off with you, I'm busy.", when: "click", moods: ["gruff"] },
    { text: "Help! Help!", when: "hit" },
  ],
}
