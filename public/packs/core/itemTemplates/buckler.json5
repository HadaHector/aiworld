// Bucklers from parts, strapped to the left forearm: wood, a metal disc with a boss, dished and spiked.
// A material (its tint) times how well it is made (its model, weapons/buckler.json5) times a rarity.
{
  kind: "armour",
  icon: "item-wooden-shield",
  slot: "offHand",
  name: "{make}{material} Buckler",
  axes: {
    material: [
      { id: "bronze", name: "Bronze", tint: "#c89a5a", level: 1, budget: 1 },
      { id: "iron", name: "Iron", tint: "#d6dae0", level: 8, budget: 1.5 },
    ],
    // How well it is made (CHARACTERS.md, *Weapons and shields*): which of the family's models it is.
    make: [
      { id: "crude", name: "Crude ", gear: ["buckler.crude"], budget: 0.85 },
      { id: "standard", name: "", gear: ["buckler.standard"] },
      { id: "ornate", name: "Ornate ", gear: ["buckler.ornate"], budget: 1.2, level: 5 },
    ],
  },
  // No crude rarity, no plain ornament.
  never: [{ make: "crude", rarity: "rare" }, { make: "ornate", rarity: "common" }],
  stats: { armor: [5, 7], agility: [0, 1] },
  rarities: ["common", "uncommon", "rare"],
  extra: { stamina: [1, 3], strength: [1, 2], agility: [1, 2], spirit: [1, 2], intellect: [1, 2] },
  requires: { ge: ["level", { sub: ["itemLevel", 8] }] },
  durability: 50,
  value: 25,
}
