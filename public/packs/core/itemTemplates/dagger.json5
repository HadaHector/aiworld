// Daggers.
// A ladder (rules/itemLayout.json5, ITEMS.md *The ladder*): six items over levels 1-10 and grey
// trash between; its stats, armour, damage and price come from the curves.
{
  kind: "weapon",
  slot: "mainHand",
  icon: "item-dagger-bronze",
  ladder: "dagger",
  name: "{tier} Dagger",
  tiers: { start: "Crude Bronze", loot3: "Bronze", shop: "Hardened", quest: "Fine Hardened", loot7: "Iron", loot9: "Ornate Iron", trash: "Battered" },
  rungs: {
    start: { gear: ["dagger.crude"], tint: "#c89a5a" },
    loot3: { gear: ["dagger.standard"], tint: "#c89a5a" },
    shop: { gear: ["dagger.standard"], tint: "#b98a4e" },
    quest: { gear: ["dagger.ornate"], tint: "#b98a4e" },
    loot7: { gear: ["dagger.standard"], tint: "#d6dae0" },
    loot9: { gear: ["dagger.ornate"], tint: "#d6dae0" },
    trash: { gear: ["dagger.crude"], tint: "#8a7a60" },
  },
}
