// Daggers from parts: a leaf blade, a guarded blade, a long jewelled one.
// A material (its tint) times how well it is made (its model, weapons/dagger.json5) times a rarity.
{
  kind: "weapon",
  icon: "item-dagger-{material}",
  slot: "mainHand",
  name: "{make}{material} Dagger",
  axes: {
    material: [
      { id: "bronze", name: "Bronze", tint: "#c89a5a", level: 1, budget: 1 },
      { id: "iron", name: "Iron", tint: "#d6dae0", level: 8, budget: 1.5 },
    ],
    // How well it is made (CHARACTERS.md, *Weapons and shields*): which of the family's models it is.
    make: [
      { id: "crude", name: "Crude ", gear: ["dagger.crude"], budget: 0.85 },
      { id: "standard", name: "", gear: ["dagger.standard"] },
      { id: "ornate", name: "Ornate ", gear: ["dagger.ornate"], budget: 1.2, level: 5 },
    ],
  },
  // No crude rarity, no plain ornament.
  never: [{ make: "crude", rarity: "rare" }, { make: "ornate", rarity: "common" }],
  stats: { weaponMin: [1, 2], weaponMax: [3, 4], weaponSpeed: -0.6, agility: [1, 2] },
  unscaled: ["weaponSpeed"],
  rarities: ["common", "uncommon", "rare"],
  extra: { stamina: [1, 3], strength: [1, 2], agility: [1, 2], spirit: [1, 2], intellect: [1, 2] },
  requires: { ge: ["level", { sub: ["itemLevel", 8] }] },
  durability: 40,
  value: "balance",   // from the curves (rules/balance.json5): the level, slot and rarity set it
}
