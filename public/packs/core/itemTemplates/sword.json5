// Swords from parts (see ITEMS.md, Generated item types): a metal times a form times how well it is
// made (its model, weapons/sword.json5) times a rarity, so 3 x 3 x 3 x 3 = 81, less the crude rare and
// plain ornate ones: 63 types. The metals' levels (1, 4, 8) leave a sword near every level a quest's reward can be at (QUESTS.md, *Item choices*). The rarer tiers draw extra stats from the pool below, which ones by the seed.
{
  kind: "weapon",
  icon: "item-sword-{material}-{form}",
  slot: "mainHand",
  name: "{make}{material} {form}",
  axes: {
    material: [
      { id: "bronze", name: "Bronze", tint: "#c89a5a", level: 1, budget: 1 },
      { id: "hardened", name: "Hardened", tint: "#b98a4e", level: 4, budget: 1.25 },
      // Iron needs some skill with swords (PROGRESSION.md: a discipline's level is a stat items require).
      { id: "iron", name: "Iron", tint: "#d6dae0", level: 8, budget: 1.5, requires: { and: [{ ge: ["level", { sub: ["itemLevel", 8] }] }, { ge: ["swordSkill", 10] }] } },
    ],
    form: [
      { id: "short", name: "Shortsword", stats: { weaponMin: [2, 3], weaponMax: [4, 5], weaponSpeed: -0.4, agility: [1, 2] } },
      { id: "long", name: "Longsword", stats: { weaponMin: [3, 4], weaponMax: [6, 8], strength: [1, 2] } },
      { id: "great", name: "Greatsword", fills: ["offHand"], stats: { weaponMin: [6, 8], weaponMax: [11, 14], weaponSpeed: 1.2, strength: [2, 3] }, durability: 60 },
    ],
    // How well it is made (CHARACTERS.md, *Weapons and shields*): which of the family's models it is.
    make: [
      { id: "crude", name: "Crude ", gear: ["sword.crude"], budget: 0.85 },
      { id: "standard", name: "", gear: ["sword.standard"] },
      { id: "ornate", name: "Ornate ", gear: ["sword.ornate"], budget: 1.2, level: 5 },
    ],
  },
  rarities: ["common", "uncommon", "rare"],
  // No crude rarity, no plain ornament.
  never: [{ make: "crude", rarity: "rare" }, { make: "ornate", rarity: "common" }],
  unscaled: ["weaponSpeed"],
  extra: { stamina: [1, 3], strength: [1, 2], agility: [1, 2], spirit: [1, 2], intellect: [1, 2] },
  durability: 45,
  value: 40,
  requires: { ge: ["level", { sub: ["itemLevel", 8] }] },
}
