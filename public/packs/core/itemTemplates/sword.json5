// Swords.
// A ladder (rules/itemLayout.json5, ITEMS.md *The ladder*): six items over levels 1-10 and grey
// trash between; its stats, armour, damage and price come from the curves.
{
  kind: "weapon",
  slot: "mainHand",
  icon: "item-sword-bronze-long",
  ladder: "sword",
  name: "{tier} Sword",
  tiers: { start: "Crude Bronze", loot3: "Bronze", shop: "Hardened", quest: "Fine Hardened", loot7: "Iron", loot9: "Ornate Iron", trash: "Battered" },
  rungs: {
    start: { gear: ["sword.crude"], tint: "#c89a5a" },
    loot3: { gear: ["sword.standard"], tint: "#c89a5a" },
    shop: { gear: ["sword.standard"], tint: "#b98a4e" },
    quest: { gear: ["sword.ornate"], tint: "#b98a4e" },
    loot7: { gear: ["sword.standard"], tint: "#d6dae0" },
    loot9: { gear: ["sword.ornate"], tint: "#d6dae0", requires: { and: [{ ge: ["level", { sub: ["itemLevel", 1] }] }, { ge: ["swordSkill", 10] }] } },
    trash: { gear: ["sword.crude"], tint: "#8a7a60" },
  },
}
