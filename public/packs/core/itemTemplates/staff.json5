// Staves from parts, in one hand (the other free for an orb or a book): a pole, a knotted head, a crook round a crystal.
// A material (its tint) times how well it is made (its model, weapons/staff.json5) times a rarity.
{
  kind: "weapon",
  icon: "item-ash-staff",
  slot: "mainHand",
  name: "{make}{material} Staff",
  axes: {
    material: [
      { id: "ash", name: "Ash", tint: "#8a6a40", level: 1, budget: 1 },
      { id: "oak", name: "Oak", tint: "#6b4a2a", level: 8, budget: 1.5 },
    ],
    // How well it is made (CHARACTERS.md, *Weapons and shields*): which of the family's models it is.
    make: [
      { id: "crude", name: "Crude ", gear: ["staff.crude"], budget: 0.85 },
      { id: "standard", name: "", gear: ["staff.standard"] },
      { id: "ornate", name: "Ornate ", gear: ["staff.ornate"], budget: 1.2, level: 5 },
    ],
  },
  // No crude rarity, no plain ornament.
  never: [{ make: "crude", rarity: "rare" }, { make: "ornate", rarity: "common" }],
  stats: { weaponMin: [2, 3], weaponMax: [5, 7], weaponSpeed: 0.8, intellect: [1, 2] },
  unscaled: ["weaponSpeed"],
  rarities: ["common", "uncommon", "rare"],
  extra: { stamina: [1, 3], strength: [1, 2], agility: [1, 2], spirit: [1, 2], intellect: [1, 2] },
  requires: { ge: ["level", { sub: ["itemLevel", 8] }] },
  durability: 45,
  value: 35,
}
