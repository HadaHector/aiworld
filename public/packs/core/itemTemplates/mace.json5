// Maces from parts (see ITEMS.md, Generated item types): a club, a ball on a haft, a flanged head.
// A material (its tint) times how well it is made (its model, weapons/mace.json5) times a rarity.
{
  kind: "weapon",
  icon: "item-oak-mace",
  slot: "mainHand",
  name: "{make}{material} Mace",
  axes: {
    material: [
      { id: "bronze", name: "Bronze", tint: "#c89a5a", level: 1, budget: 1 },
      { id: "iron", name: "Iron", tint: "#d6dae0", level: 8, budget: 1.5 },
    ],
    // How well it is made (CHARACTERS.md, *Weapons and shields*): which of the family's models it is.
    make: [
      { id: "crude", name: "Crude ", gear: ["mace.crude"], budget: 0.85 },
      { id: "standard", name: "", gear: ["mace.standard"] },
      { id: "ornate", name: "Ornate ", gear: ["mace.ornate"], budget: 1.2, level: 5 },
    ],
  },
  // No crude rarity, no plain ornament.
  never: [{ make: "crude", rarity: "rare" }, { make: "ornate", rarity: "common" }],
  stats: { weaponMin: [2, 3], weaponMax: [4, 6], weaponSpeed: 0.3, strength: [0, 1], spirit: [0, 1] },
  unscaled: ["weaponSpeed"],
  rarities: ["common", "uncommon", "rare"],
  extra: { stamina: [1, 3], strength: [1, 2], agility: [1, 2], spirit: [1, 2], intellect: [1, 2] },
  requires: { ge: ["level", { sub: ["itemLevel", 8] }] },
  durability: 45,
  value: 35,
}
