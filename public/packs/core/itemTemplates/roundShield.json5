// Round shields from parts: planks, then a rim and a boss, then a painted field and studs.
// A material (its tint) times how well it is made (its model, weapons/roundShield.json5) times a rarity.
{
  kind: "armour",
  icon: "item-round-shield-{material}",
  slot: "offHand",
  name: "{make}{material} Round Shield",
  axes: {
    material: [
      { id: "ash", name: "Ash", tint: "#8a6a40", level: 1, budget: 1 },
      { id: "oak", name: "Oak", tint: "#6b4a2a", level: 8, budget: 1.5 },
    ],
    // How well it is made (CHARACTERS.md, *Weapons and shields*): which of the family's models it is.
    make: [
      { id: "crude", name: "Crude ", gear: ["roundShield.crude"], budget: 0.85 },
      { id: "standard", name: "", gear: ["roundShield.standard"] },
      { id: "ornate", name: "Ornate ", gear: ["roundShield.ornate"], budget: 1.2, level: 5 },
    ],
  },
  // No crude rarity, no plain ornament.
  never: [{ make: "crude", rarity: "rare" }, { make: "ornate", rarity: "common" }],
  stats: { armor: [8, 10], stamina: [0, 1], blockChance: [9, 11], blockValue: [5, 8] },
  rarities: ["common", "uncommon", "rare"],
  extra: { stamina: [1, 3], strength: [1, 2], agility: [1, 2], spirit: [1, 2], intellect: [1, 2] },
  requires: { ge: ["level", { sub: ["itemLevel", 8] }] },
  durability: 50,
  value: "balance",   // from the curves (rules/balance.json5): the level, slot and rarity set it
}
