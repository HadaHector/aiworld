// Bows, the ranger's: held in the left fist, so they fill the off hand.
// A ladder (rules/itemLayout.json5, ITEMS.md *The ladder*): six items over levels 1-10 and grey
// trash between; its stats, armour, damage and price come from the curves.
{
  kind: "weapon",
  slot: "mainHand",
  fills: ["offHand"],
  icon: "item-bow-ash",
  ladder: "bow",
  name: "{tier} Bow",
  tiers: { start: "Crude Ash", loot3: "Ash", shop: "Seasoned Ash", quest: "Carved Ash", loot7: "Oak", loot9: "Ornate Oak", trash: "Battered" },
  rungs: {
    start: { gear: ["bow.crude"], tint: "#8a6a40" },
    loot3: { gear: ["bow.standard"], tint: "#8a6a40" },
    shop: { gear: ["bow.standard"], tint: "#9a7848" },
    quest: { gear: ["bow.ornate"], tint: "#9a7848" },
    loot7: { gear: ["bow.standard"], tint: "#6b4a2a" },
    loot9: { gear: ["bow.ornate"], tint: "#6b4a2a" },
    trash: { gear: ["bow.crude"], tint: "#8a7a60" },
  },
}
