{
  name: "Hills",
  voice: "verdant",
  spawnWeight: 2,
  lakeChance: 0.03,
  borderType: "mountain",
  settlement: "timber",
  // Hill country broken up by basins. The hills themselves - well-separated bumps, wide wavelength,
  // low persistence so the higher octaves stay texture - are what they always were; a slow noise
  // (a basin about 1.8 km across) decides where they stand. Where it is low the ground eases down to
  // a gently rolling floor well above the water, where it is high the hills stand at full height,
  // and between the two they are scaled down towards the floor into foothills. How much of an area
  // is basin is the area's own roll.
  height: {
    noises: [
      { name: "hills", type: "fbm", octaves: 5, frequency: 0.0021, amplitude: { range: [48, 72] }, persistence: 0.35, lacunarity: 2.0 },
      { name: "basin", type: "fbm", octaves: 3, frequency: 0.00055, amplitude: 1, persistence: 0.5, lacunarity: 2.0 },
      { name: "floor", type: "fbm", octaves: 3, frequency: 0.003, amplitude: 4, persistence: 0.45, lacunarity: 2.0 },
    ],
    steps: [
      { output: "hillsRaw", op: "sample", noise: "hills" },
      { output: "hill", op: "offset", input: "hillsRaw", amount: 50 },
      // The basin floor: 18 m and a few metres of gentle swell - with bedrock under it, never water.
      { output: "floorRaw", op: "sample", noise: "floor" },
      { output: "floor", op: "offset", input: "floorRaw", amount: 18 },
      { output: "basinRaw", op: "sample", noise: "basin" },
      { output: "hilliness", op: "remap", input: "basinRaw", inMin: { range: [-0.35, -0.1] }, inMax: { range: [0.2, 0.4] }, outMin: 0, outMax: 1 },
      { output: "hillShare", op: "clamp", input: "hilliness", min: 0, max: 1 },
      // floor + share x (hill - floor): the floor in a basin, the hills in hill country.
      { output: "rise", op: "subtract", a: "hill", b: "floor" },
      { output: "shareOfRise", op: "multiply", a: "rise", b: "hillShare" },
      { output: "result", op: "add", a: "floor", b: "shareOfRise" },
    ],
  },
  trees: {
    generator: "twoSpecies",
    lower: "broadleaf",
    upper: "pine",
    noises: [{ name: "stand", type: "fbm", octaves: 3, frequency: 0.0034, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
    cover: [
      { output: "standRaw", op: "sample", noise: "stand" },
      { output: "coverRamp", op: "remap", input: "standRaw", inMin: { range: [-0.6, -0.3] }, inMax: 0.2, outMin: 0, outMax: 0.7 },
      { output: "cover", op: "clamp", input: "coverRamp", min: 0, max: 0.7 },
    ],
    // Split by altitude rather than by noise: measured across hills zones the ground runs p25 33,
    // p50 58, p75 82, so this leaves the valley floors broadleaf, the tops coniferous, and a
    // genuinely mixed belt through the middle where most of the zone is.
    share: [
      { output: "ground", op: "input", name: "height" },
      { output: "shareRamp", op: "remap", input: "ground", inMin: 36, inMax: 74, outMin: 0, outMax: 1 },
      { output: "share", op: "clamp", input: "shareRamp", min: 0, max: 1 },
    ],
  },
  // A few boulders about, more where a hillside comes down to level ground, and along the water.
  rocks: { generator: "rockDensity", kind: "boulder", frequency: 0.005, openAt: 0, fullAt: 0.7, peak: { range: [0.012, 0.06] }, footOfSlope: { range: [0.3, 0.7] }, riverShore: { range: [0.75, 1.75] }, lakeShore: { range: [0.75, 1.75] } },
  // Each area its own trees, and every tree its own shade of them (spread). Pines first: a tree
  // takes the first rule for its kind, and conifers stray less far from green than the rest.
  treeTints: [
    // Each area's stone a shade of its own, and every boulder a little different.
    { kinds: ["boulder"], stone: { hue: { range: [-12, 12] }, saturation: { range: [0.6, 1.4] }, value: { range: [0.85, 1.15] }, spread: { hue: 6, saturation: 0.25, value: 0.15 } } },
    {
      kinds: ["pine"],
      leaves: { hue: { range: [-40, 80] }, saturation: { range: [0.6, 1.5] }, value: { range: [0.85, 1.15] }, spread: { hue: 10, saturation: 0.15, value: 0.1 } },
      bark: { hue: { range: [-20, 20] }, saturation: { range: [0.6, 1.4] }, value: { range: [0.75, 1.2] }, spread: { value: 0.12 } },
    },
    {
      // Red and orange through gold to blue - an autumn wood in a dozen shades, or a strange one.
      leaves: { hue: { range: [-100, 120] }, saturation: { range: [0.5, 1.8] }, value: { range: [0.85, 1.15] }, spread: { hue: 25, saturation: 0.25, value: 0.15 } },
      bark: { hue: { range: [-20, 20] }, saturation: { range: [0.6, 1.4] }, value: { range: [0.75, 1.2] }, spread: { value: 0.12 } },
    },
  ],
  ground: {
    // Which meadow an area is: grass's own texture under each, a different sward on it.
    base: { oneOf: ["grass", "meadowShort", "meadowLong", "meadowPoppy", "meadowButtercup", "meadowTussock"] },
    road: "track",
    // Each area's ground a little different: a warmer or cooler, paler or deeper version of it.
    adjust: { hue: { range: [-8, 8] }, saturation: { range: [0.85, 1.15] }, value: { range: [0.92, 1.08] } },
    // Its grassland - meadow, weeds, leafy and dry grass, and the grass on them - anywhere from an
    // orange, sunburnt steppe to a cold blue-green, and from washed-out to vivid. Roads, rock and
    // the forest floor keep their own colours.
    tints: [
      { family: "grassland", hue: { range: [-65, 80] }, saturation: { range: [0.35, 1.9] }, value: { range: [0.9, 1.1] } },
    ],
    layers: [
      // Hills reuses plains' own faded/dry/weeds materials - same idea, just rethresholded for hills'
      // much bigger detail amplitude (~60 vs plains' ~12.75).
      {
        id: "hills-north-fade",
        material: "grassPale",
        weight: {
          noises: [],
          steps: [
            { output: "facing", op: "input", name: "slopeFacing" },
            { output: "raw", op: "remap", input: "facing", inMin: 0.08, inMax: 0.4, outMin: 0, outMax: 1 },
            { output: "result", op: "clamp", input: "raw", min: 0, max: 1 },
          ],
        },
      },

      {
        id: "hills-south-dry",
        material: "grassDry",
        weight: {
          noises: [],
          steps: [
            { output: "facing", op: "input", name: "slopeFacing" },
            { output: "facingSouth", op: "scale", input: "facing", factor: -1 },
            { output: "raw", op: "remap", input: "facingSouth", inMin: 0.08, inMax: 0.4, outMin: 0, outMax: 1 },
            { output: "result", op: "clamp", input: "raw", min: 0, max: 1 },
          ],
        },
      },

      {
        id: "hills-valley-weeds",
        material: "weeds",
        weight: {
          noises: [],
          steps: [
            { output: "curvature", op: "input", name: "reliefCurvature" },
            { output: "raw", op: "remap", input: "curvature", inMin: 1.5, inMax: 6, outMin: 0, outMax: 1 },
            { output: "result", op: "clamp", input: "raw", min: 0, max: 1 },
          ],
        },
      },

      // Hills dip low enough in places to drop below sea level, forming small lakes (see
      // terrainSampler.ts's lakeFactor lerp toward LAKE_TARGET_HEIGHT) - the universal shoreLayer would
      // otherwise ring every one of those in the same sand it uses for ocean coastlines, which reads
      // wrong for a hillside pond. Both layers below deliberately out-weigh shoreLayer's own lake
      // component (whose max is 1.0) at every point it's active, one on each side of the waterline:
      // grassAtWaterline mirrors shoreLayer's exact lakeFactor ramp scaled up 1.5x (so it wins by a
      // growing margin, never a flat epsilon that could lose ground on a steep part of the ramp), then
      // fades out once truly underwater; gravelUnderwater ramps up over the same (complementary) handoff
      // band as height drops below sea level. Both ceilings are 2.2, not just "> 1.0": since the two
      // fade gates are complementary (sum to 1), the worst case is exactly at their midpoint where each
      // only gets half its own ceiling - 2.2*0.5=1.1 still clears shoreLayer's max of 1.0 there, so
      // there's no dead zone in the middle of the handoff where sand could still sneak through.
      {
        id: "hills-lake-shore-grass",
        material: "grass",
        weight: {
          noises: [],
          steps: [
            { output: "lakeFactor", op: "input", name: "lakeFactor" },
            { output: "lakeRaw", op: "remap", input: "lakeFactor", inMin: 0, inMax: 0.5, outMin: 0, outMax: 1 },
            { output: "lakeW", op: "clamp", input: "lakeRaw", min: 0, max: 1 },
            { output: "boosted", op: "scale", input: "lakeW", factor: 2.2 },
            { output: "height", op: "input", name: "height" },
            // SEA_LEVEL is 0 (areaField.ts) - fades this layer out over the last couple of units above
            // the waterline so it hands off to gravel cleanly instead of persisting underwater.
            { output: "aboveWaterRaw", op: "remap", input: "height", inMin: -2, inMax: 0.5, outMin: 0, outMax: 1 },
            { output: "aboveWater", op: "clamp", input: "aboveWaterRaw", min: 0, max: 1 },
            { output: "result", op: "multiply", a: "boosted", b: "aboveWater" },
          ],
        },
      },

      {
        id: "hills-lake-gravel",
        material: "gravel",
        weight: {
          noises: [],
          steps: [
            { output: "height", op: "input", name: "height" },
            { output: "underwaterRaw", op: "remap", input: "height", inMin: 0.5, inMax: -2, outMin: 0, outMax: 1 },
            { output: "underwater", op: "clamp", input: "underwaterRaw", min: 0, max: 1 },
            { output: "result", op: "scale", input: "underwater", factor: 2.2 },
          ],
        },
      },

      // Under the trees, the ground is the wood's own: leaf litter, humus and twigs rather than
      // meadow. treeCover is the tree scatter's own density here, so the floor follows the stands
      // and their clearings stay grass - frayed by a slow noise where the wood thins, so its edge wanders in and
      // out in tongues and islands instead of tracing the cover's contour. The leafy grass reads
      // the same noise (it is `shared`), so the two meet along one edge.
      {
        id: "hills-forest-floor",
        material: "forestFloor",
        weight: {
          noises: [{ name: "fray", shared: "woodEdge", type: "fbm", octaves: 3, frequency: 0.03, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
          steps: [
            { output: "cover", op: "input", name: "treeCover" },
            // Frayed only where the wood is thinning: nothing deep in the wood or out in the meadow.
            { output: "open", op: "invert", input: "cover" },
            { output: "thinning", op: "multiply", a: "cover", b: "open" },
            { output: "frayRaw", op: "sample", noise: "fray" },
            { output: "frayHere", op: "multiply", a: "frayRaw", b: "thinning" },
            { output: "frayShift", op: "scale", input: "frayHere", factor: 1.4 },
            { output: "frayed", op: "add", a: "cover", b: "frayShift" },
            { output: "result", op: "mask", input: "frayed", at: 0.96, off: 0.57 },
          ],
        },
      },

      // The wood's edge: leaves over grass, a wide band of it between meadow and forest floor,
      // rising as the meadow's share falls and giving way exactly as the floor's rises.
      {
        id: "hills-leafy-grass",
        material: "leafyGrass",
        weight: {
          noises: [{ name: "fray", shared: "woodEdge", type: "fbm", octaves: 3, frequency: 0.03, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
          steps: [
            { output: "cover", op: "input", name: "treeCover" },
            // Frayed only where the wood is thinning: nothing deep in the wood or out in the meadow.
            { output: "open", op: "invert", input: "cover" },
            { output: "thinning", op: "multiply", a: "cover", b: "open" },
            { output: "frayRaw", op: "sample", noise: "fray" },
            { output: "frayHere", op: "multiply", a: "frayRaw", b: "thinning" },
            { output: "frayShift", op: "scale", input: "frayHere", factor: 1.4 },
            { output: "frayed", op: "add", a: "cover", b: "frayShift" },
            { output: "rising", op: "mask", input: "frayed", at: 0.32, off: 0.05 },
            { output: "falling", op: "mask", input: "frayed", at: 0.57, off: 0.96 },
            { output: "result", op: "multiply", a: "rising", b: "falling" },
          ],
        },
      },

      // Stones along the water: a river washes its bed and its near bank down to the cobbles (the
      // waterline is ~22 units from the centreline at a source, ~62 at a mouth), a lake or a pond its
      // shore, showing through the water too, before the universal shore sand takes over further out.
      {
        id: "hills-stream-stones",
        material: "pebbles",
        weight: {
          noises: [{ name: "reach", type: "fbm", octaves: 2, frequency: 0.02, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
          steps: [
            { output: "gap", op: "input", name: "riverGap" },
            // A ragged reach - wider here, narrower there - rather than a ruled strip.
            { output: "reachRaw", op: "sample", noise: "reach" },
            { output: "reachShift", op: "scale", input: "reachRaw", factor: 9 },
            { output: "reach", op: "add", a: "gap", b: "reachShift" },
            { output: "band", op: "mask", input: "reach", at: 42, off: 60 },
            // A lake's shore and bed get the same stones, from where the shore starts down.
            { output: "lakeFactor", op: "input", name: "lakeFactor" },
            { output: "lake", op: "mask", input: "lakeFactor", at: 0.25, off: 0.02 },
            // And so does any hollow inland where the ground just dips to the waterline and fills - no
            // river, no lake cell, only low ground. Inland only: the coast keeps its sand.
            { output: "height", op: "input", name: "height" },
            { output: "low", op: "mask", input: "height", at: 0.6, off: 2.6 },
            { output: "landmass", op: "input", name: "landmass" },
            { output: "inland", op: "mask", input: "landmass", at: 0.95, off: 0.7 },
            { output: "pond", op: "multiply", a: "low", b: "inland" },
            { output: "lakeOrPond", op: "max", a: "lake", b: "pond" },
            { output: "water", op: "max", a: "band", b: "lakeOrPond" },
            // Past 1, to outweigh the universal shore sand on the same bank.
            { output: "result", op: "scale", input: "water", factor: 1.5 },
          ],
        },
      },

      // Drifts of wildflowers: patches of open, gentle ground on the sunny side of a hill.
      {
        id: "hills-wildflowers",
        material: "wildflowers",
        weight: {
          noises: [{ name: "drift", type: "fbm", octaves: 3, frequency: 0.006, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
          steps: [
            { output: "driftRaw", op: "sample", noise: "drift" },
            { output: "drift", op: "mask", input: "driftRaw", at: 0.4, off: 0.05 },
            { output: "slope", op: "input", name: "slope" },
            { output: "gentle", op: "mask", input: "slope", at: 0.96, off: 0.86 },
            { output: "cover", op: "input", name: "treeCover" },
            { output: "open", op: "mask", input: "cover", at: 0.1, off: 0.4 },
            { output: "openDrift", op: "multiply", a: "drift", b: "open" },
            { output: "facing", op: "input", name: "slopeFacing" },
            { output: "south", op: "mask", input: "facing", at: -0.15, off: 0.05 },
            { output: "gentleHere", op: "multiply", a: "gentle", b: "south" },
            { output: "result", op: "multiply", a: "openDrift", b: "gentleHere" },
          ],
        },
      },

      // Reed beds: patches of bulrush in the shallows and at the waterline of any inland water -
      // pond, lake or river alike, since the band is only the ground's height about the water.
      // Weighted to take the waterside stones' place where a patch falls.
      {
        id: "hills-reedbed",
        material: "reedbed",
        weight: {
          noises: [{ name: "patch", type: "fbm", octaves: 3, frequency: 0.03, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
          steps: [
            { output: "height", op: "input", name: "height" },
            { output: "wadeable", op: "mask", input: "height", at: -0.2, off: -1.1 },
            { output: "nearWater", op: "mask", input: "height", at: 0.5, off: 1.5 },
            { output: "band", op: "multiply", a: "wadeable", b: "nearWater" },
            { output: "landmass", op: "input", name: "landmass" },
            { output: "inland", op: "mask", input: "landmass", at: 0.95, off: 0.7 },
            { output: "patchRaw", op: "sample", noise: "patch" },
            { output: "patch", op: "mask", input: "patchRaw", at: 0.35, off: 0.05 },
            { output: "inlandBand", op: "multiply", a: "band", b: "inland" },
            { output: "patchBand", op: "multiply", a: "inlandBand", b: "patch" },
            { output: "result", op: "scale", input: "patchBand", factor: 4 },
          ],
        },
      },
    ],
  },
  sky: {
    horizon: "#baceca",
    zenith: "#487cba",
    cloud: "#f2f4f0",
  },
  light: {
    sunPeak: 68,
    moonPeak: 46,
  },
}
