{
  name: "Mountains",
  voice: "stony",
  spawnWeight: 1,
  lakeChance: 0.01, // rare tarns/crater lakes
  borderType: "mountain",
  settlement: "timber", // generates boundary hills along any edge shared with a differently-bordered biome
  // Target relief ~20-30m typical/high AND ~125m between major peaks (measured/eyeballed via
  // FORCE_BIOME_ID, see devConfig.ts - the first pass had the right height but peaks packed far too
  // close together against the character's scale). Base wavelength widened 61m -> 125m, and
  // persistence dropped 0.5 -> 0.42 so the higher octaves only add surface roughness instead of
  // competing peaks at their own shorter wavelength - that competing-peaks effect, not the
  // amplitude, was what made it read as crumpled rather than grand.
  //
  // On top of that, the same idea as the hills' basins: a slow noise (a basin about 2 km across)
  // opens broad alpine valleys between the ranges, floored well above the water, and the ranges
  // themselves stand higher - everything above their base level stretched by 1.7, which lifts the
  // highest peaks about 40%, while the valleys between them stay as deep as they were.
  height: {
    noises: [
      { name: "range", type: "fbm", octaves: 6, frequency: 0.0015, amplitude: { range: [50, 70] }, persistence: 0.42, lacunarity: 2.0 },
      { name: "basin", type: "fbm", octaves: 3, frequency: 0.00045, amplitude: 1, persistence: 0.5, lacunarity: 2.0 },
      { name: "floor", type: "fbm", octaves: 3, frequency: 0.0025, amplitude: 6, persistence: 0.45, lacunarity: 2.0 },
    ],
    steps: [
      { output: "rangeRaw", op: "sample", noise: "range" },
      { output: "zero", op: "constant", value: 0 },
      { output: "above", op: "max", a: "rangeRaw", b: "zero" },
      { output: "lift", op: "scale", input: "above", factor: 0.7 },
      { output: "stretched", op: "add", a: "rangeRaw", b: "lift" },
      { output: "peak", op: "offset", input: "stretched", amount: 60 },
      // The valley floor: 30 m and some swell - with bedrock under it, never water.
      { output: "floorRaw", op: "sample", noise: "floor" },
      { output: "floor", op: "offset", input: "floorRaw", amount: 30 },
      // Less of an area is valley than in the hills: mountains are mostly mountain.
      { output: "basinRaw", op: "sample", noise: "basin" },
      { output: "rangeness", op: "remap", input: "basinRaw", inMin: { range: [-0.75, -0.5] }, inMax: { range: [-0.2, 0] }, outMin: 0, outMax: 1 },
      { output: "rangeShare", op: "clamp", input: "rangeness", min: 0, max: 1 },
      // floor + share x (peak - floor): the floor in a valley, the range at full height elsewhere.
      { output: "rise", op: "subtract", a: "peak", b: "floor" },
      { output: "shareOfRise", op: "multiply", a: "rise", b: "rangeShare" },
      { output: "result", op: "add", a: "floor", b: "shareOfRise" },
    ],
  },
  trees: { generator: "standDensity", tree: "pine", frequency: 0.0035, openAt: -0.5, fullAt: 0.1, peak: { range: [0.3, 0.6] } },
  // Boulders scattered all over - above the treeline too - and piled at the foot of every crag and along the water.
  rocks: { generator: "rockDensity", kind: "boulder", frequency: 0.004, openAt: -0.4, fullAt: 0.3, peak: { range: [0.04, 0.1] }, footOfSlope: { range: [0.6, 1] }, riverShore: { range: [1, 2] }, lakeShore: { range: [1, 2] } },
  // Each area its own trees, and every tree its own shade of them (spread). Pines first: a tree
  // takes the first rule for its kind, and conifers stray less far from green than the rest.
  treeTints: [
    // Each area's stone a shade of its own, and every boulder a little different.
    { kinds: ["boulder"], stone: { hue: { range: [-12, 12] }, saturation: { range: [0.6, 1.4] }, value: { range: [0.85, 1.15] }, spread: { hue: 6, saturation: 0.25, value: 0.15 } } },
    {
      kinds: ["pine"],
      leaves: { hue: { range: [-40, 80] }, saturation: { range: [0.6, 1.5] }, value: { range: [0.85, 1.15] }, spread: { hue: 10, saturation: 0.15, value: 0.1 } },
      bark: { hue: { range: [-20, 20] }, saturation: { range: [0.6, 1.4] }, value: { range: [0.75, 1.2] }, spread: { value: 0.12 } },
    },
    {
      // Red and orange through gold to blue - an autumn wood in a dozen shades, or a strange one.
      leaves: { hue: { range: [-100, 120] }, saturation: { range: [0.5, 1.8] }, value: { range: [0.85, 1.15] }, spread: { hue: 25, saturation: 0.25, value: 0.15 } },
      bark: { hue: { range: [-20, 20] }, saturation: { range: [0.6, 1.4] }, value: { range: [0.75, 1.2] }, spread: { value: 0.12 } },
    },
  ],
  ground: {
    base: "rock",
    road: "trackStone",
    // Each area's ground a little different: a warmer or cooler, paler or deeper version of it.
    adjust: { hue: { range: [-5, 5] }, saturation: { range: [0.88, 1.12] }, value: { range: [0.94, 1.06] } },
    layers: [
      {
        id: "snow-mountains",
        material: "snow",
        weight: {
          noises: [{ name: "snowline", type: "fbm", octaves: 2, frequency: 0.03, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
          steps: [
            { output: "height", op: "input", name: "height" },
            { output: "curvature", op: "input", name: "reliefCurvature" },
            { output: "valleyBias", op: "scale", input: "curvature", factor: 2 },
            { output: "biasedHeight", op: "add", a: "height", b: "valleyBias" },
            { output: "jitterRaw", op: "sample", noise: "snowline" },
            { output: "jitter", op: "scale", input: "jitterRaw", factor: 4 },
            { output: "effectiveHeight", op: "add", a: "biasedHeight", b: "jitter" },
            { output: "raw", op: "remap", input: "effectiveHeight", inMin: 75, inMax: 95, outMin: 0, outMax: 1 },
            { output: "result", op: "clamp", input: "raw", min: 0, max: 1 },
          ],
        },
      },

      // Ravines/gullies cutting into a mountainside collect loose rubble - distinct from the sheer-face
      // rock the universal rockLayer already paints on any steep slope in any biome.
      {
        id: "mountains-scree-valley",
        material: "scree",
        weight: {
          noises: [],
          steps: [
            { output: "curvature", op: "input", name: "reliefCurvature" },
            { output: "raw", op: "remap", input: "curvature", inMin: 2, inMax: 8, outMin: 0, outMax: 1 },
            { output: "result", op: "clamp", input: "raw", min: 0, max: 1 },
          ],
        },
      },

      // The floor of a mountain valley, as opposed to its sides: scree above is curvature-only, so it
      // paints the whole basin including the sloping walls, while this also demands flatness. The two
      // therefore separate the way the real thing does - loose rubble on the valley sides, finer washed
      // gravel settled on the flat bottom - and blend where the floor meets the walls.
      //
      // Thresholds come from the mountains biome's own measured distribution rather than round numbers:
      // curvature there runs p75 2.0 / p90 3.6 / p95 4.7, and normalY p50 0.78 / p75 0.91.
      {
        id: "mountains-valley-gravel",
        material: "gravel",
        weight: {
          noises: [],
          steps: [
            { output: "curvature", op: "input", name: "reliefCurvature" },
            { output: "basinRaw", op: "remap", input: "curvature", inMin: 1.5, inMax: 4.5, outMin: 0, outMax: 1 },
            { output: "basin", op: "clamp", input: "basinRaw", min: 0, max: 1 },
            { output: "slope", op: "input", name: "slope" },
            { output: "flatRaw", op: "remap", input: "slope", inMin: 0.78, inMax: 0.92, outMin: 0, outMax: 1 },
            { output: "flat", op: "clamp", input: "flatRaw", min: 0, max: 1 },
            { output: "result", op: "multiply", a: "basin", b: "flat" },
          ],
        },
      },

      // Alpine meadow: flat ground low enough to be below the treeline. Mountain height runs p5 63 /
      // p50 108, and the snow layer starts biting around an effective 75, so grass has to live in the
      // bottom ~15% of the range to read as being below the snow rather than fighting it - hence full
      // grass under 55, gone by 85. A low-frequency noise breaks the elevation band up so its edge is a
      // ragged patchwork rather than a clean contour line, the same trick snowMountainsLayer uses on the
      // snowline.
      {
        id: "mountains-meadow-grass",
        material: "grass",
        weight: {
          noises: [{ name: "patches", type: "fbm", octaves: 2, frequency: 0.012, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
          steps: [
            { output: "height", op: "input", name: "height" },
            { output: "lowRaw", op: "remap", input: "height", inMin: 85, inMax: 55, outMin: 0, outMax: 1 },
            { output: "low", op: "clamp", input: "lowRaw", min: 0, max: 1 },
            { output: "slope", op: "input", name: "slope" },
            { output: "flatRaw", op: "remap", input: "slope", inMin: 0.86, inMax: 0.95, outMin: 0, outMax: 1 },
            { output: "flat", op: "clamp", input: "flatRaw", min: 0, max: 1 },
            { output: "lowFlat", op: "multiply", a: "low", b: "flat" },
            { output: "patchRaw", op: "sample", noise: "patches" },
            { output: "patchNorm", op: "remap", input: "patchRaw", inMin: -0.8, inMax: 0.8, outMin: 0.35, outMax: 1 },
            { output: "patch", op: "clamp", input: "patchNorm", min: 0, max: 1 },
            { output: "result", op: "multiply", a: "lowFlat", b: "patch" },
          ],
        },
      },

      // Stones along the water: a river washes its bed and its near bank down to the cobbles (the
      // waterline is ~22 units from the centreline at a source, ~62 at a mouth), a lake or a pond its
      // shore, showing through the water too, before the universal shore sand takes over further out.
      {
        id: "mountains-stream-stones",
        material: "pebbles",
        weight: {
          noises: [{ name: "reach", type: "fbm", octaves: 2, frequency: 0.02, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
          steps: [
            { output: "gap", op: "input", name: "riverGap" },
            // A ragged reach - wider here, narrower there - rather than a ruled strip.
            { output: "reachRaw", op: "sample", noise: "reach" },
            { output: "reachShift", op: "scale", input: "reachRaw", factor: 9 },
            { output: "reach", op: "add", a: "gap", b: "reachShift" },
            { output: "band", op: "mask", input: "reach", at: 42, off: 62 },
            // A lake's shore and bed get the same stones, from where the shore starts down.
            { output: "lakeFactor", op: "input", name: "lakeFactor" },
            { output: "lake", op: "mask", input: "lakeFactor", at: 0.25, off: 0.02 },
            // And so does any hollow inland where the ground just dips to the waterline and fills - no
            // river, no lake cell, only low ground. Inland only: the coast keeps its sand.
            { output: "height", op: "input", name: "height" },
            { output: "low", op: "mask", input: "height", at: 0.6, off: 2.6 },
            { output: "landmass", op: "input", name: "landmass" },
            { output: "inland", op: "mask", input: "landmass", at: 0.95, off: 0.7 },
            { output: "pond", op: "multiply", a: "low", b: "inland" },
            { output: "lakeOrPond", op: "max", a: "lake", b: "pond" },
            { output: "water", op: "max", a: "band", b: "lakeOrPond" },
            // Past 1, to outweigh the universal shore sand on the same bank.
            { output: "result", op: "scale", input: "water", factor: 1.5 },
          ],
        },
      },
    ],
  },
  sky: {
    horizon: "#cad8e2",
    zenith: "#2e5c9e",
    cloud: "#fcfdff",
  },
  // Thin, crisp air: sun and moon reach nearly the same height, and both read bright and clean.
  light: {
    sunPeak: 55,
    moonPeak: 55,
    sunZenith: "#fffffa",
  },
}
