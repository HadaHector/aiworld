/**
 * Sage hills - the scrubland family's high, cool, dry variant (see ZONES.md): broad, rounded hills,
 * one after another to the horizon, under a silver-grey sea of sagebrush a step or two apart, pale
 * grass and stony ground between. Twisted junipers scattered over the slopes, thickening to open
 * woods up the higher ground and the ridges; stones lying about everywhere. Clear, cool, dry light.
 */
{
  name: "Sage Hills",
  voice: "arid",
  spawnWeight: 1.5,
  lakeChance: 0.03,
  borderType: "mountain",
  settlement: "timber",
  // Each area its own country: how rugged its hills are, how far its valleys are filled to flat sage
  // plains, and how big the long swell under it all - read together by the height and the junipers.
  params: { rugged: { range: [0, 1] }, basin: { range: [0, 1] }, swell: { range: [0, 1] } },
  // Rounded hills - low and gentle in one area, big and steep-sided in the next - over a long swell,
  // their valleys filled up (`smoothMax`) to a flat basin floor: none in one area, wide sage plains
  // with the hills standing out of them in another.
  height: {
    noises: [
      { name: "hills", type: "fbm", octaves: 4, frequency: { param: "rugged", to: [0.0018, 0.003] }, amplitude: { param: "rugged", to: [8, 34] }, persistence: { param: "rugged", to: [0.35, 0.44] }, lacunarity: 2.0 },
      { name: "swell", type: "fbm", octaves: 2, frequency: 0.0008, amplitude: { param: "swell", to: [2, 24] }, persistence: 0.5, lacunarity: 2.0 },
      { name: "basinSwell", type: "fbm", octaves: 3, frequency: 0.003, amplitude: 1.2, persistence: 0.5, lacunarity: 2.0 },
    ],
    steps: [
      { output: "hillsRaw", op: "sample", noise: "hills" },
      { output: "swellRaw", op: "sample", noise: "swell" },
      { output: "both", op: "add", a: "hillsRaw", b: "swellRaw" },
      { output: "raised", op: "offset", input: "both", amount: { param: "rugged", to: [12, 26] } },
      // The basin floor: down in the hollows in one area, up past half the hills in another.
      { output: "basinRaw", op: "sample", noise: "basinSwell" },
      { output: "floor", op: "offset", input: "basinRaw", amount: { param: "basin", to: [3, 22] } },
      { output: "result", op: "smoothMax", a: "raised", b: "floor", k: 5 },
    ],
  },
  treeRules: { shore: [0.5, 2] },
  // Junipers: a few over all the hills, more up the higher ground and the ridges, in open woods where
  // a slower noise says so.
  trees: {
    noises: [{ name: "woods", type: "fbm", octaves: 2, frequency: 0.004, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
    steps: [
      { output: "height", op: "input", name: "height" },
      { output: "high", op: "mask", input: "height", at: { param: "rugged", to: [22, 48] }, off: { param: "rugged", to: [14, 26] } },
      { output: "curvature", op: "input", name: "reliefCurvature" },
      { output: "ridge", op: "mask", input: "curvature", at: -0.8, off: 0.2 },
      { output: "upland", op: "max", a: "high", b: "ridge" },
      { output: "woodsRaw", op: "sample", noise: "woods" },
      { output: "woods", op: "mask", input: "woodsRaw", at: 0.35, off: -0.15 },
      { output: "woodedUpland", op: "multiply", a: "upland", b: "woods" },
      { output: "few", op: "constant", value: 0.04 },
      { output: "junipers", op: "add", a: "woodedUpland", b: "few" },
      { output: "juniper", op: "scale", input: "junipers", factor: { range: [1.0, 1.8] } },
    ],
    outputs: { juniper: "juniper" },
  },
  // Sagebrush everywhere a step or two apart, thinning only on the steepest ground and in bare
  // patches; past 1 because bushes grow at a share of their density away from trees' shade, and
  // the sage is the cover here.
  bushes: {
    noises: [{ name: "bare", type: "fbm", octaves: 3, frequency: 0.015, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
    steps: [
      { output: "bareRaw", op: "sample", noise: "bare" },
      { output: "cover", op: "mask", input: "bareRaw", at: 0.0, off: -0.45 },
      { output: "slope", op: "input", name: "slope" },
      { output: "notSteep", op: "mask", input: "slope", at: 0.35, off: 0.6 },
      { output: "sage", op: "multiply", a: "cover", b: "notSteep" },
      { output: "sagebrush", op: "scale", input: "sage", factor: { range: [1.3, 1.8] } },
    ],
    outputs: { sagebrush: "sagebrush" },
  },
  // Stones lying everywhere, more on the ridges and at the foot of the slopes.
  rocks: { generator: "rockDensity", kind: "fieldStone", frequency: 0.006, openAt: -0.5, fullAt: 0.5, peak: { range: [0.08, 0.15] }, footOfSlope: { range: [0.4, 0.8] }, riverShore: { range: [1, 2] }, lakeShore: { range: [1, 2] } },
  treeTints: [
    { kinds: ["fieldStone"], stone: { hue: { range: [-10, 15] }, saturation: { range: [0.6, 1.0] }, value: { range: [0.92, 1.12] }, spread: { hue: 5, saturation: 0.1, value: 0.12 } } },
    {
      // Grey-green to blue-green, never fresh.
      leaves: { hue: { range: [-5, 15] }, saturation: { range: [0.75, 1.0] }, value: { range: [0.94, 1.06] }, spread: { hue: 5, saturation: 0.1, value: 0.08 } },
      bark: { hue: { range: [-6, 6] }, saturation: { range: [0.8, 1.05] }, value: { range: [0.92, 1.08] }, spread: { value: 0.08 } },
    },
  ],
  ground: {
    base: "grassPale",
    road: "trackStone",
    adjust: { hue: { range: [-5, 5] }, saturation: { range: [0.85, 1.05] }, value: { range: [0.95, 1.05] } },
    // Straw-grey to silver-green.
    tints: [{ family: "grassland", hue: { range: [-20, 5] }, saturation: { range: [0.4, 0.6] }, value: { range: [0.98, 1.08] } }],
    grass: [{ family: "grassland", kind: "tuft", density: 0.6, color: [0.56, 0.58, 0.48], chance: 0.8 }],
    layers: [
      // Stony ground on the rises and the ridges, where the wind takes the soil.
      {
        id: "sage-stony-rises",
        material: "gravel",
        weight: {
          noises: [{ name: "fray", type: "fbm", octaves: 3, frequency: 0.02, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
          steps: [
            { output: "curvature", op: "input", name: "reliefCurvature" },
            { output: "ridge", op: "scale", input: "curvature", factor: -1 },
            { output: "frayRaw", op: "sample", noise: "fray" },
            { output: "fray", op: "scale", input: "frayRaw", factor: 0.4 },
            { output: "rough", op: "add", a: "ridge", b: "fray" },
            { output: "rise", op: "mask", input: "rough", at: 0.5, off: 0.1 },
            { output: "result", op: "scale", input: "rise", factor: 0.9 },
          ],
        },
      },
      // Bare, dusty soil in patches between the bushes.
      {
        id: "sage-dust",
        material: "desertSilt",
        weight: {
          noises: [{ name: "patch", type: "fbm", octaves: 3, frequency: 0.012, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
          steps: [
            { output: "patchRaw", op: "sample", noise: "patch" },
            { output: "patch", op: "mask", input: "patchRaw", at: 0.75, off: 0.4 },
            { output: "result", op: "scale", input: "patch", factor: 0.6 },
          ],
        },
      },
    ],
  },
  // Dry: mostly clear and bright, a windy day now and then, rain only rarely.
  weather: [
    { weather: "clear", odds: 5 },
    { weather: "fair", odds: 3 },
    { weather: "cloudy", odds: 1 },
    { weather: "gale", odds: 1.5 },
    { weather: "drizzle", odds: 0.3 },
    { weather: "rain", odds: 0.3 },
    { weather: "storm", odds: 0.2 },
  ],
  // Clear and cool: a pale, high sky, a little haze far off.
  sky: {
    horizon: { oneOf: ["#d8dcd8", "#dcd8cc", "#d4dade"] },
    zenith: "#5a8cc6",
    cloud: "#f6f6f2",
    fogStart: { range: [0.35, 0.55] },
    fogEnd: { range: [0.9, 1.0] },
  },
  light: {
    sunPeak: 58,
    moonPeak: 45,
    ambientDay: "#c8ccc8",
  },
}
