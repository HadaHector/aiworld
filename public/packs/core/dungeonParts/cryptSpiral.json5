// A spiral stair round a pillar: a turn and a half, 11.5 m down, in 20 m by 20 m.
{
  tags: ["crypt", "stair", "descent", "spiral"],
  // Never straight after another spiral (the way down is one): two in a row is one long turning.
  apart: ["spiral"],
  weight: 2,
  sockets: [
    { at: [0, 0, 0], facing: 180, type: "crypt", size: [6, 6], reach: 1.5, reachOver: 1 },
    { at: [0, -11.5, 20], facing: 0, type: "crypt", size: [6, 6], reach: 1.5, reachOver: 1 },
  ],
  colliders: [
    { spiral: { centre: [0, 10], top: 0, inner: 3, outer: 9, wall: 1, start: 180, turns: 1.5, drop: 11.5, ceiling: 6 } },
  ],
  // Torches on the outer wall, about 4 m over the stair as it passes, alternating sides.
  spots: { light: [[-7.45, 1.4, 14.3], [7.45, -2.4, 5.7], [-8.6, -5.6, 10]] },
}
