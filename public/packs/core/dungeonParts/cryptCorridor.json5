// A crypt corridor, 6 m wide and high inside, 12 m long.
{
  tags: ["crypt", "corridor"],
  weight: 3,
  sockets: [
    { at: [0, 0, 0], facing: 180, type: "crypt", size: [6, 6] },
    { at: [0, 0, 12], facing: 0, type: "crypt", size: [6, 6] },
  ],
  // A barrel vault it may be drawn with instead (the style's share of the time): a half circle 3 m over its flat one.
  barrel: { over: [-3, 0, 3, 12], along: "z", spring: 6, rise: 3 },
