// What a giant scorpion drops.
{
  rolls: [1, 2],
  pick: [
    { weight: 40, item: "scorpionStinger" },
    { weight: 40, item: "scorpionClaw", count: [1,2] },
    { weight: 20 },
  ],
  always: [{ money: [0.5, 1.6], scale: "brute" }, { table: "gear" }],   // a share of a brute kill's money at its level (rules/balance.json5)
}
