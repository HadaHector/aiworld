// What a giant ant drops.
{
  rolls: [1, 2],
  pick: [
    { weight: 50, item: "antChitin", count: [1, 2] },
    { weight: 25, item: "acidGland" },
    { weight: 25 },
  ],
  always: [{ money: [0.5, 1.5], scale: "swarm" }, { table: "gear" }],   // a share of a swarm kill's money at its level (rules/balance.json5)
}
