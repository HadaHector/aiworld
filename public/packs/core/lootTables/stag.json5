// What a stag drops.
{
  rolls: [1, 2],
  pick: [
    { weight: 40, item: "deerHide" },
    { weight: 30, item: "venison", count: [1,3] },
    { weight: 30, item: "stagAntler" },
  ],
  always: [{ money: [0.5, 1.5], scale: "brute" }],   // a share of a brute kill's money at its level (rules/balance.json5)
}
