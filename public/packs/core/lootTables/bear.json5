// What a bear drops.
{
  rolls: [1, 2],
  pick: [
    { weight: 45, item: "bearPelt" },
    { weight: 30, item: "bearClaw", count: [1, 2] },
    { weight: 25, item: "boarMeat", count: [1, 3] },
  ],
  always: [{ money: [0.6, 1.6], scale: "brute" }],   // a share of a brute kill's money at its level (rules/balance.json5)
}
