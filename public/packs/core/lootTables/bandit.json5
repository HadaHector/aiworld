// What a bandit drops: money, food, and their gear.
{
  rolls: [1, 2],
  pick: [
    { weight: 35, item: "bread", count: [1, 2] },
    { weight: 15, item: "coinPouch" },
    { weight: 10, item: "brokenTooth", count: [1, 2] },
    { weight: 40 },
  ],
  always: [{ money: [0.6, 1.8], scale: "brute" }, { table: "gearHumanoid" }],   // a share of a brute kill's money at its level (rules/balance.json5)
}
