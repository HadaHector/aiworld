// A chest by the start: more and better than a kill, and some Hunter Marks.
{
  rolls: [2, 3],
  pick: [
    { weight: 20, item: "wolfPelt", count: [1, 4] },
    { weight: 15, item: "brokenTooth", count: [2, 6] },
    { weight: 15, item: "healthPotion", count: [1, 2] },
    { weight: 25, gear: "loot", rarity: ["common", "uncommon"] },
    { weight: 15, gear: "trash" },
    { weight: 5, gear: "loot", rarity: "rare" },
  ],
  always: [
    // A chest's money: about 12 brute kills' (rules/balance.json5: chests are a quarter of an hour's income, 5 an hour).
    { money: [10, 15], scale: "brute" },
    { money: [1, 3], currency: "marks" },
    // A mage learns Frost Nova from it (PROGRESSION.md, *Learning*): only a mage finds it.
    { item: "tomeOfFrostNova", origin: "mage" },
  ],
}
