// What a giant rat drops.
{
  rolls: [1, 2],
  pick: [
    { weight: 45, item: "ratTail" },
    { weight: 30, item: "ratTooth", count: [1,2] },
    { weight: 25 },
  ],
  always: [{ money: [0.2, 1.4], scale: "swarm" }, { table: "gear" }],   // a share of a swarm kill's money at its level (rules/balance.json5)
}
