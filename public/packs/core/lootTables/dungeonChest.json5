// A lair's chest, where its style has none of its own: coin, potions, a fair chance of gear.
{
  rolls: [2, 3],
  pick: [
    { weight: 20, item: "coinPouch" },
    { weight: 20, item: "healthPotion", count: [1, 2] },
    { weight: 10, item: "manaPotion", count: [1, 2] },
    { weight: 30, gear: "loot", rarity: ["common", "uncommon"] },
    { weight: 15, gear: "trash" },
    { weight: 8, gear: "loot", rarity: "rare" },
  ],
  // About 12 brute kills' money (rules/balance.json5: chests are a quarter of an hour's income, 5 an hour).
  always: [{ money: [10, 15], scale: "brute" }],
}
