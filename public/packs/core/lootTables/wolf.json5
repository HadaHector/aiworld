// What a wolf drops (see CREATURES.md).
{
  rolls: [1, 2],
  pick: [
    { weight: 45, item: "wolfPelt" },
    { weight: 30, item: "wolfFang", count: [1, 2] },
    { weight: 15, item: "brokenTooth", count: [1, 3] },
    { weight: 10 },
  ],
  always: [{ money: [0.5, 1.5], scale: "brute" }, { table: "gear" }],   // a share of a brute kill's money at its level (rules/balance.json5)
}
