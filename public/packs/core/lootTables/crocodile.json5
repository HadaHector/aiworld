// What a crocodile drops.
{
  rolls: [1, 2],
  pick: [
    { weight: 45, item: "crocodileHide" },
    { weight: 35, item: "crocodileTooth", count: [1,3] },
    { weight: 20 },
  ],
  always: [{ money: [0.6, 1.8], scale: "brute" }, { table: "gear" }],   // a share of a brute kill's money at its level (rules/balance.json5)
}
