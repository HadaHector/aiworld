// What a giant beetle drops.
{
  rolls: [1, 2],
  pick: [
    { weight: 50, item: "beetleShell", count: [1,2] },
    { weight: 30, item: "beetleHorn" },
    { weight: 20 },
  ],
  always: [{ money: [0.5, 1.5], scale: "brute" }],   // a share of a brute kill's money at its level (rules/balance.json5)
}
