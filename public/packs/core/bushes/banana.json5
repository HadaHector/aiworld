// A wild banana: long paddle leaves, torn into strips by the wind, on stalks bundled into a stem two
// or three metres tall - the leaves arching out from its top. Built as a frond plant whose steep,
// thick stalks together make the stem (`fronds.stalk`), the blades painted on (`paddleLeaf`).
{
  model: "bush",
  variants: 4,
  width: [3.5, 5],
  height: [3, 4.5],
  fronds: {
    count: [7, 10],
    // The blade; the stalk comes before it.
    length: [2.2, 3.0],
    width: 0.7,
    // Near upright stalks, together a stem; the blades arching out and over from its top.
    angle: [4, 22],
    curl: 150,
    fold: 0.08,
    segments: 6,
    stalk: { length: [1.8, 2.4], width: 0.14 },
  },
  bed: { plants: [1, 3], spread: 3 },
  foliage: {
    builder: "paddleLeaf",
    dark: [0.08, 0.24, 0.05],
    light: [0.36, 0.56, 0.16],
    stem: [0.3, 0.4, 0.16],
    stems: [1, 1],
    // Tears in each leaf.
    leaves: 9,
    leafLength: 0.5,
    leafWidth: 0.9,
    bare: 0,
  },
  tint: [[0.85, 0.92, 0.85], [1.1, 1.06, 0.98]],
  scale: [0.8, 1.3],
}
