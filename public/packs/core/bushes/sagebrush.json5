  foliage: {
    builder: "leafyBush",
    dark: [0.34, 0.37, 0.33],
    light: [0.76, 0.79, 0.72],
    stem: [0.3, 0.26, 0.21],
    stems: [5, 8],
    leaves: 700,
    leafLength: 0.04,
    leafWidth: 0.018,
    bare: 0.3,
  },
  tint: [[0.88, 0.9, 0.88], [1.08, 1.06, 1.02]],
  scale: [0.75, 1.25],
}
