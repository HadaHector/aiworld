// An elephant ear: a clump of huge heart-shaped leaves, each held out on its own long stalk, waist to
// chest high - the jungle floor's broad leaves where a gap lets the light down. Each leaf a frond
// strip on a stalk (`fronds.stalk`), its heart painted on (`heartLeaf`).
{
  model: "bush",
  variants: 4,
  width: [2.4, 3.4],
  height: [1.4, 2.0],
  fronds: {
    count: [5, 8],
    // The blade; the stalk comes before it.
    length: [1.0, 1.4],
    width: 1.0,
    // Stalks rising steeply, the blades turning out and hanging at the end of them.
    angle: [8, 40],
    curl: 95,
    fold: 0.06,
    segments: 5,
    stalk: { length: [0.8, 1.3], width: 0.06 },
  },
  bed: { plants: [2, 4], spread: 2.5 },
  foliage: {
    builder: "heartLeaf",
    dark: [0.05, 0.2, 0.05],
    light: [0.26, 0.48, 0.12],
    stem: [0.34, 0.44, 0.2],
    stems: [1, 1],
    // Veins fanning from the stalk.
    leaves: 9,
    leafLength: 0.5,
    leafWidth: 0.95,
    bare: 0,
  },
  tint: [[0.85, 0.92, 0.85], [1.1, 1.06, 0.98]],
  scale: [0.8, 1.4],
}
