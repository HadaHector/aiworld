// An understory bush: a dozen stems from one root, forking as they rise, leafy over the top two
// thirds. Like the trees it is oversized against the character - shoulder height or more - so a
// wood has something between the trunks at eye level.
{
  model: "bush",
  variants: 4,
  width: [3.2, 4.4],
  height: [2.2, 3.0],
  cards: 3,
  clumps: 7,
  clumpSize: [1.4, 2.0],
  foliage: {
    builder: "leafyBush",
    dark: [0.07, 0.2, 0.06],
    light: [0.4, 0.58, 0.17],
    stem: [0.3, 0.22, 0.15],
    stems: [5, 7],
    leaves: 700,
    leafLength: 0.07,
    leafWidth: 0.035,
    bare: 0.3,
  },
  tint: [[0.85, 0.92, 0.82], [1.1, 1.06, 0.95]],
  scale: [0.8, 1.2],
}
