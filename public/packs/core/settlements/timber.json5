// The one settlement style so far, used by every core biome: one-storey cottages, each its own
// variant (see buildings/cottage.json5).
{
  // How big a place grows, by tier. The best ground gets the biggest places (the score thresholds
  // are in code - see settlementConfig.ts).
  tiers: {
    //   radius: gates sit on a circle this far from the centre; streets and houses stay inside it
    //   sideStreetChance: chance a side street is tried at each branching point along a main street
    //   plotFill: chance a plot along a street is built on, rather than left as a gap
    hamlet: { radius: 60, sideStreetChance: 0.35, sideStreetLength: [22, 40], plotFill: 0.75, squareRadius: 8 },
    village: { radius: 85, sideStreetChance: 0.65, sideStreetLength: [28, 55], plotFill: 0.85, squareRadius: 11 },
    town: { radius: 115, sideStreetChance: 0.85, sideStreetLength: [32, 70], plotFill: 0.9, squareRadius: 15 },
  },

  houses: {
    // The buildings its plots are built with (see buildings/), each as often as its weight over the
    // sum of them all; every house is its own variant of one.
    buildings: [{ building: "cottage", weight: 1 }],
    // Front wall this far back from the street's level edge. At least far enough that the whole
    // footprint is past where a plot's levelling fades out next to a street.
    setback: [3.4, 6],
    // Gap between neighbouring houses along a street.
    gap: [1.5, 5],
  },
}
