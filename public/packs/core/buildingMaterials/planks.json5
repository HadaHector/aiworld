// Weatherboarding: wide upright planks, each its own weathered brown-grey, split by dark gaps, their
// grain running up the wall - a barn's or a shed's walls.
{
  name: "Planks",
  // Metres one repeat covers: 8 planks across, so each is 0.75 m wide - twice life size, so they
  // read from afar - and its grain repeats every 6 m up the wall.
  size: 6,
  shine: 0.05,
  texture: {
    bumpStrength: 1.6,
    pipeline: {
      noises: [
        { name: "planks", type: "bricks", tileCycles: [8, 1], stagger: 0, amplitude: 1, mode: "edge" },
        { name: "grain", type: "fbm", octaves: 3, tileCycles: 6, amplitude: 1, persistence: 0.5, lacunarity: 2.2, stretch: [1, 12] },
        { name: "fibre", type: "fbm", octaves: 2, tileCycles: 70, amplitude: 1, persistence: 0.5, lacunarity: 2, stretch: [1, 16] },
        { name: "weather", type: "fbm", octaves: 2, tileCycles: 3, amplitude: 1, persistence: 0.5, lacunarity: 2 },
      ],
      steps: [
        { output: "joint", op: "sample", noise: "planks" },
        { output: "plankId", op: "sample", noise: "planks", mode: "cell" },
        { output: "grainRaw", op: "sample", noise: "grain" },
        { output: "fibreRaw", op: "sample", noise: "fibre" },
        { output: "weatherRaw", op: "sample", noise: "weather" },
        { output: "gap", op: "mask", input: "joint", at: 0.015, off: 0.04 },
        {
          output: "plankTone",
          op: "colorRamp",
          input: "plankId",
          stops: [
            { at: 0.0, color: [0.56, 0.46, 0.35] },
            { at: 0.35, color: [0.66, 0.56, 0.44] },
            { at: 0.6, color: [0.6, 0.55, 0.49] },
            { at: 1.0, color: [0.5, 0.42, 0.34] },
          ],
        },
        { output: "grainShade", op: "remap", input: "grainRaw", inMin: -1, inMax: 1, outMin: 0.86, outMax: 1.1 },
        { output: "fibreShade", op: "remap", input: "fibreRaw", inMin: -1, inMax: 1, outMin: 0.92, outMax: 1.06 },
        { output: "weatherShade", op: "remap", input: "weatherRaw", inMin: -1, inMax: 1, outMin: 0.85, outMax: 1.08 },
        { output: "shadeA", op: "multiply", a: "grainShade", b: "fibreShade" },
        { output: "shade", op: "multiply", a: "shadeA", b: "weatherShade" },
        { output: "wood", op: "multiply", a: "plankTone", b: "shade" },
        { output: "gapColor", op: "color", value: [0.1, 0.08, 0.06] },
        { output: "diffuse", op: "mix", a: "wood", b: "gapColor", t: "gap" },
        { output: "roughness", op: "constant", value: 0.85 },
        // Height: each plank rounded off at its edges, the gaps sunk, the grain raised.
        { output: "edgeRaw", op: "remap", input: "joint", inMin: 0.015, inMax: 0.1, outMin: 0, outMax: 1 },
        { output: "edge", op: "clamp", input: "edgeRaw", min: 0, max: 1 },
        { output: "fibreBump", op: "scale", input: "fibreRaw", factor: 0.12 },
        { output: "height", op: "add", a: "edge", b: "fibreBump" },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
}
