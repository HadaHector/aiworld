// Flagstones: big flat slabs of every shape, laid edge to edge on a crypt's floor - worn smooth, each
// its own grey, the joints between them narrow and filled with dark grit.
{
  name: "Flagstones",
  // Metres one repeat covers: about five slabs across, each near 2.5 m - twice life size, so they
  // read from afar.
  size: 12,
  shine: 0.06,
  texture: {
    bumpStrength: 1.6,
    pipeline: {
      noises: [
        // Slabs a little longer than wide, as flags are cut.
        { name: "slabs", type: "worley", tileCycles: 5, amplitude: 1, mode: "edge", stretch: [1.3, 1] },
        { name: "grain", type: "fbm", octaves: 3, tileCycles: 60, amplitude: 1, persistence: 0.55, lacunarity: 2 },
        { name: "wear", type: "fbm", octaves: 3, tileCycles: 7, amplitude: 1, persistence: 0.5, lacunarity: 2 },
        { name: "chips", type: "worley", tileCycles: 36, amplitude: 1, mode: "f1" },
      ],
      steps: [
        { output: "joint", op: "sample", noise: "slabs" },
        { output: "slabId", op: "sample", noise: "slabs", mode: "cell" },
        { output: "grainRaw", op: "sample", noise: "grain" },
        { output: "wearRaw", op: "sample", noise: "wear" },
        { output: "chipRaw", op: "sample", noise: "chips" },
        { output: "fray", op: "scale", input: "grainRaw", factor: 0.012 },
        { output: "jointFrayed", op: "add", a: "joint", b: "fray" },
        { output: "gap", op: "mask", input: "jointFrayed", at: 0.012, off: 0.035 },
        {
          output: "slabTone",
          op: "colorRamp",
          input: "slabId",
          stops: [
            { at: 0.0, color: [0.4, 0.39, 0.37] },
            { at: 0.3, color: [0.48, 0.46, 0.42] },
            { at: 0.55, color: [0.43, 0.41, 0.38] },
            { at: 0.8, color: [0.52, 0.5, 0.46] },
            { at: 1.0, color: [0.37, 0.37, 0.36] },
          ],
        },
        // Worn paler where feet went, darker in the hollows.
        { output: "shadeRaw", op: "add", a: "wearRaw", b: "grainRaw" },
        { output: "shade", op: "remap", input: "shadeRaw", inMin: -1, inMax: 1, outMin: 0.82, outMax: 1.1 },
        { output: "slab", op: "multiply", a: "slabTone", b: "shade" },
        { output: "chipDent", op: "mask", input: "chipRaw", at: 0.0, off: 0.1 },
        { output: "chipColor", op: "color", value: [0.3, 0.29, 0.27] },
        { output: "chipped", op: "mix", a: "slab", b: "chipColor", t: "chipDent" },
        { output: "gritColor", op: "color", value: [0.2, 0.19, 0.17] },
        { output: "diffuse", op: "mix", a: "chipped", b: "gritColor", t: "gap" },
        { output: "roughness", op: "constant", value: 0.8 },
        // Height: each slab flat, its edges just rounded off, the joints sunk.
        { output: "edgeRaw", op: "remap", input: "joint", inMin: 0.012, inMax: 0.08, outMin: 0, outMax: 1 },
        { output: "edge", op: "clamp", input: "edgeRaw", min: 0, max: 1 },
        { output: "edgeRound", op: "power", input: "edge", exponent: 0.4 },
        { output: "chipDepth", op: "scale", input: "chipDent", factor: -0.12 },
        { output: "grainBump", op: "scale", input: "grainRaw", factor: 0.04 },
        { output: "slabHeight", op: "add", a: "edgeRound", b: "chipDepth" },
        { output: "height", op: "add", a: "slabHeight", b: "grainBump" },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
}
