// A stair's tread: dressed slabs laid across the step, worn smooth, each its own grey - its front
// edge, the nosing, rounded off in a bevel and its back a little sunk where the next riser stands.
// Laid by the step itself (DUNGEONS.md, *Materials*): metres across, but once exactly from the
// nosing (v 0) to the back (v 1), so the bevel is on the edge however deep the step is.
{
  name: "Stair Tread",
  // 3 m across a repeat (two slabs), and the whole step's depth once.
  size: [3, 1],
  shine: 0.08,
  texture: {
    bumpStrength: 7,
    pipeline: {
      noises: [
        // Two slabs across a repeat, one deep: u and v are where in its slab a point is.
        { name: "slabs", type: "bricks", tileCycles: [2, 1], stagger: 0, amplitude: 1, mode: "edge" },
        { name: "grain", type: "fbm", octaves: 3, tileCycles: 60, amplitude: 1, persistence: 0.55, lacunarity: 2 },
        { name: "wear", type: "fbm", octaves: 3, tileCycles: 6, amplitude: 1, persistence: 0.5, lacunarity: 2 },
        { name: "chips", type: "worley", tileCycles: 30, amplitude: 1, mode: "f1" },
      ],
      steps: [
        { output: "across", op: "sample", noise: "slabs", mode: "v" },
        { output: "slabId", op: "sample", noise: "slabs", mode: "cell" },
        { output: "slabU", op: "sample", noise: "slabs", mode: "u" },
        { output: "grainRaw", op: "sample", noise: "grain" },
        { output: "wearRaw", op: "sample", noise: "wear" },
        { output: "chipRaw", op: "sample", noise: "chips" },

        // The joint between two slabs, along the step.
        { output: "toJointA", op: "scale", input: "slabU", factor: 1 },
        { output: "uBack", op: "invert", input: "slabU" },
        { output: "toJoint", op: "min", a: "toJointA", b: "uBack" },
        { output: "joint", op: "mask", input: "toJoint", at: 0.01, off: 0.025 },

        // The nosing: rounded over the front 14%, the back's last 6% sunk under the riser.
        { output: "noseRaw", op: "remap", input: "across", inMin: 0, inMax: 0.14, outMin: 0, outMax: 1 },
        { output: "noseClamped", op: "clamp", input: "noseRaw", min: 0, max: 1 },
        { output: "nose", op: "power", input: "noseClamped", exponent: 0.45 },
        { output: "backFlip", op: "invert", input: "across" },
        { output: "backRaw", op: "remap", input: "backFlip", inMin: 0, inMax: 0.06, outMin: 0, outMax: 1 },
        { output: "back", op: "clamp", input: "backRaw", min: 0, max: 1 },
        { output: "bevel", op: "min", a: "nose", b: "back" },

        // Each slab its own grey; paler where feet wore it, the nosing palest of all.
        {
          output: "tone",
          op: "colorRamp",
          input: "slabId",
          stops: [
            { at: 0.0, color: [0.56, 0.54, 0.5] },
            { at: 0.35, color: [0.62, 0.6, 0.55] },
            { at: 0.7, color: [0.58, 0.55, 0.5] },
            { at: 1.0, color: [0.66, 0.63, 0.58] },
          ],
        },
        { output: "shadeRaw", op: "add", a: "wearRaw", b: "grainRaw" },
        { output: "shade", op: "remap", input: "shadeRaw", inMin: -1, inMax: 1, outMin: 0.85, outMax: 1.08 },
        { output: "worn", op: "multiply", a: "tone", b: "shade" },
        { output: "edgeLight", op: "remap", input: "noseClamped", inMin: 0, inMax: 1, outMin: 1.3, outMax: 1 },
        { output: "lit", op: "multiply", a: "worn", b: "edgeLight" },
        { output: "chipDent", op: "mask", input: "chipRaw", at: 0.0, off: 0.1 },
        { output: "chipColor", op: "color", value: [0.42, 0.4, 0.37] },
        { output: "chipped", op: "mix", a: "lit", b: "chipColor", t: "chipDent" },
        { output: "jointColor", op: "color", value: [0.28, 0.27, 0.25] },
        { output: "diffuse", op: "mix", a: "chipped", b: "jointColor", t: "joint" },
        { output: "roughness", op: "constant", value: 0.78 },

        { output: "jointDepth", op: "scale", input: "joint", factor: -0.15 },
        { output: "chipDepth", op: "scale", input: "chipDent", factor: -0.05 },
        { output: "grainBump", op: "scale", input: "grainRaw", factor: 0.015 },
        { output: "h1", op: "add", a: "bevel", b: "jointDepth" },
        { output: "h2", op: "add", a: "h1", b: "chipDepth" },
        { output: "height", op: "add", a: "h2", b: "grainBump" },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
}
