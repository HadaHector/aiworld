// Grave earth: a mound's dug soil, dark brown and crumbly, grass coming back over it in patches -
// greener where it has had longer. For grave mounds and dug earth.
{
  name: "Grave Earth",
  // Metres one repeat covers: crumbs and tufts twice life size.
  size: 3,
  shine: 0.05,
  texture: {
    bumpStrength: 1.4,
    pipeline: {
      noises: [
        { name: "mottle", type: "fbm", octaves: 3, tileCycles: 4, amplitude: 1, persistence: 0.5, lacunarity: 2.0 },
        { name: "grain", type: "fbm", octaves: 3, tileCycles: 30, amplitude: 1, persistence: 0.55, lacunarity: 2.0 },
        { name: "tufts", type: "fbm", octaves: 3, tileCycles: 9, amplitude: 1, persistence: 0.6, lacunarity: 2.0 },
      ],
      steps: [
        { output: "mottle", op: "sample", noise: "mottle" },
        { output: "grain", op: "sample", noise: "grain" },
        { output: "tuftRaw", op: "sample", noise: "tufts" },
        {
          output: "soil",
          op: "colorRamp",
          input: "mottle",
          stops: [
            { at: -1, color: [0.22, 0.17, 0.12] },
            { at: 0, color: [0.3, 0.23, 0.16] },
            { at: 1, color: [0.36, 0.28, 0.19] },
          ],
        },
        { output: "crumbShade", op: "remap", input: "grain", inMin: -1, inMax: 1, outMin: 0.78, outMax: 1.15 },
        { output: "earth", op: "multiply", a: "soil", b: "crumbShade" },
        // Grass over it in patches.
        { output: "grassMask", op: "mask", input: "tuftRaw", at: 0.35, off: 0.05 },
        { output: "grassColor", op: "color", value: [0.3, 0.42, 0.18] },
        { output: "grassShade", op: "multiply", a: "grassColor", b: "crumbShade" },
        { output: "diffuse", op: "mix", a: "earth", b: "grassShade", t: "grassMask" },
        { output: "roughness", op: "constant", value: 0.95 },
        { output: "grainBump", op: "scale", input: "grain", factor: 0.15 },
        { output: "tuftBump", op: "scale", input: "grassMask", factor: 0.2 },
        { output: "height", op: "add", a: "grainBump", b: "tuftBump" },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
}
