// Smooth stone: water-worn rounded fieldstones, grey, warm brown and a few pale ones, with soft
// mottling and faint pale veins - no mortar, no joints. A campfire ring's, a wall's coping.
// Texture's cells are each a whole stone (so a stone's colour is its own), 1 m or so, twice life size.
{
  name: "Smooth Stone",
  size: 3,
  shine: 0.12,
  texture: {
    bumpStrength: 0.7,
    pipeline: {
      noises: [
        { name: "cells", type: "worley", tileCycles: 3, amplitude: 1, mode: "edge" },
        { name: "mottle", type: "fbm", octaves: 3, tileCycles: 8, amplitude: 1, persistence: 0.55, lacunarity: 2 },
        { name: "veins", type: "ridged", octaves: 2, tileCycles: 5, amplitude: 1, persistence: 0.5, lacunarity: 2.2, stretch: [1, 3] },
        { name: "grit", type: "fbm", octaves: 2, tileCycles: 90, amplitude: 1, persistence: 0.5, lacunarity: 2 },
      ],
      steps: [
        { output: "edge", op: "sample", noise: "cells" },
        { output: "stoneId", op: "sample", noise: "cells", mode: "cell" },
        { output: "mottleRaw", op: "sample", noise: "mottle" },
        { output: "veinRaw", op: "sample", noise: "veins" },
        { output: "gritRaw", op: "sample", noise: "grit" },
        {
          output: "tone",
          op: "colorRamp",
          input: "stoneId",
          stops: [
            { at: 0.0, color: [0.5, 0.49, 0.47] },
            { at: 0.25, color: [0.6, 0.55, 0.48] },
            { at: 0.5, color: [0.42, 0.42, 0.43] },
            { at: 0.75, color: [0.66, 0.63, 0.58] },
            { at: 1.0, color: [0.52, 0.47, 0.41] },
          ],
        },
        { output: "shade", op: "remap", input: "mottleRaw", inMin: -1, inMax: 1, outMin: 0.82, outMax: 1.1 },
        { output: "vein", op: "mask", input: "veinRaw", at: 1.2, off: 1.05 },
        { output: "veinColor", op: "color", value: [0.78, 0.76, 0.72] },
        { output: "shaded", op: "multiply", a: "tone", b: "shade" },
        { output: "veined", op: "mix", a: "shaded", b: "veinColor", t: "vein" },
        // Between two stones a little darker: where one meets another in the dirt.
        { output: "seamRaw", op: "mask", input: "edge", at: 0.02, off: 0.1 },
        { output: "seamColor", op: "color", value: [0.2, 0.18, 0.16] },
        { output: "diffuse", op: "mix", a: "veined", b: "seamColor", t: "seamRaw" },
        { output: "roughness", op: "constant", value: 0.75 },
        { output: "gritBump", op: "scale", input: "gritRaw", factor: 0.1 },
        { output: "domeRaw", op: "remap", input: "edge", inMin: 0.02, inMax: 0.5, outMin: 0, outMax: 1 },
        { output: "dome", op: "clamp", input: "domeRaw", min: 0, max: 1 },
        { output: "height", op: "add", a: "dome", b: "gritBump" },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
}
