// Crystal: a cave's glowing crystals (props/crystals.json5) - clear and cold, lit from inside (a
// glow, as lit wax's, faking the light in it), paler along its edges' veils and milky toward the root.
{
  name: "Crystal",
  // Only props are made of it: a texture of its own, not a layer of the buildings' array
  // (PROP_RENDERING.md).
  propsOnly: true,
  textureSize: 256,
  size: 0.6,
  shine: 0.9,
  glow: 0.75,
  texture: {
    bumpStrength: 0.4,
    pipeline: {
      noises: [
        { name: "veils", type: "fbm", octaves: 3, tileCycles: 3, stretch: [1, 6], amplitude: 1, persistence: 0.5, lacunarity: 2 },
        { name: "milk", type: "fbm", octaves: 2, tileCycles: 2, amplitude: 1, persistence: 0.5, lacunarity: 2 },
      ],
      steps: [
        { output: "veilRaw", op: "sample", noise: "veils" },
        { output: "veil", op: "mask", input: "veilRaw", at: 0.6, off: 0 },
        { output: "milkRaw", op: "sample", noise: "milk" },
        { output: "milk", op: "mask", input: "milkRaw", at: 0.8, off: -0.4 },
        { output: "deep", op: "color", value: [0.38, 0.5, 0.95] },
        { output: "pale", op: "color", value: [0.72, 0.86, 1.0] },
        { output: "veiled", op: "mix", a: "deep", b: "pale", t: "veil" },
        { output: "milky", op: "color", value: [0.82, 0.86, 0.95] },
        { output: "milkAmount", op: "scale", input: "milk", factor: 0.35 },
        { output: "diffuse", op: "mix", a: "veiled", b: "milky", t: "milkAmount" },
        { output: "roughness", op: "constant", value: 0.15 },
        { output: "height", op: "scale", input: "veil", factor: 0.2 },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
}
