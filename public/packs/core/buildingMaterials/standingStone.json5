// Standing stone: old grey granite, mottled warm and cool, pitted with weather, freckled with pale
// lichen and a few dark streaks where rain runs down - from the druid grove's concept (a tall stone,
// grey-green, a spiral carved on it, moss in the hollows). Moss is its own material (`moss`); this is
// the rock under it. Props only. Twice life size: a lichen patch the size of a hand reads from afar.
{
  name: "Standing Stone",
  propsOnly: true,
  size: 4,
  shine: 0.1,
  texture: {
    bumpStrength: 1.6,
    pipeline: {
      noises: [
        { name: "mottle", type: "fbm", octaves: 4, tileCycles: 5, amplitude: 1, persistence: 0.55, lacunarity: 2 },
        { name: "grit", type: "fbm", octaves: 3, tileCycles: 70, amplitude: 1, persistence: 0.5, lacunarity: 2 },
        { name: "pits", type: "worley", tileCycles: 22, amplitude: 1, mode: "f1", warp: 0.3, sizeJitter: 0.3 },
        { name: "lichen", type: "fbm", octaves: 3, tileCycles: 9, amplitude: 1, persistence: 0.6, lacunarity: 2 },
        { name: "streaks", type: "fbm", octaves: 3, tileCycles: 6, stretch: [1, 6], amplitude: 1, persistence: 0.5, lacunarity: 2 },
      ],
      steps: [
        { output: "mottleRaw", op: "sample", noise: "mottle" },
        { output: "gritRaw", op: "sample", noise: "grit" },
        { output: "pitRaw", op: "sample", noise: "pits" },
        { output: "lichenRaw", op: "sample", noise: "lichen" },
        { output: "streakRaw", op: "sample", noise: "streaks" },
        {
          output: "rock",
          op: "colorRamp",
          input: "mottleRaw",
          stops: [
            { at: -1, color: [0.3, 0.31, 0.3] },
            { at: 0, color: [0.42, 0.42, 0.39] },
            { at: 1, color: [0.55, 0.53, 0.47] },
          ],
        },
        { output: "streakMask", op: "mask", input: "streakRaw", at: 0.35, off: 0.0 },
        { output: "streakTone", op: "color", value: [0.18, 0.19, 0.17] },
        { output: "streaked", op: "mix", a: "rock", b: "streakTone", t: "streakMask" },
        { output: "lichenMask", op: "mask", input: "lichenRaw", at: 0.55, off: 0.3 },
        { output: "lichenTone", op: "color", value: [0.58, 0.6, 0.45] },
        { output: "diffuse", op: "mix", a: "streaked", b: "lichenTone", t: "lichenMask" },
        { output: "roughness", op: "constant", value: 0.88 },
        { output: "gritBump", op: "scale", input: "gritRaw", factor: 0.35 },
        { output: "pitBump", op: "scale", input: "pitRaw", factor: 0.5 },
        { output: "height", op: "add", a: "gritBump", b: "pitBump" },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
}
