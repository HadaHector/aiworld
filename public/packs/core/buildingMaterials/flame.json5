// A flame, or a lamp's lit pane: giving its own light, the same in sun and shadow, day or night -
// warm, brightest low and in its heart, flickering in streaks up it. A piece's tint dims or warms it
// (a horn pane amber, a candle's tongue near white).
{
  name: "Flame",
  size: 0.6,
  glow: 1,
  texture: {
    bumpStrength: 0,
    pipeline: {
      noises: [{ name: "flicker", type: "fbm", octaves: 3, tileCycles: 4, amplitude: 1, persistence: 0.5, lacunarity: 2, stretch: [1, 3] }],
      steps: [
        { output: "flickerRaw", op: "sample", noise: "flicker" },
        {
          output: "diffuse",
          op: "colorRamp",
          input: "flickerRaw",
          stops: [
            { at: -1, color: [1.0, 0.55, 0.18] },
            { at: 0, color: [1.0, 0.75, 0.35] },
            { at: 1, color: [1.0, 0.92, 0.65] },
          ],
        },
        { output: "roughness", op: "constant", value: 1 },
        { output: "height", op: "constant", value: 0 },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
}
