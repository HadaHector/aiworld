// A window's glass seen from inside: the day through it - a pale sky, a little rippled, drawn with
// the daylight as it is (bright by day, dimming at dusk, dark by night) rather than lit.
{
  name: "Day Pane",
  size: 1,
  daylight: 1,
  texture: {
    bumpStrength: 0.1,
    pipeline: {
      noises: [{ name: "ripple", type: "fbm", octaves: 2, tileCycles: 6, amplitude: 1, persistence: 0.5, lacunarity: 2 }],
      steps: [
        { output: "rippleRaw", op: "sample", noise: "ripple" },
        { output: "shade", op: "remap", input: "rippleRaw", inMin: -1, inMax: 1, outMin: 0.9, outMax: 1.05 },
        { output: "base", op: "color", value: [0.82, 0.88, 0.94] },
        { output: "diffuse", op: "multiply", a: "base", b: "shade" },
        { output: "roughness", op: "constant", value: 0.1 },
        { output: "height", op: "scale", input: "rippleRaw", factor: 0.2 },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
}
