// An inn's taproom: worn floorboards, limewashed walls, a beamed ceiling, and an open timber stair
// up to the gallery round it.
{
  name: "Taproom",
  floor: { material: "floorboards", tints: [[1, 1, 1], [0.88, 0.84, 0.8]] },
  walls: { material: "plaster", tints: [[1.0, 0.92, 0.78], [0.96, 0.88, 0.74]] },
  ceiling: { material: "plaster", tints: [[0.9, 0.84, 0.74]] },
  beams: { material: "timber", tints: [[0.45, 0.38, 0.34]] },
  timber: { material: "timber", tints: [[0.5, 0.42, 0.36], [0.42, 0.36, 0.32]] },
  stair: "open",
  // A fireplace against its chimney.
  hearth: true,
  // What it is furnished with, highest priority first (see FURNITURE.md) - a `per` count so many
  // for each that many tiles of floor.
  furnish: [
    { prop: "bar", at: "wall", priority: 10 },
    { prop: "fireplace", at: "hearth", priority: 9 },
    { group: "diningTable", count: [0.8, 1.2], per: 10, at: "centre", priority: 6 },
    { prop: "barrel", count: [0.6, 1], per: 8, at: "corner", priority: 4 },
    { prop: "bench", count: [0, 0.6], per: 8, at: "wall", priority: 3 },
    { prop: "hangingLantern", count: [0.6, 1], per: 10, priority: 2 },
    { prop: "sconce", count: [1, 1.5], per: 8, priority: 2 },
    { prop: "banner", chance: 0.4, priority: 1 },
  ],
}
