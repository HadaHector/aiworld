// A cellar: a flagged floor, rubble walls, and the boards and joists of the floor over it for a
// ceiling.
{
  name: "Cellar",
  floor: { material: "stoneBricks", tints: [[0.7, 0.68, 0.66]] },
  walls: { material: "rubbleStone", tints: [[0.8, 0.78, 0.76]] },
  ceiling: { material: "planks", tints: [[0.7, 0.64, 0.58]] },
  beams: { material: "timber", tints: [[0.4, 0.34, 0.3]] },
  timber: { material: "timber", tints: [[0.42, 0.36, 0.32]] },
  stair: "solid",
  // What it is furnished with, highest priority first (see FURNITURE.md) - a `per` count so many
  // for each that many tiles of floor.
  furnish: [
    { prop: "barrel", count: [1, 1.6], per: 6, at: "wall", priority: 6 },
    { prop: "crate", count: [0.5, 1], per: 6, at: "corner", priority: 5 },
    { prop: "sack", count: [0.5, 1], per: 6, at: "any", priority: 4 },
    { prop: "hangingLantern", chance: 0.6, priority: 1 },
  ],
}
