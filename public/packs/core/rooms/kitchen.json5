// A kitchen: a flagstone floor, smoke-darkened walls and a beamed ceiling.
{
  name: "Kitchen",
  floor: { material: "stoneBricks", tints: [[0.85, 0.83, 0.8]] },
  walls: { material: "plaster", tints: [[0.86, 0.8, 0.7], [0.8, 0.76, 0.68]] },
  ceiling: { material: "plaster", tints: [[0.72, 0.68, 0.6]] },
  beams: { material: "timber", tints: [[0.36, 0.3, 0.28]] },
  timber: { material: "timber", tints: [[0.45, 0.38, 0.34]] },
  stair: "solid",
  // What it is furnished with, highest priority first (see FURNITURE.md) - a `per` count so many
  // for each that many tiles of floor.
  furnish: [
    { prop: "stove", at: "wall", priority: 9 },
    { prop: "table", at: "centre", priority: 7 },
    { prop: "barrel", count: [0.6, 1], per: 6, at: "corner", priority: 5 },
    { prop: "sack", count: [0.6, 1.2], per: 6, at: "corner", priority: 4 },
    { prop: "stool", count: [1, 2], at: "any", priority: 3 },
    { prop: "chest", chance: 0.5, at: "wall", priority: 2 },
    { prop: "sconce", count: [0.8, 1.2], per: 8, priority: 1 },
  ],
}
