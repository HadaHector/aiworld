// A store room: boards on the floor, the walls and the ceiling.
{
  name: "Store Room",
  floor: { material: "floorboards", tints: [[0.95, 0.92, 0.9]] },
  walls: { material: "planks", tints: [[0.85, 0.78, 0.7]] },
  ceiling: { material: "planks", tints: [[0.75, 0.68, 0.6]] },
  beams: { material: "timber", tints: [[0.42, 0.36, 0.32]] },
  timber: { material: "timber", tints: [[0.45, 0.38, 0.34]] },
  stair: "open",
  // What it is furnished with, highest priority first (see FURNITURE.md) - a `per` count so many
  // for each that many tiles of floor.
  furnish: [
    { prop: "crate", count: [1, 1.5], per: 6, at: "wall", priority: 6 },
    { prop: "sack", count: [0.6, 1.2], per: 6, at: "corner", priority: 5 },
    { prop: "barrel", count: [0.5, 1], per: 6, at: "any", priority: 4 },
    { prop: "chest", chance: 0.5, at: "wall", priority: 3 },
  ],
}
