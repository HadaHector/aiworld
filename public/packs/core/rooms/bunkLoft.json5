// A bunkhouse's loft, where the men sleep: log walls, rough boards on the floor, open up to the
// boarded underside of the roof, round log ties across it at the top of its walls.
{
  name: "Bunk Loft",
  floor: { material: "floorboards", tints: [[0.82, 0.78, 0.74], [0.76, 0.72, 0.68]] },
  walls: { material: "logWall", tints: [[0.9, 0.86, 0.82], [0.84, 0.8, 0.76]] },
  ceiling: { material: "planks", tints: [[0.66, 0.6, 0.54]] },
  beams: { material: "roundLog", tints: [[0.8, 0.76, 0.72]] },
  timber: { material: "timber", tints: [[0.45, 0.38, 0.34]] },
  stair: "open",
  underRoof: true,
}
