// A hunting lodge's hall: bare dark log walls, worn boards underfoot, open up to the roof, a hearth
// against the chimney - and the hunter's marks about it: antlers over the door wall, herbs hung to dry,
// a table to skin and carve at.
{
  name: "Hunter's Hall",
  floor: { material: "floorboards", tints: [[0.86, 0.8, 0.74], [0.78, 0.74, 0.7]] },
  walls: { material: "logWall", tints: [[0.9, 0.86, 0.82], [0.84, 0.8, 0.76]] },
  ceiling: { material: "planks", tints: [[0.68, 0.62, 0.56]] },
  beams: { material: "roundLog", tints: [[0.78, 0.74, 0.7]] },
  timber: { material: "timber", tints: [[0.5, 0.42, 0.36], [0.45, 0.38, 0.34]] },
  stair: "open",
  underRoof: true,
  hearth: true,
  furnish: [
    { prop: "fireplace", at: "hearth", priority: 9 },
    { group: "messTable", count: [0.3, 0.5], per: 12, at: "centre", priority: 7 },
    { prop: "antlerMount", count: [0.5, 0.9], per: 8, priority: 6 },
    { prop: "bed", chance: 0.6, at: "wall", priority: 5 },
    { prop: "herbBundle", count: [0.5, 1], per: 8, priority: 4 },
    { prop: "chest", at: "wall", priority: 3 },
    { prop: "sconce", count: [0.8, 1.2], per: 10, priority: 2 },
  ],
}
