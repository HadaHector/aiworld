// A standalone: someone lives out at a remote place, and the giver wants word of them.
{
  weight: 1,
  giver: ["reeve", "priest", "innkeeper"],
  place: { tags: ["remote"] },
  people: { keeper: { roles: [], make: ["sexton", "hermit", "quarryman", "forester", "traveller"] } },
  quests: [
    {
      ender: "keeper",
      parts: [{ part: "visitPlace" }, { part: "talkTo", npc: "keeper" }],
      title: "Word from {place}",
      offer: [["Nobody has heard from {keeperGiven} out at {place} in a while."], ["That's not like them."], ["Would you go and see they're well?"]],
      progress: ["Any word of {keeperGiven}?"],
      done: ["{giverGiven} was worried about me? Ha! Tell them I'm well enough. Here - take this for the walk."],
    },
  ],
}
