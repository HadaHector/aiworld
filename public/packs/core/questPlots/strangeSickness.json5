// GAMEPLAY.md's test chain: the creatures sicken, a healer wants a sample, a maker a cure, and the
// cure must be tried on one of them. Talk, kill and loot, talk, gather, receive, use, talk.
{
  intro: true,
  giver: ["reeve", "innkeeper", "priest"],
  people: {
    healer: { roles: ["priest", "innkeeper"], relation: ["friend", "sister", "brother", "wife", "husband"], make: ["hermit"] },
    maker: { roles: ["shopkeeper", "farmer", "smith"], make: ["hermit"] },
  },
  creatures: { hostility: ["hostile", "neutral"], family: ["beast"] },
  place: { objects: ["herb"] },
  quests: [
    {
      ender: "healer",
      parts: [{ part: "talkTo", npc: "healer" }],
      title: "A Strange Sickness",
      offer: [
        ["There's something wrong with the {creatures} round {settlement}.", "Have you seen the {creatures} out there? Foaming, wild-eyed, wrong."],
        ["Two of the herders came back bitten, and one of them is still abed."],
        ["{healerGiven} - {healerTitle} - knows more of sickness than anyone here."],
        ["Go and ask what can be done."],
        ["I'll see you're paid for your trouble."],
      ],
      progress: ["Have you spoken to {healerGiven}?"],
      done: ["{giverGiven} sent you about the {creatures}? Then it's worse than I feared."],
    },
    {
      giver: "healer",
      parts: ["cullBeasts", "lootFrom"],
      title: "Thinning the Sick",
      offer: [
        ["The sickness spreads from beast to beast."],
        "$motive",
        ["Thin them out before it reaches the flocks."],
      ],
      progress: ["The sample - have you got it?"],
      done: ["Yes... this is no common fever. I've seen its like once before."],
    },
    {
      giver: "healer",
      ender: "maker",
      parts: [{ part: "talkTo", npc: "maker" }],
      title: "A Cure, Perhaps",
      offer: [
        ["There may be a cure."],
        ["{makerGiven} knows how to make the salve - ask them, and tell them I sent you."],
        ["Be quick about it."],
      ],
      progress: ["Go to {makerGiven}."],
      done: ["A salve against the sickness? It can be done, if you fetch me what it needs."],
    },
    {
      giver: "maker",
      parts: ["gatherAt"],
      title: "What the Salve Needs",
      offer: [
        ["The salve wants {objects}, and plenty of them."],
        "$motive",
        ["Bring them here and I'll set to work."],
      ],
      progress: ["Got the {objects}?"],
      done: ["Good, these will do nicely. Give me a moment."],
    },
    {
      giver: "maker",
      parts: [{ part: "receiveCure", npc: "maker" }],
      title: "The Salve",
      offer: [["Here it is - still warm."], ["Careful with it; there's no more where that came from."]],
      progress: ["Take the salve."],
      done: ["Now it's to be tried."],
    },
    {
      giver: "maker",
      ender: "giver",
      parts: ["salveBeast"],
      title: "The Cure Tried",
      offer: [
        ["Work the salve into one of the sick {creatures}."],
        "$motive",
        ["If it takes, go back to {giverGiven} and tell them so."],
      ],
      progress: ["Well? Did it work?"],
      done: ["It worked? Then {settlement} owes you more than it can pay - but take this, with our thanks."],
      choice: true,
    },
  ],
}
