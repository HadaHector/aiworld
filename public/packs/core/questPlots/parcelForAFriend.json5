// A standalone: carry a parcel to someone the giver is close to.
{
  weight: 1.5,
  giver: ["shopkeeper", "innkeeper", "farmer", "villager", "smith"],
  people: { friend: { roles: [], relation: ["friend", "sister", "brother", "mother", "father", "sweetheart"] } },
  quests: [
    {
      ender: "friend",
      parts: [{ part: "receiveParcel", npc: "giver" }, { part: "deliverParcel", npc: "friend" }],
      title: "A Parcel for {friendGiven}",
      offer: [["Would you take this to {friendGiven} for me?"], ["It's nothing much - but it matters to me that it gets there."], ["Tell {friendGiven} it's from me."]],
      progress: ["Did {friendGiven} get it?"],
      done: ["From {giverGiven}? Oh... thank you. Here, for your trouble."],
    },
  ],
}
