/**
 * An abandoned track: the cart track's earth gone dark and soft, moss and fallen leaves over it, thin
 * green through it. It does not clear grass: the grass has come back (compare `track`'s clearsGrass).
 * Painted by the `abandonedRoad` layer where a road is abandoned (roadConfig's `abandoned` class).
 */
{
  name: "Overgrown Track",
  texture: {
    bumpStrength: 0.5,
    pipeline: {
      noises: [
        { name: "mottle", type: "fbm", octaves: 3, tileCycles: 11, amplitude: 1, persistence: 0.5, lacunarity: 2.0 },
        { name: "moss", type: "fbm", octaves: 3, tileCycles: 6, amplitude: 1, persistence: 0.55, lacunarity: 2.0 },
        { name: "leaves", type: "scatter", tileCycles: 40, amplitude: 1, shape: "chip", count: 2, density: 0.35, size: [0.4, 0.8], aspect: [0.4, 0.7], height: [0.3, 0.6] },
      ],
      steps: [
        { output: "mottleRaw", op: "sample", noise: "mottle" },
        { output: "mottleMask", op: "mask", input: "mottleRaw", at: 1.5, off: -1.5 },
        { output: "mossRaw", op: "sample", noise: "moss" },
        { output: "mossMask", op: "mask", input: "mossRaw", at: 0.4, off: -0.3 },
        { output: "leafCover", op: "sample", noise: "leaves", mode: "coverage" },
        { output: "leafId", op: "sample", noise: "leaves", mode: "cell" },

        // Dark damp earth, lighter where it is dry.
        { output: "damp", op: "color", value: [0.22, 0.18, 0.13] },
        { output: "dry", op: "color", value: [0.34, 0.29, 0.21] },
        { output: "earth", op: "mix", a: "damp", b: "dry", t: "mottleMask" },
        // Moss and the first green over it.
        { output: "mossTone", op: "color", value: [0.22, 0.3, 0.14] },
        { output: "mossy", op: "mix", a: "earth", b: "mossTone", t: "mossMask" },
        // Fallen leaves: yellow-brown.
        { output: "leafTone", op: "colorRamp", input: "leafId", stops: [{ at: 0, color: [0.55, 0.4, 0.12] }, { at: 0.5, color: [0.45, 0.28, 0.1] }, { at: 1, color: [0.62, 0.5, 0.16] }] },
        { output: "leafAmount", op: "scale", input: "leafCover", factor: 0.85 },
        { output: "diffuse", op: "mix", a: "mossy", b: "leafTone", t: "leafAmount" },
        { output: "roughness", op: "constant", value: 0.9 },
        { output: "height", op: "scale", input: "mottleMask", factor: 0.25 },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
}
