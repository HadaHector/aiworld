// The edge of a wood: grass a shade darker than out in the open, with fallen leaves lying over
// about half of it and the soil showing through more. Laid in the band of tree cover between the
// open meadow and the forest floor proper (see the biomes' treeCover rules), so walking into a wood
// the leaves thicken over the grass rather than the ground switching from one to the other.
{
  name: "Leafy Grass",
  detail: { strength: 0.35 },
  texture: {
    generator: "grassland",
    dark: [0.21, 0.32, 0.14],
    light: [0.34, 0.47, 0.22],
    soil: [0.2, 0.15, 0.1],
    soilAmount: 0.4,
    leaves: 0.6,
    leafColors: [[0.26, 0.2, 0.12], [0.4, 0.33, 0.2]],
    roughness: 0.65,
    bumpStrength: 1.1,
  },
  grass: [
    { kind: "meadow", density: 1.4, color: [0.36, 0.52, 0.22] },
    { kind: "tuft", density: 0.4, color: [0.32, 0.44, 0.18] },
  ],
}
