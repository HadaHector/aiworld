// Frost polygons: a polar desert's patterned ground - freeze and thaw, year on year, have sorted the
// stones out of the soil and pushed them aside, so the ground lies in polygons a few metres across,
// each a slightly domed middle of fine grey silt and grit, ringed by a border of coarse, frost-split
// stones.
//
// The polygons are worley cells; the stones are a finer worley's cells, lumps standing up, kept to a
// band along each polygon's edge. The colour follows the height: silt grey in the middles, the
// stones paler on their tops and dark between them.
{
  name: "Frost Polygons",
  texture: {
    bumpStrength: 2.4,
    pipeline: {
      noises: [
        { name: "polygons", type: "worley", tileCycles: 9, amplitude: 1, mode: "edge", warp: 0.3, sizeJitter: 0.4, round: 0.3 },
        { name: "stones", type: "worley", tileCycles: 75, amplitude: 1, mode: "edge", warp: 0.4, sizeJitter: 0.5, round: 0.5 },
        { name: "dome", type: "worley", tileCycles: 9, amplitude: 1, mode: "f1", warp: 0.3, sizeJitter: 0.4 },
        { name: "grit", type: "fbm", octaves: 2, tileCycles: 120, amplitude: 1, persistence: 0.5, lacunarity: 2.0 },
        { name: "mottle", type: "fbm", octaves: 3, tileCycles: 6, amplitude: 1, persistence: 0.5, lacunarity: 2.0 },
      ],
      steps: [
        // The stone border: a band along each polygon's edge, ragged.
        { output: "polyEdge", op: "sample", noise: "polygons" },
        { output: "gritRaw", op: "sample", noise: "grit" },
        { output: "gritJitter", op: "scale", input: "gritRaw", factor: 0.03 },
        { output: "edgeRagged", op: "add", a: "polyEdge", b: "gritJitter" },
        { output: "border", op: "mask", input: "edgeRagged", at: 0.06, off: 0.16 },
        // The stones: lumps, each a finer cell raised in its middle.
        { output: "stoneEdge", op: "sample", noise: "stones" },
        { output: "stone", op: "mask", input: "stoneEdge", at: 0.12, off: 0.0 },
        { output: "stones", op: "multiply", a: "stone", b: "border" },
        // The silt middles, domed a little.
        { output: "domeDist", op: "sample", noise: "dome" },
        { output: "domeUp", op: "mask", input: "domeDist", at: 0.0, off: 0.6 },
        { output: "grit", op: "mask", input: "gritRaw", at: 1.3, off: -1.3 },
        { output: "siltDome", op: "scale", input: "domeUp", factor: 0.25 },
        { output: "siltGrit", op: "scale", input: "grit", factor: 0.1 },
        { output: "silt", op: "add", a: "siltDome", b: "siltGrit" },
        { output: "stoneHeight", op: "scale", input: "stones", factor: 0.65 },
        { output: "height", op: "max", a: "silt", b: "stoneHeight" },

        {
          output: "byHeight",
          op: "colorRamp",
          input: "height",
          stops: [
            { at: 0.0, color: [0.24, 0.24, 0.23] },
            { at: 0.15, color: [0.42, 0.41, 0.39] },
            { at: 0.35, color: [0.48, 0.47, 0.45] },
            { at: 0.6, color: [0.56, 0.55, 0.53] },
            { at: 0.85, color: [0.66, 0.65, 0.62] },
          ],
        },
        { output: "mottleRaw", op: "sample", noise: "mottle" },
        { output: "mottleShade", op: "remap", input: "mottleRaw", inMin: -1, inMax: 1, outMin: 0.9, outMax: 1.08 },
        { output: "diffuse", op: "multiply", a: "byHeight", b: "mottleShade" },
        { output: "roughness", op: "constant", value: 0.9 },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
}
