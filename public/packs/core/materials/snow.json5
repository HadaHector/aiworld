// Snow: wind-scoured into soft ridges (a sine wave, bent by a slow noise so the ridges wander),
// a cool blue-white rather than pure white - so the sun on it shines without blinding - shadowed
// bluer in its broad hollows, with ice crystals glinting here and there - single
// worley points, picked by their own value, smoother than the snow around them.
{
  name: "Snow",
  detail: { strength: 0.35 },
  texture: {
    bumpStrength: 1.2,
    pipeline: {
      noises: [
        { name: "mottle", type: "fbm", octaves: 3, tileCycles: 13, amplitude: 1, persistence: 0.5, lacunarity: 2.0 },
        { name: "broad", type: "fbm", octaves: 2, tileCycles: 3, amplitude: 1, persistence: 0.5, lacunarity: 2.0 },
        { name: "sastrugi", type: "wave", tileCycles: [5, 20], amplitude: 1, shape: "sine" },
        { name: "bend", type: "fbm", octaves: 3, tileCycles: 3, amplitude: 1, persistence: 0.5, lacunarity: 2.0 },
        { name: "glints", type: "worley", tileCycles: 260, amplitude: 1, mode: "f1" },
      ],
      steps: [
        { output: "mottle", op: "sample", noise: "mottle" },
        { output: "mottleMask", op: "mask", input: "mottle", at: 1.75, off: -1.75 },
        { output: "broad", op: "sample", noise: "broad" },
        { output: "broadMask", op: "mask", input: "broad", at: 1.5, off: -1.5 },

        { output: "bendRaw", op: "sample", noise: "bend" },
        { output: "bendPx", op: "scale", input: "bendRaw", factor: 50 },
        { output: "still", op: "constant", value: 0 },
        { output: "ridgeRaw", op: "sample", noise: "sastrugi", offset: ["still", "bendPx"] },
        { output: "ridge", op: "mask", input: "ridgeRaw", at: 1, off: -1 },
        // Ridges only where the wind has had its way - in patches.
        { output: "scoured", op: "mask", input: "mottle", at: 0.9, off: -0.4 },
        { output: "ridgeShown", op: "multiply", a: "ridge", b: "scoured" },

        { output: "glintDist", op: "sample", noise: "glints" },
        { output: "glintId", op: "sample", noise: "glints", mode: "cell" },
        { output: "glintSpot", op: "mask", input: "glintDist", at: 0.05, off: 0.2 },
        { output: "glintPick", op: "mask", input: "glintId", at: 0.9, off: 0.86 },
        { output: "glintMask", op: "multiply", a: "glintSpot", b: "glintPick" },

        {
          output: "snowTone",
          op: "colorRamp",
          input: "mottleMask",
          stops: [
            { at: 0.0, color: [0.72, 0.78, 0.88] },
            { at: 0.55, color: [0.78, 0.83, 0.91] },
            { at: 1.0, color: [0.84, 0.88, 0.94] },
          ],
        },
        { output: "shadowColor", op: "color", value: [0.63, 0.71, 0.85] },
        { output: "shadowBlend", op: "scale", input: "broadMask", factor: 0.7 },
        { output: "drifted", op: "mix", a: "snowTone", b: "shadowColor", t: "shadowBlend" },
        // The lee of each ridge a touch bluer.
        { output: "leeBlend", op: "invert", input: "ridgeShown" },
        { output: "leeAmount", op: "scale", input: "leeBlend", factor: 0.25 },
        { output: "ridged", op: "mix", a: "drifted", b: "shadowColor", t: "leeAmount" },
        { output: "glintColor", op: "color", value: [0.95, 0.97, 1.0] },
        { output: "diffuse", op: "mix", a: "ridged", b: "glintColor", t: "glintMask" },

        { output: "roughSnow", op: "constant", value: 0.5 },
        { output: "roughGlint", op: "constant", value: 0.12 },
        { output: "roughness", op: "mix", a: "roughSnow", b: "roughGlint", t: "glintMask" },

        { output: "drifts", op: "scale", input: "broadMask", factor: 0.45 },
        { output: "ridgeRelief", op: "scale", input: "ridgeShown", factor: 0.35 },
        { output: "driftRidges", op: "add", a: "drifts", b: "ridgeRelief" },
        { output: "fineSnow", op: "scale", input: "mottleMask", factor: 0.2 },
        { output: "height", op: "add", a: "driftRidges", b: "fineSnow" },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
  // Nothing grows through snow, and a patch of it clears the grass of the ground it lies on - gone
  // wherever the snow is half the blend or more, thinning in across its edge.
  clearsGrass: 2,
}
