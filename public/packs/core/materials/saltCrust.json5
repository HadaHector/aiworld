// Salt crust: a salt flat's floor - a hard white crust dried into plates a pace or two across, each
// ringed by a low ridge where the salt pushed up along its edges, with fine cracks across the plates,
// a creamy grey in the low places and grey-brown mud showing in the seams.
//
// Its height is the plates (worley cells, flat in their middles) with the ridges standing up along
// their edges, a finer net of cracks cut into them and a faint swell. The colour follows the height:
// mud in the seams, cream-grey on the plates, bright white along the ridges.
{
  name: "Salt Crust",
  texture: {
    bumpStrength: 1.6,
    pipeline: {
      noises: [
        { name: "plates", type: "worley", tileCycles: 12, amplitude: 1, mode: "edge", warp: 0.35, sizeJitter: 0.45, round: 0.2 },
        { name: "cracks", type: "worley", tileCycles: 40, amplitude: 1, mode: "edge", warp: 0.5, sizeJitter: 0.5, round: 0.1 },
        { name: "swell", type: "fbm", octaves: 3, tileCycles: 4, amplitude: 1, persistence: 0.5, lacunarity: 2.0 },
        { name: "grit", type: "fbm", octaves: 2, tileCycles: 90, amplitude: 1, persistence: 0.5, lacunarity: 2.0 },
      ],
      steps: [
        // The ridge along each plate's edge, a groove right down its middle where the seam is.
        { output: "plateEdge", op: "sample", noise: "plates" },
        { output: "ridge", op: "mask", input: "plateEdge", at: 0.02, off: 0.09 },
        { output: "seam", op: "mask", input: "plateEdge", at: 0.0, off: 0.015 },
        // Fine cracks across the plates.
        { output: "crackEdge", op: "sample", noise: "cracks" },
        { output: "crack", op: "mask", input: "crackEdge", at: 0.0, off: 0.02 },
        { output: "swellRaw", op: "sample", noise: "swell" },
        { output: "swell", op: "mask", input: "swellRaw", at: 1, off: -1 },
        { output: "gritRaw", op: "sample", noise: "grit" },
        { output: "grit", op: "mask", input: "gritRaw", at: 1.3, off: -1.3 },

        { output: "plateBase", op: "scale", input: "swell", factor: 0.15 },
        { output: "plateLift", op: "offset", input: "plateBase", amount: 0.3 },
        { output: "ridgeUp", op: "scale", input: "ridge", factor: 0.55 },
        { output: "gritUp", op: "scale", input: "grit", factor: 0.08 },
        { output: "raised", op: "add", a: "plateLift", b: "ridgeUp" },
        { output: "rough", op: "add", a: "raised", b: "gritUp" },
        { output: "seamCut", op: "scale", input: "seam", factor: 0.5 },
        { output: "crackCut", op: "scale", input: "crack", factor: 0.06 },
        { output: "seamed", op: "subtract", a: "rough", b: "seamCut" },
        { output: "cut", op: "subtract", a: "seamed", b: "crackCut" },
        { output: "height", op: "clamp", input: "cut", min: 0, max: 1 },

        {
          output: "byHeight",
          op: "colorRamp",
          input: "height",
          stops: [
            { at: 0.0, color: [0.42, 0.38, 0.33] },
            { at: 0.15, color: [0.64, 0.63, 0.6] },
            { at: 0.3, color: [0.72, 0.71, 0.68] },
            { at: 0.55, color: [0.77, 0.77, 0.75] },
            { at: 0.8, color: [0.83, 0.83, 0.81] },
          ],
        },
        { output: "roughness", op: "remap", input: "height", inMin: 0, inMax: 1, outMin: 0.85, outMax: 0.6 },
      ],
      outputs: { diffuse: "byHeight", roughness: "roughness", height: "height" },
    },
  },
}
