// Sphagnum: a bog's peat moss - a soft, wet carpet of tiny star-headed moss, in a patchwork of rust
// red, ochre and dull green, the red climbing the drier hummocks, the green filling the wet hollows
// between, dark peat showing in the gaps. Tight lumpy cushions rather than a flat sward.
{
  name: "Sphagnum",
  detail: { strength: 0.45 },
  texture: {
    bumpStrength: 1.4,
    pipeline: {
      noises: [
        { name: "cushions", type: "worley", tileCycles: 22, amplitude: 1, mode: "f1", warp: 0.35, sizeJitter: 0.5 },
        { name: "heads", type: "worley", tileCycles: 320, amplitude: 1, mode: "edge", warp: 0.3, sizeJitter: 0.4 },
        { name: "patch", type: "fbm", octaves: 4, tileCycles: 5, amplitude: 1, persistence: 0.55, lacunarity: 2.0 },
        { name: "tone", type: "fbm", octaves: 3, tileCycles: 26, amplitude: 1, persistence: 0.5, lacunarity: 2.0 },
      ],
      steps: [
        { output: "cushionDistance", op: "sample", noise: "cushions" },
        { output: "cushion", op: "mask", input: "cushionDistance", at: 0.05, off: 0.55 },
        { output: "headEdge", op: "sample", noise: "heads" },
        { output: "head", op: "mask", input: "headEdge", at: 0.15, off: 0.03 },
        { output: "patchRaw", op: "sample", noise: "patch" },
        { output: "patch", op: "mask", input: "patchRaw", at: 0.6, off: -0.6 },
        { output: "toneRaw", op: "sample", noise: "tone" },
        { output: "tone", op: "mask", input: "toneRaw", at: 1.2, off: -1.2 },

        // Red on the cushions' tops and in the red patches, green in the hollows between.
        { output: "redOrGreen", op: "multiply", a: "patch", b: "cushion" },
        {
          output: "moss",
          op: "colorRamp",
          input: "redOrGreen",
          stops: [
            { at: 0.0, color: [0.27, 0.29, 0.14] },
            { at: 0.35, color: [0.4, 0.33, 0.17] },
            { at: 0.7, color: [0.42, 0.22, 0.13] },
            { at: 1.0, color: [0.44, 0.17, 0.13] },
          ],
        },
        { output: "toneShade", op: "remap", input: "tone", inMin: 0, inMax: 1, outMin: 0.82, outMax: 1.1 },
        { output: "mossLit", op: "multiply", a: "moss", b: "toneShade" },
        { output: "peat", op: "color", value: [0.08, 0.06, 0.04] },
        { output: "headMoss", op: "mix", a: "peat", b: "mossLit", t: "head" },
        // The gaps fill in towards the cushions' tops.
        { output: "fill", op: "mask", input: "cushion", at: 0.6, off: 0.1 },
        { output: "diffuse", op: "mix", a: "headMoss", b: "mossLit", t: "fill" },
        { output: "roughness", op: "constant", value: 0.75 },

        { output: "cushionHeight", op: "scale", input: "cushion", factor: 0.75 },
        { output: "headHeight", op: "scale", input: "head", factor: 0.25 },
        { output: "height", op: "add", a: "cushionHeight", b: "headHeight" },
      ],
      outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
    },
  },
  grass: [
    { kind: "tuft", density: 0.25, color: [0.6, 0.52, 0.32] },
    // Cotton grass, in drifts (its own `cluster`).
    { kind: "cottonGrass", density: 1.2, color: [0.5, 0.5, 0.3] },
  ],
}
