// A pine: a tall, tapering trunk with a natural bend - swept out a little at the foot, leaning,
// swaying slowly on the way up - and a crown of stacked open cones, widest at the bottom, each a
// ring of branches that leave the trunk near level and bend over towards their tips. Bare trunk below the lowest tier, the
// leader poking out above the top one.
{
  model: "conifer",
  variants: 4,
  // Some grow old - two or three times this size (see defaults.json5's oldTrees).
  growsOld: true,
  trunk: {
    height: 24,
    radius: 0.75,
    topRadius: 0.1,
    lean: 0.03,
    bend: 0.9,
    wobble: 0.35,
    flare: 1.5,
    flareHeight: 1.8,
    sides: 7,
    rings: 9,
  },
  roots: { count: 4, length: [1.6, 2.6], radius: 0.4, drop: 0.7, sides: 4, rings: 2 },
  tiers: {
    count: [11, 13],
    from: 0.2,
    radius: [6.5, 1.1],
    height: [4.8, 2.4],
    droop: 0.6,
    panels: 9,
    breadth: 1.0,
    arch: 0.5,
    tilt: 0.08,
    // Each branch its own length (+-35%), bend (+-70%), drop and width.
    variety: 0.35,
  },
  // Pine bark: thick reddish plates, taller than wide, split by deep dark fissures, their faces
  // flaking into thinner scales.
  bark: {
    tile: 1.15,
    texture: {
      bumpStrength: 3,
      pipeline: {
        noises: [
          { name: "plates", type: "worley", tileCycles: 9, stretch: [1, 3.2], amplitude: 1, mode: "edge" },
          { name: "scales", type: "worley", tileCycles: 22, stretch: [1, 1.6], amplitude: 1, mode: "edge" },
          { name: "bend", type: "fbm", octaves: 3, tileCycles: 4, amplitude: 1, persistence: 0.5, lacunarity: 2 },
          { name: "mottle", type: "fbm", octaves: 3, tileCycles: 9, amplitude: 1, persistence: 0.5, lacunarity: 2 },
        ],
        steps: [
          { output: "bendRaw", op: "sample", noise: "bend" },
          { output: "bendPx", op: "scale", input: "bendRaw", factor: 18 },
          { output: "still", op: "constant", value: 0 },
          { output: "plateEdge", op: "sample", noise: "plates", offset: ["bendPx", "still"] },
          { output: "plateId", op: "sample", noise: "plates", mode: "cell", offset: ["bendPx", "still"] },
          // 0 in a fissure, rising to a flat-topped plate.
          { output: "plate", op: "mask", input: "plateEdge", at: 0.08, off: 0.01 },
          { output: "scaleEdge", op: "sample", noise: "scales", offset: ["bendPx", "still"] },
          { output: "scaleCut", op: "mask", input: "scaleEdge", at: 0.0, off: 0.06 },
          { output: "scaleDepth", op: "scale", input: "scaleCut", factor: 0.25 },
          { output: "plateScaled", op: "subtract", a: "plate", b: "scaleDepth" },
          { output: "height", op: "clamp", input: "plateScaled", min: 0, max: 1 },

          { output: "mottleRaw", op: "sample", noise: "mottle" },
          { output: "mottle", op: "mask", input: "mottleRaw", at: 1.6, off: -1.6 },
          // Each plate its own shade of red-brown, the fissures near black.
          {
            output: "plateTone",
            op: "colorRamp",
            input: "plateId",
            stops: [
              { at: 0.0, color: [0.4, 0.22, 0.13] },
              { at: 0.4, color: [0.5, 0.3, 0.18] },
              { at: 0.7, color: [0.36, 0.24, 0.17] },
              { at: 1.0, color: [0.46, 0.27, 0.15] },
            ],
          },
          { output: "mottleShade", op: "remap", input: "mottle", inMin: 0, inMax: 1, outMin: 0.8, outMax: 1.12 },
          { output: "plateLit", op: "multiply", a: "plateTone", b: "mottleShade" },
          { output: "fissure", op: "color", value: [0.07, 0.05, 0.04] },
          { output: "diffuse", op: "mix", a: "fissure", b: "plateLit", t: "height" },
          { output: "roughness", op: "constant", value: 0.85 },
        ],
        outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
      },
    },
  },
  foliage: {
    builder: "firSpray",
    dark: [0.05, 0.15, 0.08],
    light: [0.28, 0.46, 0.19],
    twig: [0.25, 0.18, 0.12],
    twigs: 17,
    needleLength: 0.06,
    needleWidth: 0.009,
    needleGap: 0.007,
  },
  // Each tree's needles are multiplied by a random mix of these, so a stand is not one flat green.
  tint: [[0.8, 0.9, 0.85], [1.1, 1.08, 0.98]],
  scale: [0.7, 1.4],
}
