// A young tree fern: the tree fern (treeFern.json5) on half its trunk - its great crown of fronds
// low enough to arch out over the path, not far above your head.
{
  model: "branching",
  variants: 4,
  trunk: {
    height: 6,
    radius: 0.5,
    topRadius: 0.4,
    lean: 0.08,
    wobble: 0.6,
    flare: 1.6,
    flareHeight: 1.6,
    sides: 7,
    rings: 6,
  },
  roots: { count: 0, length: [1, 1], radius: 0.3, drop: 0.3, sides: 4, rings: 2 },
  // No branches: the crown is all fronds.
  branches: {
    count: [0, 0],
    from: 0.9,
    length: [1, 1],
    radius: 0.5,
    angle: [30, 30],
    arc: 0,
    sides: 4,
    rings: 2,
    twigs: { count: [0, 0], length: [0.3, 0.3], angle: [45, 45], sides: 3, rings: 2 },
  },
  // Upright in the middle to hanging at the rim, curling over towards the tips.
  crown: {
    count: [14, 20],
    length: [5.6, 7.6],
    width: 2.2,
    angle: [20, 95],
    curl: 70,
    fold: 0.1,
    segments: 6,
  },
  // Fibrous and dark: a mat of brown fibres over a diamond lattice of old frond scars.
  bark: {
    tile: 1.6,
    texture: {
      bumpStrength: 2.4,
      pipeline: {
        noises: [
          { name: "scars", type: "worley", tileCycles: 5, stretch: [1, 1.4], amplitude: 1, mode: "edge", warp: 0.15, sizeJitter: 0.2 },
          { name: "fibres", type: "fbm", octaves: 3, tileCycles: 30, stretch: [1, 6], amplitude: 1, persistence: 0.5, lacunarity: 2 },
          { name: "mottle", type: "fbm", octaves: 3, tileCycles: 4, amplitude: 1, persistence: 0.5, lacunarity: 2 },
        ],
        steps: [
          { output: "scarEdge", op: "sample", noise: "scars" },
          { output: "scar", op: "mask", input: "scarEdge", at: 0.1, off: 0.02 },
          { output: "fibreRaw", op: "sample", noise: "fibres" },
          { output: "fibre", op: "mask", input: "fibreRaw", at: 1.2, off: -1.2 },
          { output: "mottleRaw", op: "sample", noise: "mottle" },
          { output: "mottle", op: "mask", input: "mottleRaw", at: 1.5, off: -1.5 },
          { output: "scarHeight", op: "scale", input: "scar", factor: 0.6 },
          { output: "fibreHeight", op: "scale", input: "fibre", factor: 0.4 },
          { output: "height", op: "add", a: "scarHeight", b: "fibreHeight" },
          {
            output: "tone",
            op: "colorRamp",
            input: "fibre",
            stops: [
              { at: 0.0, color: [0.2, 0.14, 0.09] },
              { at: 0.5, color: [0.36, 0.26, 0.17] },
              { at: 1.0, color: [0.48, 0.36, 0.24] },
            ],
          },
          { output: "mottleShade", op: "remap", input: "mottle", inMin: 0, inMax: 1, outMin: 0.8, outMax: 1.15 },
          { output: "lit", op: "multiply", a: "tone", b: "mottleShade" },
          { output: "groove", op: "color", value: [0.12, 0.08, 0.05] },
          { output: "diffuse", op: "mix", a: "groove", b: "lit", t: "scar" },
          { output: "roughness", op: "constant", value: 0.95 },
        ],
        outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
      },
    },
  },
  // The fern's atlas, in a deep, glossy jungle green.
  foliage: {
    builder: "fern",
    dark: [0.06, 0.2, 0.05],
    light: [0.32, 0.55, 0.14],
    stem: [0.2, 0.2, 0.08],
    stems: [1, 1],
    leaves: 18,
    leafLength: 0.4,
    leafWidth: 0.045,
    bare: 0,
  },
  tint: [[0.85, 0.92, 0.85], [1.1, 1.06, 0.98]],
  scale: [0.7, 1.4],
}
