// A mine (SLICE.md E6, third lair): the cave style's parts cut square in worked rock - lanterns and torches burning, barrels, crates and sacks left at the light spots, most against a wall. Same parts, same builder. Its timbering, track, carts, work faces and windlass are 'light.dressing', laid along its ways (DUNGEONS.md, *The mine*).
// Was: a natural cave: chambers and winding tunnels in the rock, shaped as a whole in a distance field
// (DUNGEONS.md, *The cave*), roughened by noise and meshed; its joins blend by themselves.
{
  name: "Mine",
  builder: "field",
  // Cut, not grown: its tunnels and chambers squared off - upright walls, flat roofs, rounded corners -
  // and their swells and bulges calmed by as much (caveField.ts, FieldVary.square).
  hewn: 0.8,
  // The rock's roughness, as a cave's but a third of it: worked faces, the pick's marks in them.
  noise: [
    { scale: 0.11, amount: 0.3 },
    { scale: 0.28, amount: 0.2 },
    { scale: 0.7, amount: 0.12 },
  ],
  // The cell it is sampled and meshed at: coarse - rock reads as rock without small facets.
  voxel: 1.25,
  sizes: {
    lair: { rooms: [2, 3], entry: "seamless" },
    dungeon: { rooms: [8, 12], entry: "seamless" },
  },
  branching: 0.4,
  boss: { tags: ["boss"] },
  cover: 8,
  deepest: 50,
  parts: { tags: ["cave"] },
  entrance: { tags: ["entrance"] },
  caps: { tags: ["cap"] },
  // What its rock is (DUNGEONS.md, *Materials*): worn stone and settled silt underfoot, bedded limestone up
  // the walls, flowstone overhead - each laid this many metres a repeat.
  rock: {
    floor: { material: "caveFloor", size: 16 },
    wall: { material: "caveRock", size: 12 },
    ceiling: { material: "flowstone", size: 10 },
    // In the floor's dips, the gravel and silt washed down into them - by how deep a dip is.
    low: { material: "caveGravel", size: 8 },
  },
  // How it is lit (DUNGEONS.md, *Light*): at every one of its parts' light spots (a tunnel's one, a
  // chamber's two to five), crystals grown at the foot of a wall, or a campfire or torch left by
  // whoever lives here; and a dim cold light everywhere, so its rock is always seen.
  light: {
    ambient: [0.26, 0.27, 0.31],
    fixture: "wallTorch",
    lit: 1,
    // Most of what stands on the floor stands against a wall, facing in ('foot'); a few in the middle
    // of a way ('floor'). Never on the track: such a one goes to a wall's foot clear of it.
    fixtures: [
      { prop: "lantern", weight: 1.5, place: "foot" },
      { prop: "wallTorch", weight: 2, place: "wall" },
      { prop: "barrel", weight: 1.2, place: "foot" },
      { prop: "barrel", weight: 0.3, place: "floor" },
      { prop: "crate", weight: 1.2, place: "foot" },
      { prop: "crate", weight: 0.3, place: "floor" },
      { prop: "sack", weight: 0.8, place: "foot" },
      { prop: "sack", weight: 0.2, place: "floor" },
    ],
    // What makes it a mine, laid by its ways (caveFixtures.ts, *dress*): a timber set across every
    // tunnel every 6 m, cut to its width and roof, its cap's boards reaching the next set's, a lantern
    // hung from two in five of them, lagging behind the posts in half the bays; track through half its
    // ways, in whole runs - from the entrance down its main line, then branches - down their tunnels,
    // through their chambers to a turnplate in the middle and on to the work face, a cart parked at the
    // buffer stop there; at each
    // face - a chamber's wall furthest from its ways in, a dead end's end - the vein being worked, the
    // tools by it and the ore broken from it; shoring up a chamber's walls; now and then a windlass over
    // a winze sunk in a chamber's floor.
    dressing: {
      sets: { prop: "timberSet", every: 6, lantern: "hangingLantern", lanterns: 0.4 },
      lagging: { prop: "wallShoring", chance: 0.5 },
      shoring: { prop: "wallShoring", count: [1, 2] },
      track: { prop: "railTrack", turnplate: "turnplate", carts: ["oreCart", "oreCart", "mineCart"], cart: 0.8, share: 0.5 },
      face: [
        { prop: "oreVein", at: "face" },
        { prop: "pickLeaning", at: "beside", chance: 0.85 },
        { prop: "orePile", at: "foot", chance: 0.9 },
        { prop: "pickInRock", at: "near", chance: 0.4 },
        { prop: "oreSack", at: "near", chance: 0.6 },
        { prop: "oreSack", at: "near", chance: 0.4 },
      ],
      extras: [{ prop: "windlass", chance: 0.3 }],
    },
  },
  creatures: {
    groups: [
      { id: "spiders", kinds: ["spider"] },
      { id: "robbers", kinds: ["bandit"], weight: 2 },
    ],
    pick: 2,
    deeper: 8,
    boss: 2,
  },
}
