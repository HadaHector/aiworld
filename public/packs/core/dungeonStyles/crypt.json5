// A crypt: corridors, burial halls and tombs under a churchyard, stairs and spirals down between
// them, built from kit parts (DUNGEONS.md).
{
  name: "Crypt",
  builder: "kit",
  sizes: {
    lair: { rooms: [2, 4], entry: "seamless" },
    dungeon: { rooms: [8, 14], entry: "space" },
  },
  // The chance a part's further ways on are grown rather than walled up.
  branching: 0.4,
  // Loops made per layout: two loose ends far apart along the way, joined by corridors, corners
  // and a stair sized to fit - so the way circles back and is easy to get lost in.
  loops: [1, 3],
  connector: { socket: "crypt", corner: { tags: ["corner"] }, width: 6, height: 6, wall: 1, rise: 0.25, tread: 0.75 },
  boss: { tags: ["boss"] },
  keys: { locks: [0, 1] },
  // Rock over the top of every part but the entrance, and how far under the entrance it may go.
  cover: 8,
  deepest: 60,
  parts: { tags: ["crypt"] },
  entrance: { tags: ["entrance"] },
  caps: { tags: ["cap"] },
  // What its faces are made of (DUNGEONS.md, *Materials*): flagstones underfoot, coursed stone up
  // the walls, a rubble vault overhead gone dark with soot, dressed stone for the stairs.
  look: {
    floor: { material: "flagstones" },
    wall: { material: "stoneBricks", tint: [0.82, 0.78, 0.72] },
    ceiling: { material: "rubbleStone", tint: [0.55, 0.52, 0.5] },
    steps: { material: "dressedStone", tint: [0.72, 0.7, 0.66] },
    // A step's own top and front, their nosing bevelled, laid by the step.
    tread: { material: "stairTread" },
    riser: { material: "stairRiser" },
    frame: { material: "doorStone" },
    door: { material: "doorBoards", tint: [0.7, 0.62, 0.52] },
    trim: { material: "doorStone", tint: [0.9, 0.88, 0.84] },
    // The loculi - their frames, slabs and insides: a pale render, so they read against the stone.
    niche: { material: "plaster", tint: [0.78, 0.73, 0.65] },
    // A tomb: its base, chest and lid each cut from one stone - no joints.
    tomb: { material: "dressedStone", tint: [0.86, 0.83, 0.78] },
  },
  // Bands along the walls (DUNGEONS.md, *Trims*): a plinth a course high at their feet, a cornice
  // standing well out at their heads, where the vault springs.
  // Ribs across the flat vaults about every 7 m, each on a pilaster where it meets a wall.
  trims: {
    plinth: { height: 0.75, proud: 0.15 },
    cornice: { height: 0.75, proud: 0.3 },
    ribs: { spacing: 7, width: 0.9, depth: 0.5, pilaster: { width: 0.9, proud: 0.35 } },
    // A stone on every railing, a hand wider than it each side.
    coping: { height: 0.3, overhang: 0.15 },
    // Burial niches low on the walls, twice life size: three rows (four on a hall's tall walls), some
    // sealed with a slab, each framed in dressed stone - the frames meeting, a block of niches
    // standing on the plinth.
    loculi: {
      width: 2.4, height: 0.9, depth: 0.8, gap: 0.44, rowGap: 0.44, above: 0.98, rows: 3, tallRows: 4, tallWall: 9, margin: 0.5, sealed: 0.4,
      frame: { width: 0.22, proud: 0.14, bevel: 0.1 },
    },
    // In the rooms, an arcosolium or two: a round-arched niche 4 m wide on the plinth, a tomb chest
    // lying in it - the centrepiece of an end wall or an alcove.
    // Breaches: where blocks have fallen out of a wall - a hollow half a metre deep stepped course
    // by course, the rubble core showing, a heap of rubble at its foot. In about one wall in six,
    // two a part at most.
    // And where the vault has come down: in two flat vaults in five, a hole stepped up into
    // it, the heap of what fell on the floor under it.
    breaches: { share: 0.16, count: 2, width: [2.2, 3.6], height: [1.6, 2.8], depth: 0.5, above: 1.0, margin: 0.8, heap: 0.6, vaults: { share: 0.4, size: [2.4, 3.6], heap: 0.9 } },
    arcosolia: {
      width: 4, rise: 1.6, depth: 0.8, above: 0.75, margin: 0.5, count: 2,
      frame: { width: 0.35, proud: 0.18, bevel: 0.14 },
      tomb: { height: 1.0, inset: 0.35, lid: 0.18, lidOut: 0.12 },
    },
  },
  // Set across every join and cap, and at the mouth (DUNGEONS.md, *Doorways*).
  doorways: { tags: ["doorway"] },
  // How it is lit (DUNGEONS.md, *Light*): torches at most of the parts' light spots, and a little
  // cold light everywhere so an unlit corner is a dark shape, not a hole.
  // Candles left burning on the benches, on the ledger stones and at the tombs' heads: this share
  // of those places has some (fewer on the ledger stones).
  light: { ambient: [0.022, 0.024, 0.03], fixture: "wallTorch", lit: 0.8, candles: { prop: "candles", share: 0.4 } },
  // Urns in the open loculi (the ashes of those not laid whole) and on the benches between the candles.
  urns: { prop: "urn", share: 0.35 },
}
