      radius: 12,
      colors: [
        [0.96, 0.95, 0.9], // white
        [0.98, 0.84, 0.22], // yellow
        [0.62, 0.42, 0.88], // violet
        [0.92, 0.42, 0.55], // pink
      ],
    },
  },
}
