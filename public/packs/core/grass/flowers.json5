// Wild flowers: a few thin stems, most of them topped with a five-petalled head, in patches.
{
  width: 1.0,
  height: 0.95,
  sway: 0.22,
  fadeStart: 70,
  fadeEnd: 300,
  cluster: { scale: 9, coverage: 0.35 },
  blades: {
    count: 12,
    minHeight: 0.5,
    maxHeight: 0.92,
    baseWidth: 2.5,
