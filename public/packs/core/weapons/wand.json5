    // A rod banded in gilt, holding a gem in a gilt cup at its tip.
    ornate: {
      parts: [
        { shape: "round", slot: "wood", from: -0.08, to: 0.32, profile: [[0, 0.036, 0.036], [0.25, 0.031, 0.031], [1, 0.025, 0.025]] },
