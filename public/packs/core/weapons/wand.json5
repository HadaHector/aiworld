// The wand family (see weapons/sword.json5 for how parts are given): a short rod held at its foot.
// The item's tint colours the wood (oak, ash, yew...), the metal fittings keep their own colour:
// "wand.crude", "wand.standard", "wand.ornate".
{
  name: "Wand",
  grip: "mainHand",
  tinted: "wood",
  // An attack is a bolt loosed from it.
  animations: { swing: "castForward" },
  tiers: {
    // A twig, tapering, with a stub of a side shoot.
    crude: {
      parts: [
        { shape: "round", slot: "wood", from: -0.09, to: 0.33, profile: [[0, 0.032, 0.032], [0.4, 0.028, 0.028], [1, 0.012, 0.012]] },
        { shape: "round", slot: "wood", from: 0.14, to: 0.22, tilt: 28, profile: [[0, 0.016, 0.016], [1, 0.006, 0.006]] },
        { shape: "round", slot: "wood", from: -0.1, to: -0.08, profile: [[0, 0.02, 0.02], [1, 0.034, 0.034]] },
      ],
    },
    // A turned rod with a knob at its foot and a metal ferrule at its tip.
