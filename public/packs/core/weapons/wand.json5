        { shape: "round", from: 0.32, to: 0.37, profile: [[0, 0.03, 0.03], [0.6, 0.034, 0.034], [1, 0.02, 0.02]] },
        { shape: "round", from: 0.37, to: 0.39, profile: [[0, 0.02, 0.02], [1, 0, 0]] },
