        { shape: "round", slot: "trim", from: 0.088, to: 0.105, out: 0.19, copies: 8, profile: [[0, 0.035, 0.035], [1, 0, 0]] },
        { shape: "round", slot: "trim", from: 0.105, to: 0.165, profile: [[0, 0.17, 0.17], [0.6, 0.14, 0.14], [1, 0.07, 0.07]] },
        { shape: "round", from: 0.16, to: 0.27, profile: [[0, 0.065, 0.065], [1, 0, 0]] },
