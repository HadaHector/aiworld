// A termite mound: a lumpy spire of baked red earth standing up out of the savanna grass, taller than
// a man and narrowing to a blunt point. On the rocks' lattice like a boulder, so a biome scatters
// them with its `rocks` graph.
{
  model: "boulder",
  variants: 6,
  radius: 1.3,
  // Twice or three times as tall as it is wide, and not much longer one way than the other.
  squash: [1.8, 2.9],
  stretch: [1.0, 1.3],
  // Lumpy all over, and narrowing hard to its top: a spire, not an egg.
  lumps: 0.3,
  taper: 0.72,
  facets: [0, 1],
  facetDepth: 0.15,
  tilt: 7,
  sink: 0.08,
  // Baked earth: red-brown clods and grit, paler and dustier on the high spots.
  stone: {
    tile: 3,
    texture: {
      bumpStrength: 2.2,
      pipeline: {
        noises: [
          { name: "clods", type: "worley", tileCycles: 10, amplitude: 1, mode: "edge", warp: 0.4, sizeJitter: 0.4, round: 0.2 },
          { name: "lumps", type: "fbm", octaves: 4, tileCycles: 5, amplitude: 1, persistence: 0.55, lacunarity: 2 },
          { name: "grit", type: "fbm", octaves: 2, tileCycles: 90, amplitude: 1, persistence: 0.5, lacunarity: 2 },
        ],
        steps: [
          { output: "clodEdge", op: "sample", noise: "clods" },
          { output: "clod", op: "mask", input: "clodEdge", at: 0.35, off: 0 },
          { output: "lumpRaw", op: "sample", noise: "lumps" },
          { output: "lump", op: "mask", input: "lumpRaw", at: 1.2, off: -1.2 },
          { output: "gritRaw", op: "sample", noise: "grit" },
          { output: "grit", op: "mask", input: "gritRaw", at: 1.2, off: -1.2 },
          { output: "clodHeight", op: "scale", input: "clod", factor: 0.2 },
          { output: "lumpHeight", op: "scale", input: "lump", factor: 0.65 },
          { output: "gritHeight", op: "scale", input: "grit", factor: 0.15 },
          { output: "bodyHeight", op: "add", a: "clodHeight", b: "lumpHeight" },
          { output: "height", op: "add", a: "bodyHeight", b: "gritHeight" },
          {
            output: "diffuse",
            op: "colorRamp",
            input: "height",
            stops: [
              { at: 0.0, color: [0.22, 0.14, 0.1] },
              { at: 0.4, color: [0.42, 0.28, 0.19] },
              { at: 0.75, color: [0.54, 0.38, 0.27] },
              { at: 1.0, color: [0.66, 0.53, 0.41] },
            ],
          },
          { output: "roughness", op: "constant", value: 0.95 },
        ],
        outputs: { diffuse: "diffuse", roughness: "roughness", height: "height" },
      },
    },
  },
  tint: [[0.82, 0.8, 0.78], [1.12, 1.08, 1.02]],
  scale: [0.6, 1.4],
}
