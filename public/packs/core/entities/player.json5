// A player on a server without progression (the ability and item probes): a character with the
// whole test kit. With progression, players are made from their origins over `character` instead.
{
  extends: "character",
  resources: ["health", "mana", "rage"],
  // The test kit (see ABILITIES.md, *The test*): keys 1-9 cast the active ones in this order.
  spells: [
    { skill: "autoAttack" },
    { skill: "heroicStrike" },
    { skill: "fireball" },
    { skill: "renew" },
    { skill: "shield" },
    { skill: "charge" },
    { skill: "thunderClap" },
    { skill: "kick" },
    { skill: "searingTotem" },
  ],
}
