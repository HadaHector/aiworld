// Stands near the start for testing stats, modifiers and resources (see ENTITIES.md) and abilities
// (ABILITIES.md): hostile, keeps a threat table, never dies. It no longer casts its bolt (the
// `dummyCaster` habit, kept for the probes' test fights, which give it back).
{
  extends: "creature",
  name: "Training Dummy",
  // Worth nothing: no XP of any kind comes from it (PROGRESSION.md, *XP sources*) - not for beating
  // it, hitting it, or casting at it.
  stats: { level: 10, stamina: 500, armor: 300, xpValue: 0 },
  resources: ["health", "rage"],
  modifiers: [{ stat: "maxHealth", kind: "percent", value: 100 }],
  hostility: "hostile",
  threat: true,
  mortal: false,
  // Rolled each time it reaches 0 health (see ITEMS.md, Loot).
  items: { loot: "trainingDummy" },
  look: { race: "human", outfit: "knight", height: 1.9, radius: 0.45, color: [0.75, 0.6, 0.35], feedback: { armor: "metal", family: "humanoid" } },
}
