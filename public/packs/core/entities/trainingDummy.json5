// Stands near the start for testing stats, modifiers and resources (see ENTITIES.md) and abilities
// (ABILITIES.md): hostile, keeps a threat table, never dies, and casts a bolt now and then.
{
  extends: "creature",
  name: "Training Dummy",
  // Worth a fifth of a creature of its level, each time it is beaten (PROGRESSION.md, *XP sources*).
  stats: { level: 10, stamina: 500, armor: 300, xpValue: 0.2 },
  resources: ["health", "rage"],
  modifiers: [{ stat: "maxHealth", kind: "percent", value: 100 }],
  spells: [{ skill: "dummyCaster" }],
  hostility: "hostile",
  threat: true,
  mortal: false,
  // Rolled each time it reaches 0 health (see ITEMS.md, Loot).
  items: { loot: "trainingDummy" },
  look: { race: "human", outfit: "knight", height: 1.9, radius: 0.45, color: [0.75, 0.6, 0.35], feedback: { armor: "metal", family: "humanoid" } },
}
