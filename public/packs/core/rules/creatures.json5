// Creatures (see CREATURES.md): rosters, spawn points, the brain's numbers, and zone levels until
// world generation sets them.
{
  rosterSize: [3, 5],              // kinds per zone
  campsPerZone: [1, 2],            // camp kinds per zone, of those whose habitat fits
  spacing: 80,                     // metres between spawn points, jittered
  emptyChance: 0.15,
  campChance: 0.08,
  groups: { single: 1, pair: 0, group: 0 },  // alone, for now: no packs (pairs and groups later)
  maxSlope: 0.7,
  safeRadius: 60,                  // no points this near the dimension's spawn or a link
  activeRadius: 140,               // points this near a player are filled
  releaseRadius: 180,              // ...and dropped when nobody is this near
  releaseAfter: 30,
  corpse: { time: 120, emptied: 30 },
  leash: 60,
  social: 12,                      // group aggro reaches group-mates this near the one pulled: a camp spread wider than this is pulled in parts
  stuck: 4,
  opening: 1.5,                    // seconds into a pull before a tactic is first used (a tactic's `after` overrides it)
  control: { opening: 5, immunity: 6 },  // crowd control (a tactic with `control: true`): later opening, never twice in a row, this long left alone once a hold ends
  // Classic: about 20 m, a metre more per level the creature is above the player, 5-45 m.
  aggro: { clamp: [{ add: [20, { sub: ["caster.level", "target.level"] }] }, 5, 45] },
  evadeSkill: "evade",
  levels: { start: [1, 4], step: 3, width: 3, cap: 60, cellSpread: [0, 1] },  // cellSpread: over a cell's level (balance curve cellLevel), where a dimension sets levels by cell
}
