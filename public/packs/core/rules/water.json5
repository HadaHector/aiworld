// How bodies meet water and how it looks from under (WATER.md). Depths are metres from the surface
// down to the feet: knee-deep wades, chest-deep swims, head-deep is under.
{
  swimSpeed: 0.6,          // share of walking pace
  wadeDepth: 0.35,
  swimDepth: 1.2,
  headDepth: 1.7,
  floatDepth: 1.35,        // a swimmer floats with its feet this far under the surface
  verticalSpeed: 3.5,      // rising and diving
  look: {
    tint: [0.05, 0.26, 0.32], // what the world is seen through below the surface
    density: 0.045,          // fog: how murky
    surfaceTint: 0.6,        // how much of that tint the sky and light take on
  },
}
