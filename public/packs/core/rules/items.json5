// The item rules a game sets (see ITEMS.md): how gear wears and what repairing costs, how near
// things must be, and how long a dropped item lies.
{
  // Death takes a share of every worn item's maximum; a hit given or taken wears one point, sometimes.
  wear: { onDeath: 0.1, onHit: 1, onHitTaken: 1, hitChance: 0.2 },
  // Per item, in copper: of the durability missing, its maximum, its value and its item level. A full
  // repair costs rules/balance.json5's `repairShare` (5%) of the item's value; the items probe checks
  // the two agree.
  repair: { cost: { ceil: { mul: [{ div: ["missing", { max: [1, "max"] }] }, "value", 0.05] } } },
  bankRange: 4,
  pickUpRange: 3,
  lootRange: 4,
  groundLifetime: 300,
  maxGenerated: 2000,
}
