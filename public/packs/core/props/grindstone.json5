// A grindstone for the axes: a sandstone wheel in a frame of rails on four legs, turned by a crank,
// its foot running through a trough of water.
{
  name: "Grindstone",
  type: "grindstone",
  grindstone: {
    radius: [0.6, 0.78],
    thickness: [0.22, 0.32],
    height: [1.25, 1.4],
  },
  parts: {
    frame: { material: "timber", tints: [[0.75, 0.65, 0.55], [0.65, 0.57, 0.5]] },
    stone: { material: "dressedStone", tints: [[1.05, 0.95, 0.8], [0.95, 0.9, 0.82]] },
    trough: { material: "planks", tints: [[0.7, 0.62, 0.55]] },
    // The water in it: no material, a dark plain colour.
    water: { tints: [[0.16, 0.2, 0.22]] },
    iron: { tints: [[0.18, 0.18, 0.19]] },
  },
}
