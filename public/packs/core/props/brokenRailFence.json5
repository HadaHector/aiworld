// A split-rail fence years unmended: the rail fence with a good share of its rails fallen and its
// posts grey - round an abandoned camp.
{
  name: "Broken Rail Fence",
  type: "railFence",
  railFence: {
    height: [1.0, 1.3],
    spacing: [2.2, 3.0],
    rails: [2, 3],
    missing: 0.4,
  },
  parts: {
    posts: { material: "roundLog", tints: [[0.66, 0.66, 0.62], [0.58, 0.58, 0.55]] },
    rails: { material: "timber", tints: [[0.6, 0.58, 0.52], [0.52, 0.5, 0.46]] },
  },
}
