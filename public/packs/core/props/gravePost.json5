// A wooden grave post at a new grave's head: a squared upright, a board high on its face bearing the
// faith's emblem - the lamp's ring and its dot - now and then a little roof of two boards over it.
// Grey with weather, leaning. Stands plumb on the ground, sunk into it.
{
  name: "Grave post",
  type: "gravePost",
  gravePost: {
    height: [1.3, 1.7],
    board: [0.32, 0.42],
    roof: 0.4,
    emblems: ["ringDot"],
    lean: 8,
  },
  ground: "plumb",
  parts: {
    wood: { material: "timber", tints: [[0.72, 0.68, 0.62], [0.6, 0.57, 0.53], [0.8, 0.75, 0.68]] },
    roof: { material: "woodShingles", tints: [[0.8, 0.8, 0.8]] },
    // Painted once, pale, mostly weathered off.
    emblem: { tints: [[0.78, 0.74, 0.64], [0.7, 0.66, 0.58]] },
  },
}
