// A wayside sign: a post by the road with an arm out over it and a board hung from the arm - or,
// plainer, the board fixed to the post's head - painted with a panel and an emblem, and the name of
// the place it stands for, read by standing under it.
{
  name: "Wayside Sign",
  type: "signpost",
  signpost: {
    height: [3.0, 3.4],
    arm: [1.3, 1.6],
    width: [1.1, 1.3],
    board: [0.75, 0.9],
    hanging: 0.6,
  },
  // A player by it reads the name of its place (its inn).
  label: "place",
  parts: {
    post: { material: "timber", tints: [[0.62, 0.54, 0.46], [0.55, 0.48, 0.42]] },
    board: { material: "planks", tints: [[0.7, 0.6, 0.5]] },
    // The painted panel and its emblem: no material, the colours of a painted sign gone a little
    // dull with weather.
    face: { tints: [[0.45, 0.12, 0.1], [0.12, 0.22, 0.4], [0.16, 0.32, 0.18], [0.12, 0.12, 0.12]] },
    emblem: { tints: [[0.85, 0.68, 0.25], [0.88, 0.86, 0.8], [0.75, 0.2, 0.15]] },
    iron: { tints: [[0.18, 0.18, 0.19]] },
  },
}
