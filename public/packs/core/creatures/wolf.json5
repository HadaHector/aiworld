  entity: "beast",
  name: "{variant} Wolf",
  family: "beast",
  tags: ["furred", "mammal", "predator"],        // what it is like, for quests (QUESTS.md) to ask for
  hostility: "hostile",
  role: "brute", scale: { armour: 0.75 },
  stats: { strength: 8, agility: 12, weaponSpeed: 3 },
  perLevel: { strength: 1.5, agility: 1.5 },
  spells: [{ skill: "bite" }],
  tactics: [{ skill: "bite", every: [8, 12] }],
  speed: { walk: 0.25, run: 0.45 },
  group: { size: [2, 3], spread: 6 },
  habitat: { meadow: 2, bluebellWood: 3, autumnWood: 3, snowyTaiga: 3, frostSteppe: 2, heatherMoor: 2, alpineMeadow: 1, windsweptFell: 2, greenAlps: 1, savanna: 1 },
  respawn: [240, 360],
  loot: "wolf",
  look: { height: 1.0, radius: 0.5, color: [0.45, 0.42, 0.38], beast: "wolf", feedback: { weapon: "fang", armor: "fur", family: "wolf" } },
  variants: [
    { id: "timber", name: "Timber", habitat: ["meadow", "bluebellWood", "autumnWood", "heatherMoor", "alpineMeadow", "greenAlps"] },
    { id: "frost", name: "Frost", habitat: ["snowyTaiga", "frostSteppe", "windsweptFell"], look: { color: [0.85, 0.88, 0.92], beast: "wolf.frost" }, scale: { armour: 1.75 }, spells: [{ skill: "frostBite" }], tactics: [{ skill: "frostBite", every: [14, 18] }] },
    { id: "plains", name: "Plains", habitat: ["meadow", "savanna"], look: { color: [0.7, 0.58, 0.4], beast: "wolf.plains" }, never: ["thickHide"] },
  ],
  traits: { pick: [0, 1], pool: ["rabid", "thickHide", "swift", "old"] },
}
