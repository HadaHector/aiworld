// Turns in degrees, the same for both sides (see src/character/animationDef.ts): arms and legs x
// forward and z out from the body; forearm x bends the elbow, shin -x the knee; spine, chest and
// head x lean forward, y turn to the body's right. `drop` lowers the body by a share of its leg.
// Sitting on the ground: a crouch, then down onto the seat with the legs out in front, the knees a
// little bent, leaning back on the hands behind, the body breathing slowly - held until it is
// stopped. What /sit plays; on a chair or bench, "sitChair".
{
  name: "Sit",
  group: "everyday",
  layer: "full",
  loop: true,
  loopFrom: 1.0,
  keys: [
    { at: 0, drop: 0, both: { thigh: [0, 0, 0], shin: [0, 0, 0], foot: [0, 0, 0], upperArm: [6, 0, 3], forearm: [17, 0, 0], hand: [0, 0, 0] }, pose: { spine: [3, 0, 0], chest: [0, 0, 0], head: [0, 0, 0] } },
    // Down into a crouch, the arms forward for balance.
    { at: 0.45, drop: 0.55, both: { thigh: [95, 0, 10], shin: [-125, 0, 0], foot: [30, 0, 0], upperArm: [45, 0, 8], forearm: [20, 0, 0] }, pose: { spine: [25, 0, 0] } },
    // Onto the seat: the legs out, the hands back on the ground.
    { at: 1.0, ease: "out", drop: 0.99, both: { thigh: [86, 0, 9], shin: [-16, 0, 0], foot: [-22, 0, 0], upperArm: [-38, 0, 16], forearm: [6, 0, 0], hand: [-55, 0, 0] }, pose: { spine: [-16, 0, 0], chest: [-2, 0, 0], head: [10, 0, 0] } },
    { at: 2.5, drop: 0.99, pose: { chest: [-4, 0, 0], head: [8, 0, 0] } },
    { at: 4.0, drop: 0.99, pose: { chest: [-2, 0, 0], head: [10, 0, 0] } },
  ],
}
