// Turns in degrees, the same for both sides (see src/character/animationDef.ts): arms and legs x
// forward and z out from the body; forearm x bends the elbow, shin -x the knee; spine, chest and
// head x lean forward, y turn to the body's right. `drop` lowers the body by a share of its leg.
// Holding a staff: the right forearm forward, the fist thumb-up, so the staff stands upright beside
// the body, its foot near the ground - over whatever the legs are doing, held until it is stopped.
{
  name: "Hold staff",
  group: "everyday",
  loop: true,
  loopFrom: 0.3,
  keys: [
    { at: 0, pose: { upperArmR: [6, 0, 3], forearmR: [17, 0, 0], handR: [0, 0, 0] } },
    { at: 0.3, pose: { upperArmR: [12, 0, 10], forearmR: [78, 0, 0], handR: [28, 0, 0] } },
    { at: 2.0, pose: { upperArmR: [14, 0, 10], forearmR: [80, 0, 0], handR: [28, 0, 0] } },
    { at: 3.7, pose: { upperArmR: [12, 0, 10], forearmR: [78, 0, 0], handR: [28, 0, 0] } },
  ],
}
