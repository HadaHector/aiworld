// Turns in degrees, the same for both sides (see src/character/animationDef.ts): arms and legs x
// forward and z out from the body; forearm x bends the elbow, shin -x the knee; spine, chest and
// head x lean forward, y turn to the body's right. `drop` lowers the body by a share of its leg.
// A one-handed slash: the weapon drawn back and up on the right, cut down and across, carried
// through to the left, the chest turning into it. What auto-attack and most melee skills play.
{
  name: "Slash",
  group: "weapon",
  keys: [
    { at: 0, pose: { upperArmR: [6, 0, 3], forearmR: [17, 0, 0], chest: [0, 0, 0], spine: [3, 0, 0] } },
    { at: 0.22, ease: "out", pose: { upperArmR: [109, 23, 52], forearmR: [80, 0, 0], chest: [0, 26, 3], spine: [0, 11, 0] } },
    { at: 0.34, ease: "in", pose: { upperArmR: [69, -17, -20], forearmR: [14, 0, 0], chest: [7, -32, -3], spine: [9, -14, 0] } },
    { at: 0.46, pose: { upperArmR: [40, -23, -14], forearmR: [29, 0, 0], chest: [6, -23, 0], spine: [7, -11, 0] } },
    { at: 0.62, pose: { upperArmR: [6, 0, 3], forearmR: [17, 0, 0], chest: [0, 0, 0], spine: [3, 0, 0] } },
  ],
}
