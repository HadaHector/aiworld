  name: "Chop or mine",
  group: "everyday",
  layer: "full",
  loop: true,
  keys: [
    { at: 0, drop: 0.04, both: { upperArm: [48, 0, -21], forearm: [28, 0, 0], hand: [10, 0, 0], thigh: [10, 0, 6], shin: [-18, 0, 0] }, pose: { spine: [24, 0, 0], head: [10, 0, 0] } },
    { at: 0.5, ease: "out", drop: 0.02, both: { upperArm: [160, 0, -12], forearm: [62, 0, 0], hand: [-10, 0, 0] }, pose: { spine: [-6, 0, 0], head: [-4, 0, 0] } },
