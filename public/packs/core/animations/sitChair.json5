// Turns in degrees, the same for both sides (see src/character/animationDef.ts): arms and legs x
// forward and z out from the body; forearm x bends the elbow, shin -x the knee; spine, chest and
// head x lean forward, y turn to the body's right. `drop` lowers the body by a share of its leg.
// Sitting on a chair or a bench: down onto the seat, knees bent and apart, leaning forward a little
// with the arms hanging loose over the knees, the body breathing slowly - held until it is stopped.
// For furniture; on the ground, "sit".
{
  name: "Sit on a chair",
  group: "everyday",
  layer: "full",
  loop: true,
  loopFrom: 0.9,
  keys: [
    { at: 0, drop: 0, both: { thigh: [0, 0, 0], shin: [0, 0, 0], foot: [0, 0, 0], upperArm: [6, 0, 3], forearm: [17, 0, 0] }, pose: { spine: [3, 0, 0], chest: [0, 0, 0], head: [0, 0, 0] } },
    { at: 0.5, drop: 0.5, both: { thigh: [80, 0, 12], shin: [-110, 0, 0], foot: [20, 0, 0], upperArm: [25, 0, 12], forearm: [25, 0, 0] }, pose: { spine: [20, 0, 0] } },
    { at: 0.9, drop: 0.9, both: { thigh: [92, 0, 22], shin: [-112, 0, 0], foot: [15, 0, 0], upperArm: [34, 0, 16], forearm: [22, 0, 0], hand: [12, 0, 0] }, pose: { spine: [18, 0, 0], chest: [4, 0, 0], head: [-6, 0, 0] } },
    { at: 2.4, drop: 0.9, pose: { chest: [1, 0, 0], head: [-8, 0, 0] } },
