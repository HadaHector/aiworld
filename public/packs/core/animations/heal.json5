    { at: 0.5, ease: "out", both: { upperArm: [125, 0, 25], forearm: [12, 0, 0], hand: [-25, 0, 0] }, pose: { head: [-15, 0, 0], chest: [-6, 0, 0] } },
    { at: 0.75, both: { upperArm: [128, 0, 28] } },
