// Turns in degrees, the same for both sides (see src/character/animationDef.ts): arms and legs x
// forward and z out from the body; forearm x bends the elbow, shin -x the knee; spine, chest and
// head x lean forward, y turn to the body's right. `drop` lowers the body by a share of its leg.
// Talking: the hands making loose gestures in front of the body, the head nodding and turning a
// little - an NPC giving a quest - held until it is stopped.
{
  name: "Talk",
  group: "everyday",
  loop: true,
  loopFrom: 0.3,
  keys: [
    { at: 0, both: { upperArm: [6, 0, 3], forearm: [17, 0, 0], hand: [0, 0, 0] }, pose: { head: [0, 0, 0] } },
    { at: 0.3, pose: { upperArmR: [30, 0, 10], forearmR: [80, 0, 0], handR: [-10, 0, 0], upperArmL: [12, 0, 5], forearmL: [40, 0, 0], head: [3, 0, 0] } },
    { at: 0.9, pose: { upperArmR: [42, 0, 26], forearmR: [55, 0, 0], handR: [-25, 0, 0], head: [-2, 8, 0] } },
    { at: 1.5, pose: { upperArmR: [26, 0, 8], forearmR: [85, 0, 0], handR: [-5, 0, 0], upperArmL: [32, 0, 18], forearmL: [70, 0, 0], head: [5, -4, 0] } },
    { at: 2.1, pose: { upperArmR: [36, 0, 16], forearmR: [70, 0, 0], upperArmL: [14, 0, 6], forearmL: [45, 0, 0], head: [0, 2, 0] } },
    { at: 2.7, pose: { upperArmR: [30, 0, 10], forearmR: [80, 0, 0], handR: [-10, 0, 0], upperArmL: [12, 0, 5], forearmL: [40, 0, 0], head: [3, 0, 0] } },
  ],
