// A logging camp: a trodden yard in a thick wood, its buildings round it facing in, a road in from
// the nearest village and a skid trail out the other way into the felling. The first compound (see
// FEATURES.md) - a yard with buildings round it, no streets.
//
// Where it goes is decided by the ground: gentle, and deep in a wood. A cell with no such ground
// has no camp, whatever it rolled.
{
  name: "Logging camp",
  type: "compound",
  compound: {
    // Gentle enough ground (rise over run across the whole camp - the yard and the buildings' pads
    // are levelled into it), trees all round it - the share of the
    // ground they cover, at least the first, the more the better up to the second - and a river
    // within 300 m in its favour.
    site: { grade: [0, 0.2], cover: [0.5, 0.9], nearWater: 300 },
    // A round of trodden ground, its radius in metres, rolled per camp - wide enough for a long
    // bunkhouse and a saw shed to stand round it.
    yard: { radius: [18, 24] },
    // How the level ground - the yard, and the pads under the buildings and props - blends back to
    // the ground round it: its banks no steeper than `slope` (rise over run; lower, a wider,
    // gentler bank), and between `blend` metres wide at the least and the most.
    pads: { slope: 0.6, blend: [1.5, 10] },
    // Round the yard's rim, fronts to the yard, the entrances kept free.
    arrangement: "ring",
    // The skid trail the logs are dragged in along: out through the widest stretch of rim the
    // roads leave, so the felling lies away from the way in.
    trails: [{ to: "clearing", length: [40, 90], chance: 0.85 }],
    // Its buildings, each `count` of them (rolled), each with `chance`; a required one must fit.
    // A bunkhouse for the men and a saw shed always; a cookhouse, an ox stable and a tool shed by
    // chance.
    buildings: [
      { building: "bunkhouse", count: [1, 1], required: true },
      { building: "sawShed", count: [1, 1], required: true },
      { building: "cookhouse", count: [1, 1], chance: 0.6 },
      { building: "stable", count: [1, 1], chance: 0.5 },
      { building: "toolShed", count: [1, 1], chance: 0.6 },
    ],
    // Its props, set down where they fit, each kind in turn: in the yard, decks of logs waiting to
    // be hauled, logs dragged in and lying about, and the saw spot; log stacks round its edge; a
    // wood corner by the cookhouse (or any building), store piles by the buildings; and felled logs
    // along the skid trail.
    props: [
      { group: "logDeck", count: [1, 2], at: "yard" },
      { group: "sawSpot", count: [1, 1], at: "yard" },
      { prop: "felledLog", count: [1, 3], at: "yard" },
      { prop: "logStack", count: [1, 3], at: "yardEdge" },
      { group: "woodCorner", count: [1, 1], at: "byBuilding", building: "cookhouse", chance: 0.9 },
      { group: "storePile", count: [1, 2], at: "byBuilding" },
      { prop: "felledLog", count: [1, 4], at: "trail" },
    ],
  },
  // Trees and bushes cleared up to 50 m past the yard's edge - past its buildings, its circle
  // reaching some 40 - and growing back by 80.
  clearing: [50, 80],
  // Most of the trees it cleared - past its buildings - left as stumps: the timber it has worked.
  stumps: 0.85,
  // Its yard's ground: earth trodden hard - across the yard and out to its buildings' fronts (5 m
  // past its edge), fraying out by 10. Its lanes run into it and stop; past it they are the biome's
  // own road. Where wood is worked - round its sawbucks, chopping blocks and saw shed - sawdust and
  // chips lie over it (their `spill`).
  ground: {
    material: "track",
    weight: {
      noises: [{ name: "yardEdge", type: "fbm", octaves: 2, frequency: 0.08, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
      steps: [
        { output: "gapRaw", op: "input", name: "featureGap" },
        { output: "edgeRaw", op: "sample", noise: "yardEdge" },
        { output: "edge", op: "scale", input: "edgeRaw", factor: 2 },
        { output: "gap", op: "add", a: "gapRaw", b: "edge" },
        { output: "raw", op: "remap", input: "gap", inMin: 10, inMax: 5, outMin: 0, outMax: 1 },
        { output: "result", op: "clamp", input: "raw", min: 0, max: 1 },
      ],
    },
  },
  // Its place in the road network (see settlement.json5): about a hamlet's worth, one road at the
  // least and two at most, to a settlement by preference.
  road: { importance: 1, links: [1, 2], wants: ["settlement"], maxLength: 2500 },
}
