// A coaching inn: a waystation on the road between two towns, where carters and travellers stop for
// the night. The road runs straight through its yard - the inn on one side of it, the stable and a
// shed round the rest, a well in the yard and a trough by the stable - with no fence round it: the
// road goes on through. (FEATURES.md; the design panel's pitches.)
//
// Sited once the roads are laid (`roadside`): on a road, not a track, nearly straight across the
// yard, with no junction in it, on gentle ground, and well away from any settlement - an inn just
// outside a town is the town's own inn. A cell with no such road has no inn, whatever it rolled.
{
  name: "Coaching inn",
  type: "compound",
  compound: {
    // Gentle ground (rise over run across it), anywhere the road goes - wood or open - at least
    // 500 m past every settlement's edge, the further the better.
    site: { grade: [0, 0.1], cover: [0, 1], fromSettlements: 500 },
    // The yard the road crosses: room for the road through its middle and the yard either side.
    yard: { radius: [15, 19] },
    pads: { slope: 0.6, blend: [1.5, 10] },
    arrangement: "roadside",
    // The inn always, its front to the yard and the road through it; a stable most times; a shed now
    // and then.
    buildings: [
      { building: "inn", count: [1, 1], required: true },
      { building: "stable", count: [1, 1], chance: 0.8 },
      { building: "toolShed", count: [1, 1], chance: 0.5 },
    ],
    // A well in the yard, off the road; a trough, the fodder and the dung heap by the stable (or,
    // with none, by whatever there is); stores and a wood corner by the inn.
    props: [
      { prop: "well", count: [1, 1], at: "yard", chance: 0.9 },
      { prop: "trough", count: [1, 1], at: "byBuilding", building: "stable" },
      { group: "fodderPile", count: [1, 1], at: "byBuilding", building: "stable", chance: 0.8 },
      { prop: "dungHeap", count: [1, 1], at: "byBuilding", building: "stable", chance: 0.8 },
      { group: "storePile", count: [1, 2], at: "byBuilding", building: "inn" },
      { group: "woodCorner", count: [1, 1], at: "byBuilding", building: "inn", chance: 0.8 },
      { prop: "logStack", count: [0, 1], at: "yardEdge" },
      // A sign up the road each way, naming the inn to those coming.
      { prop: "waysign", count: [2, 2], at: "road", distance: [80, 120], chance: 0.9 },
    ],
  },
  // Its name, as its sign reads (the design panel's lists): mostly a coloured beast or thing, as
  // painted on the board - some only the voice's own country has - now and then where it stands,
  // its keeper's, or the halfway house.
  names: {
    patterns: [
      { text: "The {colour} {sign}", odds: 5 },
      { text: "The {sign}", odds: 2 },
      { text: "The {sign} at the {place}", odds: 2 },
      { text: "The {quality} {sign}", odds: 1 },
      { text: "{keeper}'s Rest", odds: 1 },
      { text: "The Halfway {sign}", odds: 1 },
      { text: "The {whole}", odds: 1 },
    ],
    words: {
      colour: ["Red", "White", "Black", "Golden", "Green", "Grey", "Blue", "Brown", "Silver", "Russet", "Dun", "Pale"],
      sign: {
        any: ["Hart", "Swan", "Bell", "Plough", "Fleece", "Crown", "Ram", "Bull", "Hare", "Ox", "Lantern", "Wheel", "Hound", "Star", "Key"],
        verdant: ["Lark", "Rose", "Lamb", "Rake", "Sheaf"],
        arid: ["Camel", "Jackal", "Palm", "Gourd", "Lamp", "Waterskin"],
        frozen: ["Bear", "Elk", "Wolf", "Raven", "Fox", "Reindeer"],
        murky: ["Heron", "Pike", "Eel", "Bittern", "Willow", "Reed"],
        stony: ["Anvil", "Goat", "Eagle", "Horn", "Hammer"],
        shaded: ["Owl", "Boar", "Stag", "Raven", "Thorn"],
      },
      // Signs whole in themselves, which take no colour.
      whole: ["Cross Keys", "Three Horseshoes", "Wheatsheaf", "Halfway House", "Drover's Rest", "Packhorse"],
      place: ["Ford", "Gate", "Bridge", "Crossways", "Well", "Stile", "Ridge", "Heath", "Hollow", "Mill", "Cross", "Pass"],
    },
  },
  // Trees and bushes cleared 25 m past the yard, growing back by 50.
  clearing: [25, 50],
  stumps: 0,
  // The yard trodden hard, out to the buildings' fronts, fraying out by 10 m past it.
  ground: {
    material: "track",
    weight: {
      noises: [{ name: "yardEdge", type: "fbm", octaves: 2, frequency: 0.08, amplitude: 1, persistence: 0.5, lacunarity: 2.0 }],
      steps: [
        { output: "gapRaw", op: "input", name: "featureGap" },
        { output: "edgeRaw", op: "sample", noise: "yardEdge" },
        { output: "edge", op: "scale", input: "edgeRaw", factor: 2 },
        { output: "gap", op: "add", a: "gapRaw", b: "edge" },
        { output: "raw", op: "remap", input: "gap", inMin: 10, inMax: 5, outMin: 0, outMax: 1 },
        { output: "result", op: "clamp", input: "raw", min: 0, max: 1 },
      ],
    },
  },
}
