// A hunting lodge: one long, low log hall under a big shingle roof, a stone chimney on an end,
// shuttered windows, a plank door, a store in a lean-to at its back - what the concepts showed
// (CONCEPTS.md, LODGE.md). One storey, open up to the roof; a hunter's trophies in the hall.
{
  name: "Hunting Lodge",
  type: "house",
  house: {
    tile: [2.8, 3.0],
    // Five or six bays along the front, three deep.
    width: [5, 6],
    depth: [3, 3],
    plan: {
      type: "cabin",
      cabin: {
        // A lean-to along the back, now and then; the lodge has no porch roof of its own.
        leanTos: [{ walls: ["back"], chance: 0.6, depth: [2, 2], roof: "shingleLeanTo" }],
      },
    },
    storeys: [1, 1],
    // In whole courses of the log wall (0.6 m), from the model's foot.
    wallHeight: [4.2, 4.2],
    plinth: [0.6, 0.6],
    plinthOutset: 0.4,
    framing: "logCorners",
    roof: "shingleRoof",
    doors: [{ part: "timberDoor", weight: 1 }],
    wallExtras: [
      { part: "stoneChimney", priority: 2, chance: 1, maxCount: 1, walls: ["side"], storeys: ["ground"] },
      { part: "timberWindow", priority: 1, chance: 0.4, storeys: ["ground"] },
    ],
    // Inside: the hunter's hall behind the front door, and a store beside it.
    interior: {
      type: "rooms",
      rooms: {
        exits: [1, 2],
        fakeDoors: 0,
        grow: 1,
        rooms: [
          { room: "huntersHall", priority: 10, tiles: [9, 12], grow: 1.5, minSide: 2, at: "entrance", oneBlock: true },
          { room: "campStore", priority: 6, tiles: [4, 6], minSide: 2, maxSide: 3, next: "huntersHall", oneBlock: true },
        ],
      },
    },
    litWindows: 0.8,
    parts: {
      walls: { material: "logWall", tints: [[0.8, 0.78, 0.76], [0.72, 0.7, 0.68], [0.85, 0.82, 0.78]] },
      timber: { material: "roundLog", tints: [[0.85, 0.82, 0.8], [0.76, 0.74, 0.72]] },
      stone: { material: "rubbleStone", tints: [[1, 1, 1]] },
      roof: { material: "woodShingles", tints: [[0.7, 0.72, 0.74], [0.62, 0.66, 0.66]] },
      plinth: { material: "rubbleStone", tints: [[1, 1, 1], [0.9, 0.88, 0.85]] },
      door: { material: "doorBoards", tints: [[0.8, 0.75, 0.7]] },
      glass: { material: "glass", tints: [[1, 1, 1]] },
      endGrain: { material: "endGrain", tints: [[1, 1, 1]] },
    },
  },
}
