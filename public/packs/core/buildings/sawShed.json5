// A logging camp's saw shed: a long shingle roof on heavy posts, open on its front, its back and its
// far end, where the logs are sawn - and at one end a bay or two walled in with logs, its tool room,
// with a plank door.
{
  name: "Saw Shed",
  type: "house",
  house: {
    tile: [2.8, 3.0],
    // Five to eight bays along, four deep: room for a log on trestles and the men round it.
    width: [5, 8],
    depth: [4, 4],
    plan: {
      type: "cabin",
      cabin: {
        // Open on every side but for one or two bays at one end, walled in - its posts about every
        // other bay.
        open: { closedBays: [1, 2], post: "heavyPost", postEvery: 2 },
      },
    },
    storeys: [1, 1],
    // In whole courses of the log wall (0.6 m), from the model's foot, as a log building's are.
    wallHeight: [4.8, 4.8],
    plinth: [0.6, 0.6],
    plinthOutset: 0.3,
    framing: "logCorners",
    roof: "shedRoof",
    doors: [{ part: "timberDoor", weight: 1 }],
    wallExtras: [],
    parts: {
      walls: { material: "logWall", tints: [[1, 1, 1], [0.92, 0.9, 0.88], [1.05, 1, 0.94]] },
      timber: { material: "roundLog", tints: [[1, 1, 1], [0.92, 0.9, 0.88]] },
      stone: { material: "rubbleStone", tints: [[1, 1, 1]] },
      roof: { material: "woodShingles", tints: [[0.85, 0.85, 0.85], [0.75, 0.76, 0.78]] },
      plinth: { material: "rubbleStone", tints: [[1, 1, 1], [0.9, 0.88, 0.85]] },
      door: { material: "planks", tints: [[0.8, 0.75, 0.7]] },
      glass: { material: "glass", tints: [[1, 1, 1]] },
      endGrain: { material: "endGrain", tints: [[1, 1, 1]] },
      // The open floor.
      boards: { material: "deckBoards", tints: [[0.85, 0.82, 0.78], [0.78, 0.75, 0.72]] },
    },
  },
}
