// A logging camp's tool shed: a small store of logs, square, one storey, a plank door and no
// windows, under a shingle roof. Shut - nothing is built behind its walls.
{
  name: "Tool Shed",
  type: "house",
  house: {
    tile: [2.6, 3.0],
    width: [2, 2],
    depth: [2, 2],
    plan: {
      type: "house",
      house: { backWing: 0, sideWing: 0, wingLength: [1, 1], wingWidth: [2, 2] },
    },
    storeys: [1, 1],
    // In whole courses of the log wall (0.6 m), from the model's foot: the corners' beams lie on the
    // walls' courses, so the plinth and the wall's height are counted in them.
    wallHeight: [3.6, 3.6],
    plinth: [0.6, 0.6],
    plinthOutset: 0.35,
    framing: "logCorners",
    roof: "shingleRoof",
    doors: [{ part: "timberDoor", weight: 1 }],
    wallExtras: [],
    parts: {
      walls: { material: "logWall", tints: [[1, 1, 1], [0.92, 0.9, 0.88], [1.05, 1, 0.94]] },
      // The logs at the corners, the walls' own wood.
      timber: { material: "roundLog", tints: [[1, 1, 1], [0.92, 0.9, 0.88]] },
      stone: { material: "rubbleStone", tints: [[1, 1, 1]] },
      roof: { material: "woodShingles", tints: [[0.85, 0.85, 0.85], [0.75, 0.76, 0.78]] },
      plinth: { material: "rubbleStone", tints: [[1, 1, 1], [0.9, 0.88, 0.85]] },
      door: { material: "planks", tints: [[0.8, 0.75, 0.7]] },
      glass: { material: "glass", tints: [[1, 1, 1]] },
      endGrain: { material: "endGrain", tints: [[1, 1, 1]] },
    },
  },
}
