// A one-storey cottage: limewashed or timber-coloured walls on a stone plinth, dark corner posts and
// frames, under a gable or hipped roof - sometimes with a wing out of the back or a side.
{
  name: "Cottage",
  type: "house",
  house: {
    // A tile is one bay of wall: the plan is made of them, and each can hold a window.
    tile: [2.6, 3.0],
    // The main block in tiles: along the front, and back from it.
    width: [3, 5],
    depth: [2, 3],
    // How likely a wing out of the back (a T or an L), and one out of a side, and how far each
    // reaches, in tiles.
    backWing: 0.5,
    sideWing: 0.35,
    wingLength: [1, 2],
    // Floor to eaves - a storey - how high the plinth lifts the floor off the ground, and how far it
    // stands out from the walls.
    wallHeight: [4.2, 4.8],
    plinth: [0.35, 0.6],
    plinthOutset: 0.7,
    // The corner posts: heavy timbers, this wide either way.
    post: [0.6, 0.9],
    roofs: ["gable", "hip"],
    pitch: [34, 45],
    // The roof reaches this far past the walls every way, and is this thick.
    overhang: 0.8,
    roofThickness: 0.4,
    // Doors and windows: their openings, and how wide their frames are. A window's sill reaches
    // `sillReach` past its frame either way and stands that much further out from the wall.
    door: { width: 1.4, height: 3, frame: 0.25 },
    window: { width: 1.0, height: 1.6, sill: 1.1, frame: 0.18, sillReach: 0.05, chance: 0.2 },
    colors: {
      walls: [[0.86, 0.83, 0.76], [0.8, 0.74, 0.62], [0.66, 0.55, 0.42]],
      trim: [[0.3, 0.22, 0.16], [0.4, 0.3, 0.2]],
      roof: [[0.55, 0.3, 0.22], [0.4, 0.38, 0.36], [0.5, 0.4, 0.28]],
      plinth: [[0.5, 0.48, 0.44], [0.42, 0.4, 0.37]],
      door: [[0.36, 0.24, 0.15], [0.25, 0.32, 0.3]],
      glass: [[0.16, 0.2, 0.24]],
    },
  },
}
