// A craftsman's workshop - a carpenter's, a weaver's, a cooper's: timber-framed, one storey or two,
// wide windows to work by and a wide door to bring the work out, a lean-to out of a side, under a
// shingle roof.
{
  name: "Workshop",
  type: "house",
  house: {
    tile: [2.6, 3.0],
    width: [3, 4],
    depth: [2, 3],
    // How the plan is laid out round the main block (see the README's "House plans").
    plan: {
      type: "house",
      house: {
        backWing: 0.25,
        sideWing: 0.4,
        wingLength: [1, 2],
        wingWidth: [2, 2],
        wingStoreys: [1, 1],
        lowTops: [{ part: "shingleRoof", weight: 1 }],
      },
    },
    storeys: [1, 2],
    wallHeight: [4.0, 4.6],
    upperHeight: [3.4, 3.8],
    plinth: [0.25, 0.45],
    plinthOutset: 0.5,
    framing: "timberFrame",
    roof: "shingleRoof",
    doors: [{ part: "barnDoor", weight: 2 }, { part: "timberDoor", weight: 1 }],
    wallExtras: [
      { part: "stoneChimney", priority: 2, chance: 0.15, maxCount: 1, walls: ["side", "back"], storeys: ["ground"] },
      { part: "wideWindow", priority: 1, chance: 0.4, storeys: ["ground"] },
      { part: "timberWindow", priority: 1, chance: 0.25 },
    ],
    parts: {
      walls: { material: "plaster", tints: [[0.98, 0.95, 0.88], [0.92, 0.88, 0.8], [0.95, 0.9, 0.95]] },
      timber: { material: "timber", tints: [[0.65, 0.58, 0.52], [0.5, 0.45, 0.42]] },
      stone: { material: "dressedStone", tints: [[1, 1, 1]] },
      roof: { material: "woodShingles", tints: [[1, 1, 1], [0.9, 0.92, 0.95]] },
      plinth: { material: "stoneBricks", tints: [[1, 1, 1], [0.9, 0.88, 0.85]] },
      door: { material: "timber", tints: [[0.7, 0.62, 0.55], [0.55, 0.5, 0.42]] },
      glass: { material: "glass", tints: [[1, 1, 1]] },
    },
  },
}
