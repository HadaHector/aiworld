// A logging camp's bunkhouse: a long log hall, a loft under its roof, a porch along its front and a
// lean-to along its back - sometimes one against an end too - under shingles, with small windows
// and a stone chimney.
{
  name: "Bunkhouse",
  type: "house",
  house: {
    tile: [2.8, 3.0],
    // Long: seven to nine bays along the front, three deep.
    width: [7, 9],
    depth: [3, 3],
    plan: {
      type: "cabin",
      cabin: {
        // A lean-to along the back, the whole wall long; and now and then a shorter one against an
        // end.
        leanTos: [
          { walls: ["back"], chance: 0.9, depth: [2, 2], roof: "shingleLeanTo" },
          { walls: ["side"], chance: 0.35, depth: [2, 2], length: [2, 3], roof: "shingleLeanTo" },
        ],
        // A porch along the front, most of the time the whole of it.
        porches: [{ walls: ["front"], chance: 0.85, part: "timberPorch" }],
      },
    },
    // The hall and the loft over it.
    storeys: [2, 2],
    // In whole courses of the log wall (0.6 m), from the model's foot: so the corners' beams lie on
    // the walls' courses all the way up.
    wallHeight: [4.2, 4.2],
    upperHeight: [2.4, 2.4],
    plinth: [0.6, 0.6],
    plinthOutset: 0.4,
    framing: "logCorners",
    roof: "shingleRoof",
    doors: [{ part: "timberDoor", weight: 1 }],
    wallExtras: [
      { part: "stoneChimney", priority: 2, chance: 0.7, maxCount: 1, walls: ["side"], storeys: ["ground"] },
      { part: "timberWindow", priority: 1, chance: 0.3, storeys: ["ground"] },
      { part: "timberWindow", priority: 1, chance: 0.15, walls: ["side"], storeys: ["upper"] },
    ],
    parts: {
      walls: { material: "logWall", tints: [[1, 1, 1], [0.92, 0.9, 0.88], [1.05, 1, 0.94]] },
      timber: { material: "roundLog", tints: [[1, 1, 1], [0.92, 0.9, 0.88]] },
      stone: { material: "rubbleStone", tints: [[1, 1, 1]] },
      roof: { material: "woodShingles", tints: [[0.85, 0.85, 0.85], [0.75, 0.76, 0.78]] },
      plinth: { material: "rubbleStone", tints: [[1, 1, 1], [0.9, 0.88, 0.85]] },
      door: { material: "planks", tints: [[0.8, 0.75, 0.7]] },
      glass: { material: "glass", tints: [[1, 1, 1]] },
      endGrain: { material: "endGrain", tints: [[1, 1, 1]] },
      // The porch's deck.
      boards: { material: "deckBoards", tints: [[1, 1, 1], [0.9, 0.88, 0.86]] },
    },
  },
}
