// An abandoned logging camp's saw shed: the saw shed years on - its roof rotted and fallen in at
// one place (`rottedShedRoof`), its logs and posts gone grey, no sawdust round it any more.
{
  name: "Abandoned Saw Shed",
  type: "house",
  house: {
    tile: [2.8, 3.0],
    // Five to eight bays along, four deep: room for a log on trestles and the men round it.
    width: [5, 8],
    depth: [4, 4],
    plan: {
      type: "cabin",
      cabin: {
        // Open on every side but for one or two bays at one end, walled in - its posts about every
        // other bay.
        open: { closedBays: [1, 2], post: "heavyPost", postEvery: 2 },
      },
    },
    storeys: [1, 1],
    // In whole courses of the log wall (0.6 m), from the model's foot, as a log building's are.
    wallHeight: [4.8, 4.8],
    plinth: [0.6, 0.6],
    plinthOutset: 0.3,
    framing: "logCorners",
    roof: "rottedShedRoof",
    doors: [{ part: "timberDoor", weight: 1 }],
    wallExtras: [],
    // Inside: the walled end is the tool room, the whole of it - its one door onto the shed's floor.
    interior: {
      type: "rooms",
      rooms: {
        exits: [1, 1],
        fakeDoors: 0,
        rooms: [{ room: "toolRoom", priority: 10, tiles: [4, 8], at: "entrance", through: true }],
      },
    },
    cold: true,
    parts: {
      walls: { material: "logWall", tints: [[0.7, 0.7, 0.66], [0.62, 0.62, 0.6], [0.74, 0.72, 0.66]] },
      timber: { material: "roundLog", tints: [[0.7, 0.7, 0.66], [0.62, 0.62, 0.6], [0.74, 0.72, 0.66]] },
      stone: { material: "rubbleStone", tints: [[1, 1, 1]] },
      roof: { material: "rottedShingles", tints: [[1, 1, 1], [0.9, 0.92, 0.9]] },
      plinth: { material: "rubbleStone", tints: [[1, 1, 1], [0.9, 0.88, 0.85]] },
      door: { material: "doorBoards", tints: [[0.55, 0.52, 0.48]] },
      glass: { material: "glass", tints: [[1, 1, 1]] },
      endGrain: { material: "endGrain", tints: [[1, 1, 1]] },
      // The open floor.
      boards: { material: "deckBoards", tints: [[0.85, 0.82, 0.78], [0.78, 0.75, 0.72]] },
    },
  },
}
