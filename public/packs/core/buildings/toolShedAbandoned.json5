// An abandoned logging camp's tool shed, years on: its roof rotted (`rottedShingleRoof`), its logs grey.
{
  name: "Abandoned Tool Shed",
  type: "house",
  house: {
    tile: [2.6, 3.0],
    width: [2, 2],
    depth: [2, 2],
    plan: {
      type: "house",
      house: { backWing: 0, sideWing: 0, wingLength: [1, 1], wingWidth: [2, 2] },
    },
    storeys: [1, 1],
    // In whole courses of the log wall (0.6 m), from the model's foot: the corners' beams lie on the
    // walls' courses, so the plinth and the wall's height are counted in them.
    wallHeight: [3.6, 3.6],
    plinth: [0.6, 0.6],
    plinthOutset: 0.35,
    framing: "logCorners",
    roof: "rottedShingleRoof",
    doors: [{ part: "timberDoor", weight: 1 }],
    wallExtras: [],
    cold: true,
    parts: {
      walls: { material: "logWall", tints: [[0.7, 0.7, 0.66], [0.62, 0.62, 0.6], [0.74, 0.72, 0.66]] },
      // The logs at the corners, the walls' own wood.
      timber: { material: "roundLog", tints: [[0.7, 0.7, 0.66], [0.62, 0.62, 0.6], [0.74, 0.72, 0.66]] },
      stone: { material: "rubbleStone", tints: [[1, 1, 1]] },
      roof: { material: "rottedShingles", tints: [[1, 1, 1], [0.9, 0.92, 0.9]] },
      plinth: { material: "rubbleStone", tints: [[1, 1, 1], [0.9, 0.88, 0.85]] },
      door: { material: "doorBoards", tints: [[0.55, 0.52, 0.48]] },
      glass: { material: "glass", tints: [[1, 1, 1]] },
      endGrain: { material: "endGrain", tints: [[1, 1, 1]] },
    },
  },
}
