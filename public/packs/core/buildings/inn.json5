// An inn: wide and deep, two or three storeys jettied out over the street, under a big clay roof
// with a chimney or two, a cellar for the ale, a wing out of the back for the stables or the
// kitchen - and sometimes an arcade at the front to drink under.
{
  name: "Inn",
  type: "house",
  house: {
    tile: [2.6, 3.0],
    width: [4, 5],
    depth: [3, 3],
    // How the plan is laid out round the main block (see the README's "House plans").
    plan: {
      type: "house",
      house: {
        backWing: 0.6,
        sideWing: 0,
        wingLength: [1, 2],
        wingWidth: [2, 3],
        wingStoreys: [1, 2],
        lowTops: [{ part: "clayRoof", weight: 2 }, { part: "timberBalcony", weight: 1 }],
        arcade: { chance: 0.25, support: "timberPost" },
      },
    },
    storeys: [2, 3],
    cellars: [1, 1],
    wallHeight: [4.2, 4.6],
    upperHeight: [3.8, 4.2],
    cellarHeight: [2.6, 3.0],
    plinth: [0.4, 0.6],
    plinthOutset: 0.6,
    jetty: { out: 0.6, walls: ["front"] },
    framing: "timberFrame",
    roof: "clayRoof",
    // A coach door as often as not.
    doors: [{ part: "barnDoor", weight: 1 }, { part: "timberDoor", weight: 1 }],
    wallExtras: [
      // A door onto a balcony or a terrace - doors over the ground storey only go where one opens onto one.
      { part: "timberDoor", priority: 3, chance: 0.9, maxCount: 2, storeys: ["upper"] },
      { part: "stoneChimney", priority: 2, chance: 0.6, maxCount: 2, walls: ["side", "back"], storeys: ["ground"] },
      { part: "wideWindow", priority: 1, chance: 0.35, storeys: ["ground"] },
      { part: "timberWindow", priority: 1, chance: 0.5 },
    ],
    parts: {
      walls: { material: "plaster", tints: [[1.04, 0.92, 0.72], [1.0, 0.8, 0.66], [0.95, 0.96, 0.9], [1.02, 0.98, 0.84]] },
      timber: { material: "timber", tints: [[0.42, 0.36, 0.34], [0.5, 0.44, 0.4]] },
      stone: { material: "dressedStone", tints: [[1, 1, 1]] },
      roof: { material: "roofTiles", tints: [[1, 1, 1], [0.9, 0.84, 0.8]] },
      plinth: { material: "stoneBricks", tints: [[1, 1, 1], [0.9, 0.88, 0.85]] },
      door: { material: "timber", tints: [[0.55, 0.38, 0.3], [0.38, 0.45, 0.4]] },
      glass: { material: "glass", tints: [[1, 1, 1]] },
    },
  },
}
