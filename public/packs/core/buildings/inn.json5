// An inn: wide and deep, two storeys jettied out over the street, under a big clay roof
// with a chimney or two, a cellar for the ale, a wing out of the back for the stables or the
// kitchen - and sometimes an arcade at the front to drink under.
{
  name: "Inn",
  type: "house",
  house: {
    tile: [2.6, 3.0],
    // Big enough for a two-storey taproom, its stair and gallery, a kitchen and guest rooms.
    width: [7, 8],
    depth: [4, 5],
    // How the plan is laid out round the main block (see the README's "House plans").
    plan: {
      type: "house",
      house: {
        // Wings big enough for guest rooms upstairs: two storeys, two tiles each way at least.
        backWing: 0.9,
        sideWing: 0.65,
        wingLength: [2, 3],
        wingWidth: [2, 3],
        wingStoreys: [2, 2],
        lowTops: [{ part: "clayRoof", weight: 2 }, { part: "timberBalcony", weight: 1 }],
        arcade: { chance: 0.25, support: "timberPost" },
      },
    },
    storeys: [2, 2],
    cellars: [1, 1],
    wallHeight: [4.2, 4.6],
    upperHeight: [3.8, 4.2],
    cellarHeight: [2.6, 3.0],
    plinth: [0.4, 0.6],
    plinthOutset: 0.6,
    jetty: { out: 0.6, walls: ["front"] },
    framing: "timberFrame",
    roof: "clayRoof",
    // A coach door as often as not.
    doors: [{ part: "barnDoor", weight: 1 }, { part: "timberDoor", weight: 1 }],
    wallExtras: [
      // A door onto a balcony or a terrace - doors over the ground storey only go where one opens onto one.
      { part: "timberDoor", priority: 3, chance: 0.9, maxCount: 2, storeys: ["upper"] },
      { part: "stoneChimney", priority: 2, chance: 0.6, maxCount: 2, walls: ["side", "back"], storeys: ["ground"] },
      { part: "wideWindow", priority: 1, chance: 0.35, storeys: ["ground"] },
      { part: "timberWindow", priority: 1, chance: 0.5 },
    ],
    // Inside (see the README's "Interiors"): a taproom two storeys tall behind the front door, a
    // stair up to a gallery round it with guest rooms off it, a kitchen beside it, stores, and a
    // cellar under it - and a second way out, round the back.
    interior: {
      type: "rooms",
      rooms: {
        exits: [1, 2],
        fakeDoors: 0.4,
        rooms: [
          { room: "taproom", priority: 10, levels: [2, 2], tiles: [20, 28], grow: 1.5, minSide: 3, at: "entrance", stair: true },
          { room: "kitchen", priority: 8, tiles: [6, 9], minSide: 2, maxSide: 3, next: "taproom" },
          { room: "guestRoom", priority: 6, count: [3, 6], level: "upper", tiles: [4, 6], minSide: 2, maxSide: 3 },
          { room: "cellar", priority: 4, chance: 0.8, level: "cellar", tiles: [3, 8], under: "taproom" },
          { room: "store", priority: 2, count: [1, 2], chance: 0.7, tiles: [4, 6], maxSide: 3 },
        ],
      },
    },
    parts: {
      walls: { material: "plaster", tints: [[1.04, 0.92, 0.72], [1.0, 0.8, 0.66], [0.95, 0.96, 0.9], [1.02, 0.98, 0.84]] },
      timber: { material: "timber", tints: [[0.42, 0.36, 0.34], [0.5, 0.44, 0.4]] },
      stone: { material: "dressedStone", tints: [[1, 1, 1]] },
      roof: { material: "roofTiles", tints: [[1, 1, 1], [0.9, 0.84, 0.8]] },
      plinth: { material: "stoneBricks", tints: [[1, 1, 1], [0.9, 0.88, 0.85]] },
      door: { material: "timber", tints: [[0.55, 0.38, 0.3], [0.38, 0.45, 0.4]] },
      glass: { material: "glass", tints: [[1, 1, 1]] },
    },
  },
}
