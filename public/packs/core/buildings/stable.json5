// A logging camp's ox stable: a long, low log cabin under shingles, a wide barn door in its front
// and a few small windows. Its length is rolled in stalls - a bay each, three to six oxen - with
// a feed store at one end.
{
  name: "Ox Stable",
  type: "house",
  house: {
    tile: [2.8, 3.0],
    // Four to seven bays along the front - one the feed store's, the rest a stall each - three deep:
    // the stalls two, the aisle in front of them one.
    width: [4, 7],
    depth: [3, 3],
    plan: { type: "cabin", cabin: {} },
    storeys: [1, 1],
    // In whole courses of the log wall (0.6 m), from the model's foot.
    wallHeight: [4.2, 4.2],
    plinth: [0.6, 0.6],
    plinthOutset: 0.4,
    framing: "logCorners",
    roof: "shingleRoof",
    doors: [{ part: "barnDoor", weight: 1 }],
    wallExtras: [{ part: "timberWindow", priority: 1, chance: 0.25, storeys: ["ground"] }],
    // Inside: the feed store, a bay wide, front to back at one end - laid out first, so it takes an
    // end - and the stalls behind the barn door, filling the rest; the store through a door off the
    // aisle.
    interior: {
      type: "rooms",
      rooms: {
        exits: [1, 1],
        fakeDoors: 0,
        grow: 1,
        rooms: [
          { room: "campStore", priority: 10, tiles: [3, 3], minSide: 1, through: true },
          { room: "oxStalls", priority: 8, tiles: [6, 6], grow: 3, minSide: 2, at: "entrance", through: true },
        ],
      },
    },
    parts: {
      walls: { material: "logWall", tints: [[1, 1, 1], [0.92, 0.9, 0.88], [1.05, 1, 0.94]] },
      timber: { material: "roundLog", tints: [[1, 1, 1], [0.92, 0.9, 0.88]] },
      stone: { material: "rubbleStone", tints: [[1, 1, 1]] },
      roof: { material: "woodShingles", tints: [[0.85, 0.85, 0.85], [0.75, 0.76, 0.78]] },
      plinth: { material: "rubbleStone", tints: [[1, 1, 1], [0.9, 0.88, 0.85]] },
      door: { material: "planks", tints: [[0.8, 0.75, 0.7]] },
      glass: { material: "glass", tints: [[1, 1, 1]] },
      endGrain: { material: "endGrain", tints: [[1, 1, 1]] },
    },
  },
}
