// An abandoned logging camp's bunkhouse: the bunkhouse years on - its shingles mossed and gone in
// patches, its ridge sunk and a place of the roof fallen in (`rottedShingleRoof`), no lamp behind
// its windows, its logs and its door gone grey.
{
  name: "Abandoned Bunkhouse",
  type: "house",
  house: {
    tile: [2.8, 3.0],
    // Long: seven to nine bays along the front, three deep.
    width: [7, 9],
    depth: [3, 3],
    plan: {
      type: "cabin",
      cabin: {
        // A lean-to along the back, the whole wall long; and now and then a shorter one against an
        // end.
        leanTos: [
          { walls: ["back"], chance: 0.9, depth: [2, 2], roof: "shingleLeanTo" },
          { walls: ["side"], chance: 0.35, depth: [2, 2], length: [2, 3], roof: "shingleLeanTo" },
        ],
        // A porch along the front, most of the time the whole of it.
        porches: [{ walls: ["front"], chance: 0.85, part: "timberPorch" }],
      },
    },
    // The hall and the loft over it.
    storeys: [2, 2],
    // In whole courses of the log wall (0.6 m), from the model's foot: so the corners' beams lie on
    // the walls' courses all the way up.
    wallHeight: [4.2, 4.2],
    upperHeight: [2.4, 2.4],
    plinth: [0.6, 0.6],
    plinthOutset: 0.4,
    framing: "logCorners",
    roof: "rottedShingleRoof",
    doors: [{ part: "timberDoor", weight: 1 }],
    wallExtras: [
      { part: "stoneChimney", priority: 2, chance: 0.7, maxCount: 1, walls: ["side"], storeys: ["ground"] },
      { part: "timberWindow", priority: 1, chance: 0.3, storeys: ["ground"] },
      { part: "timberWindow", priority: 1, chance: 0.15, walls: ["side"], storeys: ["upper"] },
    ],
    // Inside: three rooms at most. The mess hall, most of the cabin's ground storey, behind the
    // front door, with the stair up; the loft over it, where the men sleep; and a store in a lean-to
    // beside it - or, with no lean-to, at an end of the cabin. A second door out, round the back.
    interior: {
      type: "rooms",
      rooms: {
        exits: [2, 2],
        fakeDoors: 0.3,
        grow: 1,
        rooms: [
          { room: "messHallCold", priority: 10, tiles: [12, 27], minSide: 3, at: "entrance", stair: true, oneBlock: true },
          { room: "bunkLoftCold", priority: 8, level: "upper", tiles: [12, 27], minSide: 3, over: "messHallCold", oneBlock: true },
          { room: "campStore", priority: 6, tiles: [4, 6], minSide: 2, maxSide: 3, next: "messHallCold", oneBlock: true },
        ],
      },
    },
    // Its windows with a lamp behind them at night, this share of them.
    // Nothing burns here: no lamp behind a window, no smoke off the chimney.
    litWindows: 0,
    cold: true,
    parts: {
      walls: { material: "logWall", tints: [[0.7, 0.7, 0.66], [0.62, 0.62, 0.6], [0.74, 0.72, 0.66]] },
      timber: { material: "roundLog", tints: [[0.7, 0.7, 0.66], [0.62, 0.62, 0.6], [0.74, 0.72, 0.66]] },
      stone: { material: "rubbleStone", tints: [[1, 1, 1]] },
      roof: { material: "rottedShingles", tints: [[1, 1, 1], [0.9, 0.92, 0.9]] },
      plinth: { material: "rubbleStone", tints: [[1, 1, 1], [0.9, 0.88, 0.85]] },
      door: { material: "doorBoards", tints: [[0.55, 0.52, 0.48]] },
      glass: { material: "glass", tints: [[1, 1, 1]] },
      endGrain: { material: "endGrain", tints: [[1, 1, 1]] },
      // The porch's deck.
      boards: { material: "deckBoards", tints: [[1, 1, 1], [0.9, 0.88, 0.86]] },
    },
  },
}
