// A town hall: the biggest house in town, by the square - two or three storeys of limewashed walls,
// quoined and corniced in stone, over an open market arcade on stone pillars, stone windows in
// nearly every bay, and a cellar under it all.
{
  name: "Town Hall",
  type: "house",
  house: {
    tile: [2.8, 3.2],
    // Big - but how big varies from town to town.
    width: [5, 7],
    depth: [3, 4],
    // How the plan is laid out round the main block (see the README's "House plans").
    plan: {
      type: "house",
      house: {
        backWing: 0.6,
        sideWing: 0.3,
        wingLength: [2, 3],
        wingWidth: [2, 3],
        wingStoreys: [2, 2],
        lowTops: [{ part: "stoneTerrace", weight: 1 }],
        arcade: { chance: 1, support: "stonePillar" },
      },
    },
    storeys: [2, 3],
    cellars: [1, 1],
    wallHeight: [4.8, 5.2],
    upperHeight: [4.2, 4.6],
    cellarHeight: [2.8, 3.2],
    plinth: [0.5, 0.7],
    plinthOutset: 0.6,
    framing: "stoneFrame",
    roof: "clayRoof",
    doors: [{ part: "stoneDoor", weight: 1 }],
    wallExtras: [
      // A door onto a balcony or a terrace - doors over the ground storey only go where one opens onto one.
      { part: "stoneDoor", priority: 3, chance: 0.9, maxCount: 2, storeys: ["upper"] },
      { part: "stoneChimney", priority: 2, chance: 0.4, maxCount: 2, walls: ["side", "back"], storeys: ["ground"] },
      { part: "stoneWindow", priority: 1, chance: 0.65 },
    ],
    // Inside: an entry hall behind the front door with the stair, a guard room and clerks' offices
    // beside it; upstairs a stair hall over it - and on a third storey another - with the council
    // chamber off it (two storeys tall where it can be), the mayor's office and an archive; and in
    // the cellar a lockup and a strongroom. Doors out at the back too.
    interior: {
      type: "rooms",
      rooms: {
        exits: [1, 2],
        fakeDoors: 0.5,
        rooms: [
          { room: "entryHall", priority: 10, tiles: [6, 9], minSide: 2, at: "entrance", stair: true },
          { room: "stairHall", priority: 9, level: "upper", tiles: [4, 6], minSide: 2, over: "entryHall", stair: true },
          { room: "councilChamber", priority: 8, level: "upper", levels: [1, 2], tiles: [8, 14], minSide: 3, next: "stairHall" },
          { room: "mayorsOffice", priority: 7, level: "upper", tiles: [4, 6], minSide: 2, maxSide: 3 },
          { room: "guardRoom", priority: 6, tiles: [4, 6], minSide: 2, maxSide: 3, next: "entryHall" },
          { room: "clerksOffice", priority: 5, count: [1, 2], tiles: [4, 6], minSide: 2, maxSide: 3 },
          { room: "archive", priority: 4, chance: 0.8, level: "upper", tiles: [4, 8], minSide: 2, maxSide: 4 },
          { room: "stairHall", priority: 3, level: "upper", tiles: [4, 6], minSide: 2, over: "stairHall", stair: true },
          { room: "clerksOffice", priority: 2, count: [1, 3], level: "upper", tiles: [4, 6], minSide: 2, maxSide: 3 },
          { room: "lockup", priority: 1, chance: 0.7, level: "cellar", tiles: [4, 8], minSide: 2, under: "entryHall" },
          { room: "strongroom", priority: 1, chance: 0.6, level: "cellar", tiles: [2, 4], next: "lockup" },
        ],
      },
    },
    parts: {
      walls: { material: "plaster", tints: [[1.02, 1.0, 0.95], [1.04, 0.96, 0.84], [0.96, 0.96, 0.98]] },
      timber: { material: "timber", tints: [[0.45, 0.4, 0.38]] },
      stone: { material: "dressedStone", tints: [[1.04, 1.02, 0.98], [0.95, 0.92, 0.88]] },
      roof: { material: "roofTiles", tints: [[1, 1, 1], [0.86, 0.82, 0.8]] },
      plinth: { material: "stoneBricks", tints: [[1, 1, 1]] },
      door: { material: "timber", tints: [[0.45, 0.32, 0.26]] },
      glass: { material: "glass", tints: [[1, 1, 1]] },
    },
  },
}
