// A weapon's swing: a quick whoosh of filtered noise rising and falling.
{
  near: 3, far: 35, maxVoices: 6,
  pitch: [-1.5, 1.5], volume: [0.8, 1],
  takes: 4,
  layers: [
    { synth: { noise: "pink", filter: { type: "bandpass", hz: [450, 1800], q: 1.6 }, env: { attack: 0.07, decay: 0.16, curve: 2 }, gain: 1.6 }, standIn: true },
  ],
}
