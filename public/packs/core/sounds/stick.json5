// Web sticking: a gluey splat, a long wet stretch and the threads' crackle as they pull tight.
{
  near: 4, far: 35, maxVoices: 3, pitch: [-1.5, 1.5], volume: [0.85, 1], takes: 3,
  layers: [
    { synth: { noise: "pink", filter: { type: "lowpass", hz: [2400, 400] }, env: { attack: 0.002, decay: 0.14 }, gain: 1.4 }, standIn: true },
    { synth: { tone: "triangle", hz: [300, 700], env: { attack: 0.05, decay: 0.4 }, gain: 0.1, delay: 0.05, vibrato: { rate: 14, depth: 0.5 } }, standIn: true },
    { synth: { crackle: true, density: 45, click: 0.004, filter: { type: "bandpass", hz: 2500, q: 2 }, env: { attack: 0.05, decay: 0.5 }, gain: 0.7, delay: 0.08 }, standIn: true },
  ],
}
