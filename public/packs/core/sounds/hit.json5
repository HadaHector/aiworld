  near: 4, far: 40, maxVoices: 6,
  pitch: [-2, 2], volume: [0.85, 1],
  takes: 4,
  layers: [
    { synth: { tone: "sine", hz: [190, 55], env: { attack: 0.002, decay: 0.18, curve: 2.5 }, gain: 0.9, drive: 2 }, standIn: true },
    { synth: { noise: "pink", filter: { type: "lowpass", hz: [2600, 500], q: 0.8 }, env: { attack: 0.001, decay: 0.09, curve: 3 }, gain: 0.8 }, standIn: true },
  ],
}
