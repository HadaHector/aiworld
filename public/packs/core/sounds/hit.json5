// A blow landing, old-school: a short dull thwack - a punchy low thump and a slap, crunched to a
// low sample rate. What every hit falls back to.
{
  near: 4, far: 40, maxVoices: 6,
  pitch: [-2, 2], volume: [0.85, 1],
  takes: 6,
  layers: [
    { synth: { tone: "sine", hz: [260, 85], env: { attack: 0.001, decay: 0.09, curve: 3 }, gain: 0.9, drive: 4, crush: { bits: 8, rate: 2 } }, standIn: true },
    { synth: { noise: "pink", filter: { type: "lowpass", hz: [2400, 600], q: 0.9 }, env: { attack: 0.001, decay: 0.05, curve: 3 }, gain: 1, crush: { bits: 8, rate: 2 } }, standIn: true },
  ],
}
