// A swing that hits nothing, old-school: a longer, airier "fwoosh" than a swing, trailing off.
{
  near: 3, far: 30, maxVoices: 4,
  pitch: [-1, 1.5], volume: [0.7, 0.85],
  takes: 4,
  layers: [
    { synth: { noise: "white", filter: { type: "bandpass", hz: [1600, 700], q: 1.6 }, env: { attack: 0.03, decay: 0.16, curve: 2 }, gain: 1.1, crush: { bits: 8, rate: 2 } }, standIn: true },
  ],
}
